# Environment Variables for TaskMonitoringApp Docker Compose
# Copy this file to .env and change the values for a more secure setup

# The password for the sa account on SQL Server and the connection string
DB_PASSWORD=your_secure_password_here

# The memory limit for the SQL Server container (useful for environments with constrained RAM like Railway)
MSSQL_MEMORY_LIMIT_MB=512

# The secret used for generating JWT Tokens (Make sure this is a long, random, secure string in production)
JWT_SECRET=your_jwt_secret_here
