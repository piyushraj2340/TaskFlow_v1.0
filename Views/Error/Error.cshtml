@{
    ViewData["Title"] = "Error";
}

<div class="min-h-screen bg-gray-100 flex items-center justify-center p-6">
    <div class="bg-white shadow-lg rounded-lg p-8 max-w-md w-full text-center">
        <h1 class="text-4xl font-bold text-red-600 mb-4">An Error Occurred</h1>

        <p class="text-lg text-gray-700 mb-2">
            <span class="font-semibold">Status Code:</span> @ViewData["StatusCode"]
        </p>
        <p class="text-md text-gray-600 mb-6">
            <span class="font-semibold">Message:</span> @ViewData["Message"]
        </p>

        <a href="/" class="inline-block px-6 py-2 bg-blue-600 text-white font-semibold rounded hover:bg-blue-700 transition">
            Return to Home
        </a>
    </div>
</div>
