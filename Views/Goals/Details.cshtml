@model TaskMonitoringApp.Models.ViewModel.GoalWithNotesListViewModel

@{
    ViewData["Title"] = Model.Name + " - Goal Details";
}

<div class="mx-auto max-w-7xl px-2 py-12 md:px-6">
    <!-- Centered Action Buttons -->
    <div class="mb-6 flex flex-wrap justify-center gap-4">
        <button data-id="@Model.Id" class="editGoalBtn flex items-center rounded-lg bg-blue-500 px-6 py-2 text-white transition duration-300 hover:bg-blue-600">
            <i class="fas fa-edit mr-2"></i>Edit Goal
        </button>
        <button data-id="@Model.Id" class="deleteGoalBtn flex items-center rounded-lg bg-red-500 px-6 py-2 text-white transition duration-300 hover:bg-red-600">
            <i class="fas fa-trash mr-2"></i>Delete Goal
        </button>
        <button id="openAddNotesModal" data-id="@Model.Id" class="flex items-center rounded-lg bg-yellow-500 px-6 py-2 text-white transition duration-300 hover:bg-yellow-600">
            <i class="fas fa-comment mr-2"></i>Add Notes
        </button>
        <button data-id="@Model.Id" class="markAsComplete flex items-center rounded-lg bg-green-500 px-6 py-2 text-white transition duration-300 hover:bg-green-600">
            <i class="fas fa-check mr-2"></i>Mark as Complete
        </button>
    </div>

    <!-- Charts Section -->
    <div class="mb-12 grid gap-8 md:grid-cols-3">
        <!-- Left Chart: Task Growth Ratio (70%) -->
        <div class="col-span-1 h-[400px] rounded-lg bg-white p-6 shadow-lg md:col-span-2">
            <h2 class="mb-4 text-2xl font-semibold text-gray-800">Task Growth Ratio</h2>
            <div class="h-[300px]">
                <canvas id="taskGrowthChart"></canvas>
            </div>
        </div>

        <!-- Right Chart: Donut Chart (30%) -->
        <div class="h-[400px] rounded-lg bg-white p-6 shadow-lg">
            <h2 class="mb-4 text-2xl font-semibold text-gray-800">Contributing to the Goal</h2>
            <div class="h-[300px]">
                <canvas id="goalPieChart"></canvas>
            </div>
        </div>
    </div>


    <div class="mb-8 rounded-lg bg-white p-4 shadow-lg sm:p-6">
        <div class="z-10 sticky top-0 h-auto border-b border-gray-300 bg-white py-1">
            <!-- Tab Navigation -->
            <ul class="flex flex-wrap items-center">
                <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/info") class="@(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName) ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-b-2 border-l-1 border-r-1 px-4 py-2" data-tab="info">Info</a></li>
                <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/notes") class="@(ViewBag.tabName == "notes" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-b-2 border-l-1 border-r-1 px-4 py-2" data-tab="notes">All Notes</a></li>
                <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/board1") class="@(ViewBag.tabName == "board1" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-b-2 border-l-1 border-r-1 px-4 py-2" data-tab="board1">Board 1</a></li>
                <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/create") class="@(ViewBag.tabName == "create" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-b-2 border-l-1 border-r-1 px-4 py-2" data-tab="create">Create Board</a></li>
            </ul>
        </div>

        <!-- Tab Content -->
        <div class="custom-scrollbar z-0 relative mt-4 max-h-screen overflow-y-scroll">
            <!-- Info Tab -->
            <div id="info" class="tab-content @(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName)? "" : "hidden")" )>
                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Goal Information</h2>
                    <p class="text-gray-600">Here are all details related to this goals.</p>
                </div>
                <div class="ms-4 space-y-4">
                    <!-- Task Name -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Goal Name</div>
                        <div class="w-full text-left text-lg font-semibold text-gray-800 sm:w-3/4">@Model.Name</div>
                    </div>
                    <!-- Description -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Description</div>
                        <div class="w-full text-left text-gray-600 sm:w-3/4">@(string.IsNullOrWhiteSpace(Model.Description) ? "No Descriptions found" : Model.Description)</div>
                    </div>
                    <!-- Priority -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Priority</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-xs font-semibold text-white">
                                @Model.Priority
                            </span>
                        </div>
                    </div>
                    <!-- Status -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Status</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-blue-500 px-3 py-1 text-xs font-semibold text-white">
                                @Model.GoalStatus
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notes Tab -->
            <div id="notes" class="tab-content @(ViewBag.tabName == "notes"? "" : "hidden")">

                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Notes Timeline</h2>
                    <p class="text-gray-600">Here are all the notes related to this goals.</p>
                </div>

                <div class="ms-4 max-w-4xl ps-2 sm:ps-4 sm:ms-8">
                    <!-- Timeline Wrapper -->
                    <div class="border-l-4 relative border-gray-300 pl-6">

                        <!-- Note 1 -->
                        @{
                            DateTime? tempDateTime = null;
                            foreach (var noteList in Model.NotesList)
                            {
                                if (tempDateTime == null || tempDateTime?.Date != noteList.TimeStamp.Date)
                                {
                                    <div class="mb-2 mt-4 flex justify-center">
                                        <div class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white">
                                            @if (DateTime.Now.Date == noteList.TimeStamp.Date)
                                            {
                                                <span>today</span>
                                            }
                                            else if (DateTime.Now.AddDays(-1).Date == noteList.TimeStamp.Date)
                                            {
                                                <span>Yesterday</span>
                                            }
                                            else if (noteList.TimeStamp >= DateTime.Now.AddDays(-7).Date)
                                            {
                                                <span>@noteList.TimeStamp.ToString("dddd")</span>
                                            }
                                            else
                                            {
                                                <span>@noteList.TimeStamp.ToString("MMMM dd, yyyy")</span>
                                            }
                                        </div>
                                    </div>

                                    tempDateTime = noteList.TimeStamp;
                                }

                                <div class="relative mb-6">
                                    <!-- Timeline Dot -->
                                    <div class="absolute -left-[20px] top-4 h-0.5 w-2 bg-gray-300"></div>
                                    <div class="border-4 absolute -left-[11px] top-2 flex h-5 w-5 items-center justify-center rounded-full border-white bg-blue-600">
                                    </div>

                                    <div class="rounded-lg bg-blue-100 p-4 shadow">
                                        <h3 class="flex items-center font-semibold text-blue-700">
                                            @noteList.Title
                                        </h3>
                                        <p class="text-gray-700">@noteList.Content</p>
                                        <div class="relative mb-4">
                                            <div class="flex py-2 text-sm text-gray-500">
                                                <i class="fas fa-link mr-2"></i> Attached Files
                                            </div>
                                        </div>
                                        @if (!noteList.IsModified)
                                        {
                                            <div class="mt-2 text-xs text-gray-600">
                                                <i class="fas fa-calendar-alt mr-2 text-sm"></i>@noteList.TimeStamp.ToShortTimeString() | <span class="text-green-700">Published</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mt-2 text-xs text-gray-600">
                                                <i class="fas fa-calendar-alt mr-2 text-sm"></i>@noteList.ModifiedOn?.ToShortTimeString() | <span class="text-rose-700">Modified</span>
                                            </div>
                                        }


                                        <!-- Actions -->
                                        <div class="mt-3 flex items-center justify-between">
                                            <div class="flex space-x-2">
                                                <button class="edit-notes text-gray-700 hover:text-blue-500" data-noteeditid="@noteList.Id"><i class="fas fa-edit"></i> Edit</button>
                                                <button class="delete-notes text-gray-700 hover:text-red-500" data-noteeditid="@noteList.Id"><i class="fas fa-trash"></i> Delete</button>
                                            </div>
                                            @if (noteList.IsPinned)
                                            {
                                                <button class="text-yellow-600"><i class="fas fa-thumbtack"></i></button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>

            <!-- Board 1 Tab -->
            <div id="board1" class="tab-content @(ViewBag.tabName == "board1"? "" : "hidden")">
                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Notes Board</h2>
                    <p class="text-gray-600">Display board-related notes here.</p>
                </div>
                <div class="mx-auto max-w-6xl">
                    <!-- Notes Board Container -->
                    <div class="grid-cols-1 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        <!-- Sample Note -->
                        <div class="rotate-[-2deg] relative transform rounded-lg bg-yellow-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <div class="absolute right-2 top-2 text-gray-700">
                                <i class="fa-solid fa-thumbtack"></i>
                            </div>
                            <h2 class="text-lg font-semibold">Project Planning</h2>
                            <p class="mt-2 text-sm text-gray-800">Finalize project roadmap and assign tasks.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Created: 2025-02-06</div>
                        </div>

                        <div class="rotate-[-2deg] relative transform rounded-lg bg-green-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <div class="absolute right-2 top-2 text-gray-700">
                                <i class="fa-solid fa-thumbtack"></i>
                            </div>
                            <h2 class="text-lg font-semibold">Meeting Notes</h2>
                            <p class="mt-2 text-sm text-gray-800">Discuss feature updates and client requirements.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Modified: 2025-02-05</div>
                        </div>

                        <div class="rotate-[-2deg] relative transform rounded-lg bg-blue-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <h2 class="text-lg font-semibold">Bug Fixes</h2>
                            <p class="mt-2 text-sm text-gray-800">Resolve UI inconsistencies in task module.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Created: 2025-02-04</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Create Board Tab -->
            <div id="create" class="tab-content @(ViewBag.tabName == "create"? "" : "hidden")">
                <h2 class="mb-4 text-2xl font-semibold">Create Board</h2>
                <p class="text-gray-600">Use this section to create a new board.</p>
            </div>
        </div>
    </div>

    <!-- Goals Section -->
    <div class="mb-12">
        <h2 class="mb-6 text-xl font-semibold text-gray-800">Associated Goals</h2>
        <div class="grid-cols-1 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            <!-- Goal Card 1 -->
            <div class="rounded-lg bg-white p-6 shadow-lg">
                <h3 class="mb-2 text-lg font-medium text-gray-800">Goal 1</h3>
                <p class="mb-2 text-gray-600">Productivity: 75%</p>
                <p class="mb-4 text-gray-600">Progress: 50% completed</p>
                <div class="rounded-full bg-green-500 px-4 py-2 text-center text-white">In Progress</div>
            </div>
            <!-- Goal Card 2 -->
            <div class="rounded-lg bg-white p-6 shadow-lg">
                <h3 class="mb-2 text-lg font-medium text-gray-800">Goal 2</h3>
                <p class="mb-2 text-gray-600">Productivity: 85%</p>
                <p class="mb-4 text-gray-600">Progress: 30% completed</p>
                <div class="rounded-full bg-yellow-500 px-4 py-2 text-center text-white">On Track</div>
            </div>
            <!-- Goal Card 3 -->
            <div class="rounded-lg bg-white p-6 shadow-lg">
                <h3 class="mb-2 text-lg font-medium text-gray-800">Goal 3</h3>
                <p class="mb-2 text-gray-600">Productivity: 40%</p>
                <p class="mb-4 text-gray-600">Progress: 70% completed</p>
                <div class="rounded-full bg-red-500 px-4 py-2 text-center text-white">Needs Attention</div>
            </div>
            <!-- Goal Card 4 -->
            <div class="rounded-lg bg-white p-6 shadow-lg">
                <h3 class="mb-2 text-lg font-medium text-gray-800">Goal 4</h3>
                <p class="mb-2 text-gray-600">Productivity: 60%</p>
                <p class="mb-4 text-gray-600">Progress: 90% completed</p>
                <div class="rounded-full bg-blue-500 px-4 py-2 text-center text-white">Completed</div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("AddUpdateGoals")
@await Html.PartialAsync("AddUpdateNotes")

@section Scripts
{
    @* DataTable *@
    <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    @* sweetalert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Client side Script *@
    <script src="~/js/sweetAlertScript.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/goalScript.js"></script>
    <script src="~/js/notesScript.js"></script>

    <script>
        // Goal Growth Ratio Line Chart
        var ctx1 = document.getElementById('taskGrowthChart').getContext('2d');
        var taskGrowthChart = new Chart(ctx1, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                datasets: [{
                    label: 'Goal Growth',
                    data: [12, 19, 3, 5, 2, 3, 9],
                    borderColor: '#4CAF50',
                    borderWidth: 2,
                    fill: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Goal Contribution Pie Chart
        var ctx2 = document.getElementById('goalPieChart').getContext('2d');
        var goalPieChart = new Chart(ctx2, {
            type: 'pie',
            data: {
                labels: ['Goal 1', 'Goal 2', 'Goal 3'],
                datasets: [{
                    data: [40, 30, 30],
                    backgroundColor: ['#FF5733', '#33FF57', '#3357FF'],
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Optional: Resize charts on window resize
        window.addEventListener("resize", function () {
            taskGrowthChart.resize();
            goalPieChart.resize();
        });
    </script>
}