@model TaskMonitoringApp.Models.ViewModel.GoalWithNotesAndTaskNameListViewModel

@{
    ViewData["Title"] = Model.Name + " - Goal Details";
}



<!-- Add a section for DataTables CSS if this page uses DataTables -->
@section Styles {

    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/css/richtextstyle.css" rel="stylesheet" />
}

<div class="mx-auto max-w-7xl px-2 py-12 md:px-6">
    <!-- Dashboard Stats Section (1st Row) -->
    <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-indigo-600"><i class="fas fa-trophy"></i></div>
                <div class="text-lg font-semibold">Running Tasks</div>
            </div>
            <div class="mt-4 text-xl" id="runningTaskCount">@Model.TaskProductivity.RunningTask</div>
        </div>

        <div class="rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-green-600"><i class="fas fa-check"></i></div>
                <div class="text-lg font-semibold">Tasks Completed</div>
            </div>
            <div class="mt-4 text-xl" id="completedTaskCount">@Model.TaskProductivity.CompletedTask</div>
        </div>

        <div class="rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-blue-600"><i class="fas fa-chart-line"></i></div>
                <div class="text-lg font-semibold">Your Growth</div>
            </div>
            <div class="mt-4 text-xl" id="growthCalculations">
                @(Model.TaskProductivity.GrowthPercentage > 0 ? $"+{Model.TaskProductivity.GrowthPercentage}%" : $"-{Model.TaskProductivity.GrowthPercentage}%") this week
            </div>
        </div>

        <div class="rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-purple-600"><i class="fas fa-cogs"></i></div>
                <div class="text-lg font-semibold">Task Productivity</div>
            </div>
            <div class="mt-4 text-xl" id="productivityPercentage">@Model.TaskProductivity.Productivity%</div>
        </div>
    </div>

    @*  <!-- Charts Section -->
    <div class="mb-12 grid gap-8 md:grid-cols-3">
        <!-- Left Chart: Task Growth Ratio (70%) -->
        <div class="col-span-1 h-[400px] rounded-lg bg-white p-6 shadow-lg md:col-span-2">
            <h2 class="mb-4 text-2xl font-semibold text-gray-800">Task Growth Ratio</h2>
            <div class="h-[300px]">
                <canvas id="taskGrowthChart"></canvas>
            </div>
        </div>

        <!-- Right Chart: Donut Chart (30%) -->
        <div class="h-[400px] rounded-lg bg-white p-6 shadow-lg">
            <h2 class="mb-4 text-2xl font-semibold text-gray-800">Contributing to the Goal</h2>
            <div class="h-[300px]">
                <canvas id="goalPieChart"></canvas>
            </div>
        </div>
    </div> *@


    <div class="mb-8 rounded-lg bg-white p-4 shadow-lg sm:p-6">
        <!-- Centered Action Buttons -->
        <div class="mb-6 flex flex-wrap justify-center gap-4">
            <a href="/Tasks/Create?goalId=@Model.Id" class="flex items-center rounded-lg px-6 py-2 text-white transition duration-300 bg-purple-500 hover:bg-purple-600">
                <i class="fas fa-plus mr-2"></i>Add Task
            </a>
            <button data-id="@Model.Id" class="editGoalBtn flex items-center rounded-lg bg-blue-500 px-6 py-2 text-white transition duration-300 hover:bg-blue-600">
                <i class="fas fa-edit mr-2"></i>Edit Goal
            </button>
            <button data-id="@Model.Id" class="deleteGoalBtn flex items-center rounded-lg bg-red-500 px-6 py-2 text-white transition duration-300 hover:bg-red-600">
                <i class="fas fa-trash mr-2"></i>Delete Goal
            </button>
            <button id="openAddNotesModal" data-action-note-form-type-id="@Model.Id" data-action-note-form-type="goal" class="flex items-center rounded-lg bg-yellow-500 px-6 py-2 text-white transition duration-300 hover:bg-yellow-600">
                <i class="fas fa-comment mr-2"></i>Add Notes
            </button>
            <button data-id="@Model.Id" class="markAsComplete flex items-center rounded-lg bg-green-500 px-6 py-2 text-white transition duration-300 hover:bg-green-600">
                <i class="fas fa-check mr-2"></i>Mark as Complete
            </button>
        </div>
        <div class="sticky top-0 z-10 h-auto border-b border-gray-300 bg-white py-1">
            <!-- Tab Navigation -->
            <ul class="flex flex-wrap items-center">
                <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/info") class="@(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName) ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="info">Info</a></li>
                <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/notes") class="@(ViewBag.tabName == "notes" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="notes">All Notes</a></li>
                @* <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/board1") class="@(ViewBag.tabName == "board1" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="board1">Board 1</a></li> *@
                @* <li class="my-2"><a href=@($"/Goals/Details/{Model.Id}/create") class="@(ViewBag.tabName == "create" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="create">Create Board</a></li> *@
            </ul>
        </div>

        <!-- Tab Content -->
        <div class="custom-scrollbar relative z-0 mt-4 max-h-screen overflow-y-scroll">
            <!-- Info Tab -->
            <div id="info" class="tab-content @(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName) ? "" : "hidden")" )>
                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Goal Information</h2>
                    <p class="text-gray-600">Here are all details related to this goals.</p>
                </div>
                <div class="ms-4 space-y-4">
                    <!-- Task Name -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Goal Name</div>
                        <div class="w-full text-left text-lg font-semibold text-gray-800 sm:w-3/4">@Model.Name</div>
                    </div>
                    <!-- Description -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Description</div>
                        <div class="richtext w-full text-left sm:w-3/4">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>
                    <!-- Priority -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Priority</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-xs font-semibold text-white">
                                @Model.Priority
                            </span>
                        </div>
                    </div>
                    <!-- Status -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Status</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-blue-500 px-3 py-1 text-xs font-semibold text-white">
                                @Model.GoalStatus
                            </span>
                        </div>
                    </div>
                    <!-- Status -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">End Date</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white">
                                <!-- TODO: .ToString("hh:mm:ss, MMMM dd, yyyy") Use this for the formatted date and time  -->
                                @Model.EndDate
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notes Tab -->
            <div id="notes" class="tab-content @(ViewBag.tabName == "notes" ? "" : "hidden")">

                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Notes Timeline</h2>
                    <p class="text-gray-600">Here are all the notes related to this goals.</p>
                </div>

                <div class="ms-4 max-w-4xl ps-2 sm:ps-4 sm:ms-8">
                    <!-- Timeline Wrapper -->
                    <div class="relative border-l-4 border-gray-300 pl-6">

                        <!-- Note 1 -->
                        @{
                            DateTime? tempDateTime = null;
                            foreach (var noteList in Model.NotesLists)
                            {
                                if (tempDateTime == null || tempDateTime?.Date != noteList.TimeStamp?.Date)
                                {
                                    <div class="mb-2 mt-4 flex justify-center">
                                        <div class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white">
                                            @if (DateTime.Now.Date == noteList.TimeStamp?.Date)
                                            {
                                                <span>Today</span>
                                            }
                                            else if (DateTime.Now.AddDays(-1).Date == noteList.TimeStamp?.Date)
                                            {
                                                <span>Yesterday</span>
                                            }
                                            else if (noteList.TimeStamp >= DateTime.Now.AddDays(-7).Date)
                                            {
                                                <span>@noteList.TimeStamp?.ToString("dddd")</span>
                                            }
                                            else
                                            {
                                                <span>@noteList.TimeStamp?.ToString("MMMM dd, yyyy")</span>
                                            }
                                        </div>
                                    </div>

                                    tempDateTime = noteList.TimeStamp;
                                }

                                await Html.RenderPartialAsync("NotesLayout", noteList);
                            }
                            <div id="infinite-scroll-sentinel" data-goal-id="@Model.Id" aria-hidden="true"></div>

                        }

                    </div>
                </div>
            </div>

            @*    <!-- Board 1 Tab -->
            <div id="board1" class="tab-content @(ViewBag.tabName == "board1" ? "" : "hidden")">
                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Notes Board</h2>
                    <p class="text-gray-600">Display board-related notes here.</p>
                </div>
                <div class="mx-auto max-w-6xl">
                    <!-- Notes Board Container -->
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        <!-- Sample Note -->
                        <div class="rotate-[-2deg] relative transform rounded-lg bg-yellow-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <div class="absolute right-2 top-2 text-gray-700">
                                <i class="fa-solid fa-thumbtack"></i>
                            </div>
                            <h2 class="text-lg font-semibold">Project Planning</h2>
                            <p class="mt-2 text-sm text-gray-800">Finalize project roadmap and assign tasks.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Created: 2025-02-06</div>
                        </div>

                        <div class="rotate-[-2deg] relative transform rounded-lg bg-green-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <div class="absolute right-2 top-2 text-gray-700">
                                <i class="fa-solid fa-thumbtack"></i>
                            </div>
                            <h2 class="text-lg font-semibold">Meeting Notes</h2>
                            <p class="mt-2 text-sm text-gray-800">Discuss feature updates and client requirements.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Modified: 2025-02-05</div>
                        </div>

                        <div class="rotate-[-2deg] relative transform rounded-lg bg-blue-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <h2 class="text-lg font-semibold">Bug Fixes</h2>
                            <p class="mt-2 text-sm text-gray-800">Resolve UI inconsistencies in task module.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Created: 2025-02-04</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Create Board Tab -->
            <div id="create" class="tab-content @(ViewBag.tabName == "create" ? "" : "hidden")">
                <h2 class="mb-4 text-2xl font-semibold">Create Board</h2>
                <p class="text-gray-600">Use this section to create a new board.</p>
            </div> *@
        </div>
    </div>

    <div class="mx-auto">

        <h1 class="mb-6 text-xl font-semibold text-gray-800">Associated Tasks</h1>


        <!-- running task Section -->
        <section class="mb-8 rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <!-- Task Heading with Actions -->
            <!-- Running Tasks Section -->
            <div class="mb-8">
                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 class="text-xl font-semibold text-gray-700 sm:text-lg">Running Tasks</h2>
                    <a href="/Tasks/Create?goalId=@Model.Id" class="flex items-center rounded-lg px-6 py-2 text-white transition duration-300 bg-purple-500 hover:bg-purple-600">
                        <i class="fas fa-plus mr-2"></i>Add Task
                    </a>
                </div>

                <!-- Running Task List (Table) -->
                <div class="overflow-x-auto">
                    <table id="viewRunningTaskTableData" data-task-status="running" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>


        </section>

        <!-- not-started task section -->
        <section class="mb-8 rounded-lg border-l-4 border-yellow-500 bg-white p-6 shadow-md shadow-yellow-300">
            <!-- not-started Tasks Section -->
            <div class="mb-8">
                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 class="mb-4 text-xl font-semibold text-gray-700">Not Started Tasks</h2>
                </div>

                <!-- not-started Task List (Table) -->
                <div class="overflow-x-auto">
                    <table id="viewNotStartedTaskTableData" data-task-status="notStarted" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </section>

        <!-- completed task section -->
        <section class="mb-8 rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <!-- Task Heading with Actio    ns -->
            <!-- completed Tasks Section -->
            <div class="mb-8">

                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 class="text-xl font-semibold text-gray-700 sm:text-lg">Completed Tasks</h2>
                </div>

                <!-- completed Task List (Table) -->
                <div class="overflow-x-auto">
                    <table id="viewCompletedTaskTableData" data-task-status="completed" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>


        </section>

        <!-- ended task section -->
        <section class="mb-8 rounded-lg border-l-4 border-gray-600 bg-white p-6 shadow-md shadow-gray-500">
            <!-- Ended Tasks Section -->
            <div class="mb-8">

                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 class="mb-4 text-xl font-semibold text-gray-700">Ended Tasks</h2>
                </div>

                <!-- Ended Task List (Table) -->
                <div class="overflow-x-auto">
                    <table id="viewEndedTaskTableData" data-task-status="ended" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </section>

        <!-- deleted task section -->
        <section class="mb-8 rounded-lg border-l-4 border-red-600 bg-white p-6 shadow-md shadow-red-300">
            <!-- Deleted Tasks Section -->
            <div class="mb-8">

                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 class="mb-4 text-xl font-semibold text-gray-700">Deleted Tasks</h2>
                </div>

                <!-- Deleted Task List (Table) -->
                <div class="overflow-x-auto">
                    <table id="viewDeletedTaskTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Task Status</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <!-- Goals Section -->
    @*@if (Model.TaskLists != null && Model?.TaskLists?.Count() > 0)
    {
        <div class="mb-12">
            <h2 class="mb-6 text-xl font-semibold text-gray-800">Associated Goals</h2>
            <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @{

                    foreach (var task in Model.TaskLists)
