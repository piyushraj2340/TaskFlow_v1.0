@model TaskMonitoringApp.Models.ViewModel.GoalWithNotesAndTaskNameListViewModel

@{
    ViewData["Title"] = Model.Name + " - Goal Details";
}

@section Styles {
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="~/css/richtextstyle.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.css" rel="stylesheet" />
}

<div class="mx-auto">

    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-indigo-100 p-4">
                    <i class="fas fa-trophy text-3xl text-indigo-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Running Tasks</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="runningTaskCount">@Model.TaskProductivity.RunningTask</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-green-100 p-4">
                    <i class="fas fa-check text-3xl text-green-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Tasks Completed</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="completedTaskCount">@Model.TaskProductivity.CompletedTask</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-blue-100 p-4">
                    <i class="fas fa-chart-line text-3xl text-blue-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Your Growth</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="growthCalculations">
                        @if (Model.TaskProductivity.GrowthPercentage > 0)
                        {
                            <span class="text-green-600">+@Model.TaskProductivity.GrowthPercentage%</span>
                        }
                        else
                        {
                            <span class="text-red-600">@Model.TaskProductivity.GrowthPercentage%</span>
                        }
                    </div>
                    <div class="text-xs text-gray-500">this week</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-purple-100 p-4">
                    <i class="fas fa-cogs text-3xl text-purple-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Productivity</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="productivityPercentage">@Model.TaskProductivity.Productivity%</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-8 rounded-lg bg-white p-4 shadow-lg sm:p-6">

        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
            <a href="/Tasks/Create?goalId=@Model.Id" class="flex w-full items-center justify-center rounded-lg bg-purple-500 px-6 py-2.5 font-medium text-white transition duration-300 hover:bg-purple-600 sm:w-auto">
                <i class="fas fa-plus mr-2"></i> Add Task
            </a>

            <button data-id="@Model.Id" class="editGoalBtn flex w-full items-center justify-center rounded-lg bg-blue-500 px-6 py-2.5 font-medium text-white transition duration-300 hover:bg-blue-600 sm:w-auto">
                <i class="fas fa-edit mr-2"></i> Edit Goal
            </button>

            <button data-id="@Model.Id" class="deleteGoalBtn flex w-full items-center justify-center rounded-lg bg-red-500 px-6 py-2.5 font-medium text-white transition duration-300 hover:bg-red-600 sm:w-auto">
                <i class="fas fa-trash mr-2"></i> Delete Goal
            </button>

            <button id="openAddNotesModal" data-action-note-form-type-id="@Model.Id" data-action-note-form-type="goal" class="flex w-full items-center justify-center rounded-lg bg-yellow-500 px-6 py-2.5 font-medium text-white transition duration-300 hover:bg-yellow-600 sm:w-auto">
                <i class="fas fa-comment mr-2"></i> Add Notes
            </button>

            <button data-id="@Model.Id" class="markAsComplete flex w-full items-center justify-center rounded-lg bg-green-500 px-6 py-2.5 font-medium text-white transition duration-300 hover:bg-green-600 sm:w-auto">
                <i class="fas fa-check mr-2"></i> Mark Complete
            </button>
        </div>

        <div class="sticky top-0 z-10 bg-white pt-2">
            <div class="border-b border-gray-200 overflow-x-auto">
                <nav class="-mb-px flex space-x-4 sm:space-x-8" aria-label="Tabs">
                    <a href=@($"/Goals/Details/{Model.Id}/info")
                       class="tab-link whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm sm:text-base transition-colors duration-200 @(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName) ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")"
                       data-tab="info">
                        <i class="fas fa-info-circle mr-1 sm:mr-2"></i> Info
                    </a>

                    <a href=@($"/Goals/Details/{Model.Id}/notes")
                       class="tab-link whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm sm:text-base transition-colors duration-200 @(ViewBag.tabName == "notes" ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")"
                       data-tab="notes">
                        <i class="fas fa-sticky-note mr-1 sm:mr-2"></i> All Notes
                    </a>

                    <a href=@($"/Goals/Details/{Model.Id}/tasks")
                       class="tab-link whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm sm:text-base transition-colors duration-200 @(ViewBag.tabName == "tasks" ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")"
                       data-tab="tasks">
                        <i class="fas fa-tasks mr-1 sm:mr-2"></i> Tasks
                    </a>
                </nav>
            </div>
        </div>

        <div class="custom-scrollbar relative z-0 mt-4 max-h-screen overflow-y-scroll p-1">

            <div id="info" class="tab-content @(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName) ? "" : "hidden")">
                <div class="space-y-6">
                    <div class="flex flex-col sm:flex-row border-b border-gray-100 pb-4">
                        <div class="w-full text-sm font-medium text-gray-500 sm:w-1/4 mb-1 sm:mb-0">Goal Name</div>
                        <div class="w-full text-lg font-semibold text-gray-900 sm:w-3/4">@Model.Name</div>
                    </div>

                    <div class="flex flex-col sm:flex-row border-b border-gray-100 pb-4">
                        <div class="w-full text-sm font-medium text-gray-500 sm:w-1/4 mb-1 sm:mb-0">Description</div>
                        <div class="richtext w-full text-gray-800 sm:w-3/4 prose prose-sm max-w-none">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
                        <div class="flex flex-col">
                            <span class="text-sm font-medium text-gray-500 mb-1">Priority</span>
                            <div>
                                <span class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-800">
                                    @Model.Priority
                                </span>
                            </div>
                        </div>

                        <div class="flex flex-col">
                            <span class="text-sm font-medium text-gray-500 mb-1">Status</span>
                            <div>
                                <span class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-800">
                                    @Model.GoalStatus
                                </span>
                            </div>
                        </div>

                        <div class="flex flex-col">
                            <span class="text-sm font-medium text-gray-500 mb-1">End Date</span>
                            <div>
                                <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-800">
                                    @Model.EndDate
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="notes" class="tab-content @(ViewBag.tabName == "notes" ? "" : "hidden")">
                <div class="mb-6">
                    <h2 class="text-xl font-bold text-gray-900">Notes Timeline</h2>
                </div>

                <div class="pl-2 sm:pl-4">
                    <div class="relative border-l-4 border-gray-200 pl-4 sm:pl-8 pb-8">
                        @{
                            DateTime? tempDateTime = null;
                        }

                        @foreach (var noteList in Model.NotesLists)
                        {
                            @if (tempDateTime == null || tempDateTime?.Date != noteList.TimeStamp?.Date)
                            {
                                <div class="mb-2 mt-4 flex justify-center sm:justify-start">
                                    <span class="inline-flex items-center rounded-full bg-gray-600 px-4 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-sm relative sm:-left-[50px]">
                                        @if (DateTime.Now.Date == noteList.TimeStamp?.Date)
                                        {
                                            <span>Today</span>
                                        }
                                        else if (DateTime.Now.AddDays(-1).Date == noteList.TimeStamp?.Date)
                                        {

                                            <span>Yesterday</span>
                                        }
                                        else
                                        {

                                            <span>@noteList.TimeStamp?.ToString("MMM dd, yyyy")</span>
                                        }
                                    </span>
                                </div>
                                tempDateTime = noteList.TimeStamp;
                            }

                            <div class="mb-6 transform transition duration-300 hover:scale-[1.01]">
                                @await Html.PartialAsync("NotesLayout", noteList)
                            </div>
                        }
                        <div id="infinite-scroll-sentinel" data-goal-id="@Model.Id" aria-hidden="true" class="h-4"></div>
                    </div>
                </div>
            </div>

            <div id="tasks" class="tab-content @(ViewBag.tabName == "tasks" ? "" : "hidden")">
                <div class="flex flex-col gap-6">

                    <section class="rounded-lg border-l-4 border-indigo-600 bg-white p-4 shadow-md shadow-indigo-300">
                        <div class="mb-4 flex flex-col justify-between gap-2 border-b border-gray-200 pb-2 sm:flex-row sm:items-center">
                            <h2 class="text-lg font-bold text-gray-800">Running Tasks</h2>
                            <a href="/Tasks/Create?goalId=@Model.Id" class="inline-flex items-center justify-center rounded-lg bg-purple-500 px-4 py-1.5 text-xs font-semibold text-white hover:bg-purple-600 sm:text-sm">
                                <i class="fas fa-plus mr-2"></i> Add Task
                            </a>
                        </div>
                        <div class="overflow-x-auto">
                            <table id="viewRunningTaskTableData" data-task-status="running" class="w-full min-w-full" style="width:100%">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Id</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </section>

                    <section class="rounded-lg border-l-4 border-yellow-500 bg-white p-4 shadow-md shadow-yellow-300">
                        <div class="mb-4 border-b border-gray-200 pb-2">
                            <h2 class="text-lg font-bold text-gray-800">Not Started Tasks</h2>
                        </div>
                        <div class="overflow-x-auto">
                            <table id="viewNotStartedTaskTableData" data-task-status="notStarted" class="w-full min-w-full" style="width:100%">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Id</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </section>

                    <section class="rounded-lg border-l-4 border-green-600 bg-white p-4 shadow-md shadow-green-300">
                        <div class="mb-4 border-b border-gray-200 pb-2">
                            <h2 class="text-lg font-bold text-gray-800">Completed Tasks</h2>
                        </div>
                        <div class="overflow-x-auto">
                            <table id="viewCompletedTaskTableData" data-task-status="completed" class="w-full min-w-full" style="width:100%">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Id</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </section>

                    <section class="rounded-lg border-l-4 border-gray-600 bg-white p-4 shadow-md shadow-gray-400">
                        <div class="mb-4 border-b border-gray-200 pb-2">
                            <h2 class="text-lg font-bold text-gray-800">Ended Tasks</h2>
                        </div>
                        <div class="overflow-x-auto">
                            <table id="viewEndedTaskTableData" data-task-status="ended" class="w-full min-w-full" style="width:100%">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Id</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </section>

                    <section class="rounded-lg border-l-4 border-red-600 bg-white p-4 shadow-md shadow-red-300">
                        <div class="mb-4 border-b border-gray-200 pb-2">
                            <h2 class="text-lg font-bold text-gray-800">Deleted Tasks</h2>
                        </div>
                        <div class="overflow-x-auto">
                            <table id="viewDeletedTaskTableData" class="w-full min-w-full" style="width:100%">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Id</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("AddUpdateGoals")
@await Html.PartialAsync("AddUpdateNotes")

@section Scripts
{
    <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-csharp.min.js"></script>
    <script>
        // Highlight code on load
        Prism.highlightAll();

        // Tab Switching Logic
        document.addEventListener('DOMContentLoaded', function () {
            const tabs = document.querySelectorAll('.tab-link');
            const contents = document.querySelectorAll('.tab-content');

            tabs.forEach(tab => {
                tab.addEventListener('click', function (e) {
                    e.preventDefault();

                    // 1. Reset all tabs styles
                    tabs.forEach(t => {
                        t.classList.remove('border-blue-500', 'text-blue-600');
                        t.classList.add('border-transparent', 'text-gray-500');
                        t.classList.add('hover:border-gray-300', 'hover:text-gray-700');
                    });

                    // 2. Set active tab styles
                    this.classList.remove('border-transparent', 'text-gray-500', 'hover:border-gray-300', 'hover:text-gray-700');
                    this.classList.add('border-blue-500', 'text-blue-600');

                    // 3. Show/Hide Content
                    const targetId = this.getAttribute('data-tab');
                    contents.forEach(c => c.classList.add('hidden'));
                    const targetContent = document.getElementById(targetId);
                    if (targetContent) {
                        targetContent.classList.remove('hidden');
                    }

                    // 4. Update URL (Optional)
                    const url = this.getAttribute('href');
                    if(url && url !== '#') {
                        history.pushState(null, '', url);
                    }
                });
            });
        });
    </script>

    @* Client side Scripts *@
    <script src="~/js/sweetAlertScript.js"></script>
    <script src="~/js/modelScript.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/goalScript.js"></script>
    <script src="~/js/taskScript.js"></script>
    <script src="~/js/notesScript.js"></script>
}