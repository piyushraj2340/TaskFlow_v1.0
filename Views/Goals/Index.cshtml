@model TaskMonitoringApp.Models.DTOs.GoalProductivityDTO

@{
    ViewData["Title"] = "All Goals";
}

@section Styles {
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        /* Tree View Styles from New Design */
        .tree-toggle {
            cursor: pointer;
            transition: transform 0.2s ease-in-out;
        }

            .tree-toggle.expanded {
                transform: rotate(90deg);
            }

        .child-row {
            background-color: #f8fafc;
        }

        .level-1 {
            padding-left: 2rem !important;
        }

        .level-2 {
            padding-left: 3.5rem !important;
        }

        .level-3 {
            padding-left: 5rem !important;
        }

        .level-4 {
            padding-left: 6.5rem !important;
        }

        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            height: 8px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        /* Indentation for Tree Table */
        .level-0 {
            padding-left: 1.5rem !important;
        }

        .level-1 {
            padding-left: 3rem !important;
        }

        .level-2 {
            padding-left: 4.5rem !important;
        }

        .level-3 {
            padding-left: 6rem !important;
        }

        .level-4 {
            padding-left: 7.5rem !important;
        }

        /* Visual Guide Line for nested rows */
        tr[data-level]:not([data-level="0"]) td:first-child {
            position: relative;
        }

            tr[data-level]:not([data-level="0"]) td:first-child::before {
                content: '';
                position: absolute;
                left: 2.2rem; /* Adjust based on level */
                top: 0;
                bottom: 0;
                width: 1px;
                background-color: #e5e7eb; /* Gray-200 */
            }

        /* Level 1 guide adjustment */
        tr.level-1 td:first-child::before {
            left: 2.2rem;
        }

        tr.level-2 td:first-child::before {
            left: 3.7rem;
        }
    </style>
}

<div class="mx-auto">
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-indigo-100 p-4">
                    <i class="fas fa-trophy text-3xl text-indigo-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Running Goals</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="runningGoalCount">@Model.RunningGoal</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-green-100 p-4">
                    <i class="fas fa-check text-3xl text-green-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Goals Completed</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="completedGoalCount">@Model.CompletedGoal</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-blue-100 p-4">
                    <i class="fas fa-chart-line text-3xl text-blue-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Your Growth</div>
                    <div class="truncate text-3xl font-bold" id="growthCalculations">
                        @if (Model.GrowthPercentage > 0)
                        {
                            <span class="text-green-600">+@Model.GrowthPercentage%</span>
                        }
                        else
                        {

                            <span class="text-red-600">@Model.GrowthPercentage%</span>
                        }
                    </div>
                    <div class="text-xs text-gray-500">this week</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-purple-100 p-4">
                    <i class="fas fa-bolt text-3xl text-purple-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Productivity</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="productivityPercentage">@Model.Productivity%</div>
                </div>
            </div>
        </div>
    </div>

    <section class="mb-8 rounded-lg border-l-4 border-indigo-600 bg-white p-4 shadow-md shadow-indigo-300">
        <div class="mb-6">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <h2 class="text-2xl font-bold text-gray-900">Running Goals</h2>
                <button id="openModalButton" class="inline-flex w-full items-center justify-center space-x-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition-all hover:bg-indigo-700 sm:w-auto">
                    <i class="fas fa-plus"></i>
                    <span>Add New Goal</span>
                </button>
            </div>
        </div>
        <div class="overflow-x-auto custom-scrollbar">
            <table id="treeTableRunning" class="w-full min-w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Goal Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
                <tbody id="runningGoalsBody" class="divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </section>

    <section class="mb-8 rounded-lg border-l-4 border-yellow-500 bg-white p-4 shadow-md shadow-yellow-300">
        <div class="mb-6"><h2 class="text-2xl font-bold text-gray-900">Not Started Goals</h2></div>
        <div class="overflow-x-auto custom-scrollbar">
            <table id="treeTableNotStarted" class="w-full min-w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Goal Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
                <tbody id="notStartedGoalsBody" class="divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </section>

    <section class="mb-8 rounded-lg border-l-4 border-green-600 bg-white p-4 shadow-md shadow-green-300">
        <div class="mb-6"><h2 class="text-2xl font-bold text-gray-900">Completed Goals</h2></div>
        <div class="overflow-x-auto custom-scrollbar">
            <table id="treeTableCompleted" class="w-full min-w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Goal Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
                <tbody id="completedGoalsBody" class="divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </section>

    <section class="mb-8 rounded-lg border-l-4 border-gray-600 bg-white p-4 shadow-md shadow-gray-400">
        <div class="mb-6"><h2 class="text-2xl font-bold text-gray-900">Ended Goals</h2></div>
        <div class="overflow-x-auto custom-scrollbar">
            <table id="treeTableEnded" class="w-full min-w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Goal Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
                <tbody id="endedGoalsBody" class="divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </section>

    @await Html.PartialAsync("AddUpdateGoals")
</div>

@section Scripts
{
    <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/sweetAlertScript.js"></script>
    <script src="~/js/modelScript.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/goalScript.js"></script>
}