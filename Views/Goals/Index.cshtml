@model TaskMonitoringApp.Models.DTOs.GoalProductivityDTO

@{
    ViewData["Title"] = "All Goals";
}

<!-- Add a section for DataTables CSS if this page uses DataTables -->
@section Styles {
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div class="container mx-auto p-8">

    <!-- Dashboard Stats Section (1st Row) -->
    <div class="grid-cols-1 mb-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="border-l-4 rounded-lg border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-indigo-600"><i class="fas fa-trophy"></i></div>
                <div class="text-lg font-semibold">Running Goals</div>
            </div>
            <div class="mt-4 text-xl" id="runningGoalCount">@Model.RunningGoal</div>
        </div>

        <div class="border-l-4 rounded-lg border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-green-600"><i class="fas fa-check"></i></div>
                <div class="text-lg font-semibold">Goals Completed</div>
            </div>
            <div class="mt-4 text-xl" id="completedGoalCount">@Model.CompletedGoal</div>
        </div>

        <div class="border-l-4 rounded-lg border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-blue-600"><i class="fas fa-chart-line"></i></div>
                <div class="text-lg font-semibold">Your Growth</div>
            </div>
            <div class="mt-4 text-xl" id="growthCalculations">
                @(Model.GrowthPercentage > 0 ? $"+{Model.GrowthPercentage}%" : $"-{Model.GrowthPercentage}%") this week
            </div>
        </div>

        <div class="border-l-4 rounded-lg border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-purple-600"><i class="fas fa-cogs"></i></div>
                <div class="text-lg font-semibold">Productivity</div>
            </div>
            <div class="mt-4 text-xl" id="productivityPercentage">@Model.Productivity%</div>
        </div>
    </div>

    <section class="border-l-4 mb-8 rounded-lg border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
        <!-- Running Tasks Section -->
        <div class="mb-8">
            <div class="border-b-2 mb-4 flex flex-col items-center justify-between border-gray-500 pb-2 sm:flex-row">
                <h2 class="text-xl font-semibold text-gray-700 sm:text-lg">Running Goals</h2>
                <div>
                    <button id="openModalButton" class="my-1 rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">
                        <i class="fas fa-plus"></i> Add New Goal
                    </button>
                    @* <button id="openModalButton" class="my-1 rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-950">
                        <i class="fas fa-angle-double-right"></i> View All
                    </button> *@
                </div>
            </div>

            <!-- Running Task List (Table) -->
            <div class="overflow-x-auto">
                <table id="viewRunningGoalTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                    <thead>
                        <tr>
                            <th class="p-2 text-left text-gray-600">Id</th>
                            <th class="p-2 text-left text-gray-600">Goal Name</th>
                            <th class="p-2 text-left text-gray-600">Due Date</th>
                            <th class="p-2 text-left text-gray-600">Priority</th>
                            <th class="p-2 text-left text-gray-600">Status</th>
                            <th class="p-2 text-left text-gray-600">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        
    </section>

    <section class="border-l-4 mb-8 rounded-lg border-yellow-500 bg-white p-6 shadow-md shadow-yellow-300">
        <!-- Not Started Tasks Section -->
        <div class="mb-8">

            <div class="border-b-2 mb-4 flex flex-col items-center justify-between border-gray-500 pb-2 sm:flex-row">
                <h2 class="mb-4 text-xl font-semibold text-gray-700">Not Started Goals</h2>
                @* <button id="openModalButton" class="my-1 rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-950">
                    <i class="fas fa-angle-double-right"></i> View All
                </button> *@
            </div>

            

            <!-- Not Started Task List (Table) -->
            <div class="overflow-x-auto">
                <table id="viewNotStartedGoalTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                    <thead>
                        <tr>
                            <th class="p-2 text-left text-gray-600">Id</th>
                            <th class="p-2 text-left text-gray-600">Goal Name</th>
                            <th class="p-2 text-left text-gray-600">Due Date</th>
                            <th class="p-2 text-left text-gray-600">Priority</th>
                            <th class="p-2 text-left text-gray-600">Status</th>
                            <th class="p-2 text-left text-gray-600">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </section>

     <section class="border-l-4 mb-8 rounded-lg border-green-500 bg-white p-6 shadow-md shadow-green-300">
        <!-- Completed Tasks Section -->
        <div class="mb-8">
            <div class="border-b-2 mb-4 flex flex-col items-center justify-between border-gray-500 pb-2 sm:flex-row">
                <h2 class="mb-4 text-xl font-semibold text-gray-700">Completed Goals</h2>
               @*  <button id="openModalButton" class="my-1 rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-950">
                    <i class="fas fa-angle-double-right"></i> View All
                </button> *@
            </div>

            

            <!-- Completed Task List (Table) -->
            <div class="overflow-x-auto">
                <table id="viewCompletedGoalTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                    <thead>
                        <tr>
                            <th class="p-2 text-left text-gray-600">Id</th>
                            <th class="p-2 text-left text-gray-600">Goal Name</th>
                            <th class="p-2 text-left text-gray-600">Due Date</th>
                            <th class="p-2 text-left text-gray-600">Priority</th>
                            <th class="p-2 text-left text-gray-600">Status</th>
                            <th class="p-2 text-left text-gray-600">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </section>
    
    <section class="border-l-4 mb-8 rounded-lg border-gray-600 bg-white p-6 shadow-md shadow-gray-500">
        <!-- Ended Tasks Section -->
        <div class="mb-8">
            <div class="border-b-2 mb-4 flex flex-col items-center justify-between border-gray-500 pb-2 sm:flex-row">
                <h2 class="text-xl font-semibold text-gray-700 sm:text-lg">Ended Goals</h2>
                @* <button id="openModalButton" class="my-1 rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-950">
                    <i class="fas fa-angle-double-right"></i> View All
                </button> *@
            </div>


            <!-- Ended Task List (Table) -->
            <div class="overflow-x-auto">
                <table id="viewEndedGoalTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                    <thead>
                        <tr>
                            <th class="p-2 text-left text-gray-600">Id</th>
                            <th class="p-2 text-left text-gray-600">Goal Name</th>
                            <th class="p-2 text-left text-gray-600">Due Date</th>
                            <th class="p-2 text-left text-gray-600">Priority</th>
                            <th class="p-2 text-left text-gray-600">Status</th>
                            <th class="p-2 text-left text-gray-600">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        
    </section>


    <section class="border-l-4 mb-8 rounded-lg border-red-600 bg-white p-6 shadow-md shadow-red-300">
        <!-- Deleted Tasks Section -->
        <div class="mb-8">
            <div class="border-b-2 mb-4 flex flex-col items-center justify-between border-gray-500 pb-2 sm:flex-row">
                <h2 class="text-xl font-semibold text-gray-700 sm:text-lg">Deleted Goals</h2>
@*                  <button id="openModalButton" class="my-1 rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-950">
                     <i class="fas fa-angle-double-right"></i> View All
                 </button> *@
            </div>


            <!-- Ended Task List (Table) -->
            <div class="overflow-x-auto">
                <table id="viewDeletedTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                    <thead>
                        <tr>
                            <th class="p-2 text-left text-gray-600">Id</th>
                            <th class="p-2 text-left text-gray-600">Goal Name</th>
                            <th class="p-2 text-left text-gray-600">Due Date</th>
                            <th class="p-2 text-left text-gray-600">Priority</th>
                            <th class="p-2 text-left text-gray-600">Status</th>
                            <th class="p-2 text-left text-gray-600">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        
    </section>

    @await Html.PartialAsync("AddUpdateGoals")

    @section Scripts
    {
        @* DataTable *@
        <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

        @* sweetalert *@
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        @* Client side Script *@
        <script src="~/js/sweetAlertScript.js"></script>
        <script src="~/js/utils.js"></script>
        <script src="~/js/goalScript.js"></script>
    }
</div>


