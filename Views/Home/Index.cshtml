@model TaskMonitoringApp.Models.ViewModel.DashboardProductivityViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Add a section for DataTables CSS if this page uses DataTables -->
@section Styles {
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
}
<!-- Main Content -->
<div class="container mx-auto p-8">

    <!-- Dashboard Stats Section (1st Row) -->
    <div class="grid-cols-1 mb-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="border-l-4 rounded-lg border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-indigo-600"><i class="fas fa-trophy"></i></div>
                <div class="text-lg font-semibold">Goals Achieved</div>
            </div>
            <div class="mt-4 text-xl">@Model.CompletedGoals</div>
        </div>

        <div class="border-l-4 rounded-lg border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-green-600"><i class="fas fa-check"></i></div>
                <div class="text-lg font-semibold">Tasks Completed</div>
            </div>
            <div class="mt-4 text-xl">@Model.CompletedTasks</div>
        </div>

        <div class="border-l-4 rounded-lg border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-blue-600"><i class="fas fa-chart-line"></i></div>
                <div class="text-lg font-semibold">Your Growth</div>
            </div>
            <div class="mt-4 text-xl" id="growthPercentage">
                @if(Model.GrowthPercentage == 0)
                {
                    @(Model.GrowthPercentage)<span>% this week</span>
                } else if(Model.GrowthPercentage > 0)
                {
                    <span>+</span> @(Model.GrowthPercentage)<span>% this week</span>
                } else
                {
                    <span>-</span> @(Model.GrowthPercentage)<span>% this week</span>
                }
            </div>
        </div>

        <div class="border-l-4 rounded-lg border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-purple-600"><i class="fas fa-cogs"></i></div>
                <div class="text-lg font-semibold">Productivity</div>
            </div>
            <div class="mt-4 text-xl">@Model.Productivity%</div>
        </div>
    </div>

    <!-- Chart Section (2nd Row) -->
    <div class="grid-cols-1 mb-8 grid gap-6 lg:grid-cols-2">
        <div class="border-l-4 rounded-lg border-teal-400 bg-white p-6 shadow-sm shadow-teal-300">
            <h2 class="mb-4 text-lg font-semibold text-gray-700">Growth Chart</h2>
            <canvas id="growthChart"></canvas>
        </div>

        <div class="border-l-4 rounded-lg border-rose-400 bg-white p-6 shadow-sm shadow-rose-300">
            <h2 class="mb-4 text-lg font-semibold text-gray-700">Productivity Chart</h2>
            <canvas id="productivityChart"></canvas>
        </div>
    </div>


    <section class="border-l-4 mb-8 rounded-lg border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
        <!-- Running Tasks Section -->
        <div class="mb-8">
            <div class="border-b-2 mb-4 flex flex-col items-center justify-between border-gray-500 pb-2 sm:flex-row">
                <h2 class="text-xl font-semibold text-gray-700 sm:text-lg">Running Goals</h2>
                <div>
                    <button id="openModalButton" class="my-1 rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">
                        <i class="fas fa-plus"></i> Add New Goal
                    </button>
                    @* <button id="openModalButton" class="my-1 rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-950">
                    <i class="fas fa-angle-double-right"></i> View All
                    </button> *@
                </div>
            </div>

            <!-- Running Task List (Table) -->
            <div class="overflow-x-auto">
                <table id="viewRunningGoalTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                    <thead>
                        <tr>
                            <th class="p-2 text-left text-gray-600">Id</th>
                            <th class="p-2 text-left text-gray-600">Goal Name</th>
                            <th class="p-2 text-left text-gray-600">Due Date</th>
                            <th class="p-2 text-left text-gray-600">Priority</th>
                            <th class="p-2 text-left text-gray-600">Status</th>
                            <th class="p-2 text-left text-gray-600">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>


    </section>

    <!-- running task Section -->
    <section class="border-l-4 mb-8 rounded-lg border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
        <!-- Task Heading with Actions -->
        <!-- Running Tasks Section -->
        <div class="mb-8">
            <div class="border-b-2 mb-4 flex flex-col items-center justify-between border-gray-500 pb-2 sm:flex-row">
                <h2 class="text-xl font-semibold text-gray-700 sm:text-lg">Running Tasks</h2>
                <a href="@Url.Action("Create","Tasks")" id="openModalButton" class="my-1 rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">
                    <i class="fas fa-plus"></i> Add New Task
                </a>
            </div>

            <!-- Running Task List (Table) -->
            <div class="overflow-x-auto">
                <table id="viewRunningTaskTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                    <thead>
                        <tr>
                            <th class="p-2 text-left text-gray-600">Task Id</th>
                            <th class="p-2 text-left text-gray-600">Task Name</th>
                            <th class="p-2 text-left text-gray-600">Priority</th>
                            <th class="p-2 text-left text-gray-600">Repeat Type</th>
                            <th class="p-2 text-left text-gray-600">Task Status</th>
                            <th class="p-2 text-left text-gray-600">Due Date</th>
                            <th class="p-2 text-left text-gray-600">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>


    </section>


    @await Html.PartialAsync("AddUpdateGoals")
</div>

@section Scripts {
    @* DataTable *@
    <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    @* Sweetalert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Client side Script *@
    <script src="~/js/sweetAlertScript.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/goalScript.js"></script>
    <script src="~/js/taskScript.js"></script>

    <script>
        // Growth and Productivity Chart.js
        const ctxGrowth = document.getElementById('growthChart').getContext('2d');
        const growthChart = new Chart(ctxGrowth, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Growth Over Time',
                    data: [10, 20, 15, 40, 50, 55],
                    fill: false,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    tension: 0.1
                }]
            }
        });

        const ctxProductivity = document.getElementById('productivityChart').getContext('2d');
        const productivityChart = new Chart(ctxProductivity, {
            type: 'bar',
            data: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                datasets: [{
                    label: 'Productivity',
                    data: [70, 85, 60, 80],
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    borderColor: 'rgba(255, 99, 132, 1)',
                    borderWidth: 1
                }]
            },
        });
    </script>
}
