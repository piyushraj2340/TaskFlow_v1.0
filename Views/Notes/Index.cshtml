<script>
$(document).ready(function() {
    $('.show-more-trigger').each(function() {
        var button = $(this);
        var wrapper = button.prev('.content-preview-wrapper');
        var content = wrapper.find('.richtext');

        // Check if the content is actually taller than the preview area
        if (content.height() <= 120) {
            // If not, hide the "Show more" button and the gradient
            button.hide();
            wrapper.find('.gradient-overlay').hide();
            // Also, remove the max-height limit
            wrapper.css('max-height', 'none');
        }
    });

    // Handle the click event
    $('.show-more-trigger').on('click', function() {
        var button = $(this);
        var wrapper = button.prev('.content-preview-wrapper');
        var gradient = wrapper.find('.gradient-overlay');

        // Check if the content is currently expanded
        if (wrapper.hasClass('expanded')) {
            // If yes, COLLAPSE it
            wrapper.removeClass('expanded');
            wrapper.css('max-height', '120px');
            gradient.fadeIn(200);
            button.text('Show more');
        } else {
            // If no, EXPAND it
            wrapper.addClass('expanded');
            // Set max-height to the content's actual full height
            wrapper.css('max-height', wrapper.find('.richtext')[0].scrollHeight + 'px');
            gradient.fadeOut(200);
            button.text('Show less');
        }
    });
});
</script>
}