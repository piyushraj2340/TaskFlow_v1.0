@model IEnumerable<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>

@{
    ViewData["Title"] = "Timeline";
}

@section Styles {
    <link href="~/css/richtextstyle.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<style>
    .circular-tooltip {
        @@apply absolute z-50 left-1/2 top-full mt-2 w-48 -translate-x-1/2 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 p-3 text-xs;
        display: none;
    }

    .circular-meter-group:hover .circular-tooltip {
        display: block;
    }
</style>

<style>
    /* Hide elements until JS initializes */
    [data-cloak] {
        display: none !important;
    }

    /* TIMELINE RESPONSIVE LINE */
    .timeline-center::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(180deg, rgba(99,102,241,0.14), rgba(148,163,184,0.06));
        border-radius: 2px;
        margin: 0;
        z-index: 0; /* Ensure line is behind content */
    }

    /* DESKTOP: Center the line */
    @@media (min-width: 768px) {
        .timeline-center::before {
            left: 50%;
            transform: translateX(-50%);
        }
    }

    /* MOBILE: Line on the left */
    @@media (max-width: 767px) {
        .timeline-center::before {
            left: 20px; /* Aligned with the dots */
            transform: none;
        }
    }

    /* Dot style */
    .timeline-dot {
        width: 14px;
        height: 14px;
        border-radius: 9999px;
        z-index: 10; /* Ensure dots are above line */
        position: relative;
    }

    /* Your existing styles... */
    .collapsible-content {
        overflow: hidden;
        transition: max-height 300ms ease;
    }

    noscript .collapsible-content {
        display: block !important;
        max-height: none !important;
    }

    .rotate-180 {
        transform: rotate(180deg);
    }

    .timeline {
        background-color: #18191b;
    }

    .tooltip-preview {
        cursor: help;
    }

    #infinite-scroll-sentinel {
        display: block;
        width: 100%;
    }
</style>

<header class="mx-auto">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl md:text-3xl font-semibold text-slate-900">My Journal & Timeline</h1>
            <p class="mt-1 text-sm text-slate-500">Your chronological journey of tasks and thoughts.</p>
        </div>
        <div class="hidden md:flex items-center gap-3">
            <button type="button" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white shadow-sm hover:shadow-md transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden>
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 00-1-1H6zm3 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-slate-700">Filter / Search</span>
            </button>
        </div>
    </div>
</header>

<main class="mx-auto">
    <!-- Timeline container -->
    <section class="relative timeline-center">
        <div class="space-y-8 md:space-y-12">

            @{
                int index = 0;
                DateTime? tempDateTime = null;
                int dateIndex = 0;
            }

            @foreach (var item in Model)
            {
                @if (tempDateTime == null || tempDateTime?.Date != item.TimeStamp?.Date)
                {
                    <div class="mb-2 flex items-center justify-start md:justify-center sticky top-[8px] z-[50] pl-[3.25rem] md:pl-0">
                        <div class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white shadow-md">
                            @if (DateTime.Now.Date == item.TimeStamp?.Date)
                            {
                                <span>Today</span>
                            }
                            else if (DateTime.Now.AddDays(-1).Date == item.TimeStamp?.Date)
                            {

                                <span>Yesterday</span>
                            }
                            else if (item.TimeStamp >= DateTime.Now.AddDays(-7).Date)
                            {

                                <span>@item.TimeStamp?.ToString("dddd")</span>
                            }
                            else
                            {

                                <span>@item.TimeStamp?.ToString("MMMM dd, yyyy")</span>
                            }
                        </div>
                    </div>

                    tempDateTime = item.TimeStamp;
                    dateIndex++;
                }

                @if (index % 2 == 0)
                {
                    @await Html.PartialAsync("LeftJournalArticaleView", item)
                }
                else
                {
                    @await Html.PartialAsync("RightJournalArticaleView", item)
                }

                index++;
            }
        </div>

        <div id="infinite-scroll-sentinel" aria-hidden="true"></div>
    </section>
</main>


<div class="fixed right-[1.75rem] bottom-[4.5rem] md:right-[3.4rem] md:bottom-24 z-50 group flex flex-col-reverse items-center">
    <div class="mb-4 flex flex-col items-end space-y-2
                transform scale-95 opacity-0 -translate-y-4
                group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0
                transition-all duration-200 ease-in-out">

        <button id="openModalButton" class="flex items-center group/item" title="Add Goal">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Goal
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-bullseye text-xl"></i>
            </span>
        </button>

        <a href="@Url.Action("Create", "Tasks")" class="flex items-center group/item" title="Add Task">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Task
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-tasks text-xl"></i>
            </span>
        </a>

        <button id="addTodoButton" class="flex items-center group/item" title="Add Todo">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Todo
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-check-square text-xl"></i>
            </span>
        </button>

        <button id="openAddNotesModal" class="flex items-center group/item" title="Add Notes/Journal" data-action-note-form-type="all" data-action-note-form-type-id="0">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Notes/Journal
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-book-open text-xl"></i>
            </span>
        </button>
    </div>

    <!-- Floating Action Button -->
    <button type="button" aria-label="Add entry" id="fab" class="fixed right-6 bottom-6 md:right-12 md:bottom-12 z-50 inline-flex items-center justify-center w-14 h-14 rounded-full shadow-lg bg-indigo-600 text-white hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-200 transition" title="Add new entry">

        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden>

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />

        </svg>

    </button>
</div>

@await Html.PartialAsync("AddUpdateNotes")
@await Html.PartialAsync("AddTodoSearchTaskModal")
@await Html.PartialAsync("AddUpdateGoals")


<!-- Minimal JS: implements collapsible behavior without external libs. Wrapped in try/catch to avoid uncaught exceptions causing confusing "Script error." messages. -->
@section Scripts
{
    @* sweetalert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- PrismJS Core -->
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"></script>

    <!-- Commonly used plugins (optional but recommended) -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.css" rel="stylesheet" />

    <!-- Languages -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-c.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-cpp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-csharp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-java.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-javascript.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-typescript.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-markup.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-css.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-json.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-python.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-go.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-rust.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-kotlin.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-sql.min.js"></script>

    <script>
        // re-highlight after content loads
        Prism.highlightAll();
    </script>


    @* Client side Script *@
    <script src="~/js/sweetAlertScript.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/todoScript.js"></script>
    <script src="~/js/taskScript.js"></script>
    <script src="~/js/goalScript.js"></script>
    <script src="~/js/notesScript.js"></script>


    <script>
        $(document).ready(function() {
            $('.show-more-trigger').each(function() {
                var button = $(this);
                var wrapper = button.prev('.content-preview-wrapper');
                var content = wrapper.find('.richtext');

                // Check if the content is actually taller than the preview area
                if (content.height() <= 120) {
                    // If not, hide the "Show more" button and the gradient
                    button.hide();
                    wrapper.find('.gradient-overlay').hide();
                    // Also, remove the max-height limit
                    wrapper.css('max-height', 'none');
                }
            });

            // Handle the click event
            $('.show-more-trigger').on('click', function() {
                var button = $(this);
                var wrapper = button.prev('.content-preview-wrapper');
                var gradient = wrapper.find('.gradient-overlay');

                // Check if the content is currently expanded
                if (wrapper.hasClass('expanded')) {
                    // If yes, COLLAPSE it
                    wrapper.removeClass('expanded');
                    wrapper.css('max-height', '120px');
                    gradient.fadeIn(200);
                    button.text('Show more');
                } else {
                    // If no, EXPAND it
                    wrapper.addClass('expanded');
                    // Set max-height to the content's actual full height
                    wrapper.css('max-height', wrapper.find('.richtext')[0].scrollHeight + 'px');
                    gradient.fadeOut(200);
                    button.text('Show less');
                }
            });
        });
    </script>
}