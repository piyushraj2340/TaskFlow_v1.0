@model IEnumerable<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>

@{
    ViewData["Title"] = "Timeline";
}

@section Styles {
    <link href="~/css/richtextstyle.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<style>
    .circular-tooltip {
        @@apply absolute z-50 left-1/2 top-full mt-2 w-48 -translate-x-1/2 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 p-3 text-xs;
        display: none;
    }

    .circular-meter-group:hover .circular-tooltip {
        display: block;
    }
</style>

<!-- Select2 CSS/JS -->
<style>
     /* --- Main Select2 Input Container --- */
     #unifiedSearchContainer .select2-container--default .select2-selection--multiple {
         border: none !important;
         box-shadow: none !important;
         min-height: 42px;
     }

     /* --- Container for Selected Tags & Search (within the main input) --- */
     .select2-container--default .select2-selection--multiple .select2-selection__rendered {
         display: flex !important;
         flex-wrap: wrap !important;
         align-items: center !important;
         gap: 5px !important;
         /* Adds space at the bottom for the input field on its own line */
         padding-bottom: 5px !important;
     }

     /* --- Individual Selected Tags (Pills) --- */
     .select2-container--default .select2-selection--multiple .select2-selection__choice {
         background: linear-gradient(90deg, #6366f1 60%, #3b82f6 100%);
         color: #fff;
         border: none;
         border-radius: 9999px;
         font-weight: 500;
         margin-top: 5px !important; /* Spacing for wrapped rows */
         padding: 6px 16px 6px 28px;
         box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
         display: flex;
         align-items: center;
         justify-content: center;
     }

     /* --- The 'x' remove button on each tag --- */
     .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
         color: #fff;
         margin-right: 8px;
         font-size: 1.1em;
         transition: color 0.2s;
         left: 1px;
         top: 4px;
         border-radius: 50%;
     }

         .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
             color: #ef4444;
         }

     /* --- Search Input Field (forces it to a new, full-width line) --- */
     .select2-container--default .select2-selection--multiple .select2-search--inline {
         width: 100% !important;
     }

     .select2-container--default .select2-selection--multiple .select2-search__field {
         width: 100% !important;
         margin-top: 8px !important; /* Adds a little space above the cursor */
     }

     /* --- Add a blue focus ring to the entire container when Select2 is focused --- */
     #unifiedSearchContainer.select2-focused {
         border-color: #6366f1 !important;
         box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.5) !important;
     }

     /* --- Dropdown Panel --- */
     #searchTaskModal .select2-dropdown {
         border-radius: 0.75rem;
         box-shadow: 0 4px 24px rgba(99, 102,241, 0.12);
     }

     /* --- Style for the active filter option in the dropdown --- */
     .status-filter-option.active {
         background-color: #4f46e5; /* indigo-600 */
         color: white;
         font-weight: 600;
     }

     /* --- Styles for the separate selected task cards BELOW the search --- */
     #selectedTasksContainer .task-card .remove-task-btn {
         background: none;
         border: none;
         color: transparent !important;
         font-size: 1.1em;
         cursor: pointer;
         transition: color 0.2s;
     }

     #selectedTasksContainer .task-card:hover .remove-task-btn {
         color: gray !important;
     }

     #selectedTasksContainer .task-card .remove-task-btn:hover {
         color: #ef4444 !important;
     }
</style>

<style>
    /* Hide elements until JS initializes (progressive enhancement) */
    [data-cloak] {
        display: none !important;
    }

    /* Small custom styles to complement Tailwind for the timeline line placement */
    @@media (min-width: 768px) {
        /* center the timeline line on md+ */
        .timeline-center::before {
            left: 50%;
            transform: translateX(-50%);
        }
    }

    @@media (max-width: 767px) {
        /* on mobile the line sits to the left */
        .timeline-center::before {
            left: 24px;
            transform: none;
        }
    }

    .timeline-center::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(180deg, rgba(99,102,241,0.14), rgba(148,163,184,0.06));
        border-radius: 2px;
        margin: 0;
    }

    /* Dot style */
    .timeline-dot {
        width: 14px;
        height: 14px;
        border-radius: 9999px;
    }

    /* Collapsible content base styles */
    .collapsible-content {
        overflow: hidden;
        transition: max-height 300ms ease;
    }

    /* Ensure no-javascript fallback shows the content */
    noscript .collapsible-content {
        display: block !important;
        max-height: none !important;
    }

    /* Small rotate utility for icon */
    .rotate-180 {
        transform: rotate(180deg);
    }


    .timeline {
        background-color: #18191b;
    }


    .tooltip-preview {
        cursor: help;
    }

    /* Sentinel loader alignment */
    #infinite-scroll-sentinel {
        display: block;
        width: 100%;
    }
</style>

<header class="max-w-9xl mx-auto p-6 md:p-10">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl md:text-3xl font-semibold text-slate-900">My Journal & Task Timeline</h1>
            <p class="mt-1 text-sm text-slate-500">A calm, reflective view of your tasks and journal entries — chronological, clear, and minimal.</p>
        </div>
        <div class="hidden md:flex items-center gap-3">
            <button type="button" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white shadow-sm hover:shadow-md transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden>
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 00-1-1H6zm3 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-slate-700">Filter / Search</span>
            </button>
        </div>
    </div>
</header>

<main class="max-w-9xl mx-auto px-4 md:px-6 pb-36">
    <!-- Timeline container -->
    <section class="relative timeline-center">
        <div class="space-y-8 md:space-y-12">

            @{
                int index = 0;
                DateTime? tempDateTime = null;
                int dateIndex = 0;
            }

            @foreach (var item in Model)
            {

                @if (tempDateTime == null || tempDateTime?.Date != item.TimeStamp?.Date)
                {
                    <div class="mb-2 flex items-center justify-center sticky top-[8px] z-[50]">
                        <div class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white">
                            @if (DateTime.Now.Date == item.TimeStamp?.Date)
                            {
                                <span>Today</span>
                            }
                            else if (DateTime.Now.AddDays(-1).Date == item.TimeStamp?.Date)
                            {
                                <span>Yesterday</span>
                            }
                            else if (item.TimeStamp >= DateTime.Now.AddDays(-7).Date)
                            {
                                <span>@item.TimeStamp?.ToString("dddd")</span>
                            }
                            else
                            {
                                <span>@item.TimeStamp?.ToString("MMMM dd, yyyy")</span>
                            }
                        </div>
                    </div>

                    tempDateTime = item.TimeStamp;
                    dateIndex++;
                }

                if (index % 2 == 0)
                {
                    <!-- Timeline Item (left side on desktop) -->
                    @await Html.PartialAsync("LeftJournalArticaleView", item)
                }
                else
                {
                    <!-- Timeline Item (right side on desktop) -->
                    @await Html.PartialAsync("RightJournalArticaleView", item)
                }

                index++;
            }
        </div>

        <!-- infinite scroll sentinel (observed by JS) -->
        <div id="infinite-scroll-sentinel" aria-hidden="true"></div>
    </section>

</main>

<div class="fixed right-[1.75rem] bottom-[4.5rem] md:right-[3.4rem] md:bottom-24 z-50 group flex flex-col-reverse items-center">
    <div class="mb-4 flex flex-col items-end space-y-2 
                transform scale-95 opacity-0 -translate-y-4 
                group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 
                transition-all duration-200 ease-in-out">
        
        <button id="openModalButton" class="flex items-center group/item" title="Add Goal">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Goal
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-bullseye text-xl"></i>
            </span>
        </button>

        <a href="@Url.Action("Create", "Tasks")" class="flex items-center group/item" title="Add Task">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Task
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-tasks text-xl"></i>
            </span>
        </a>

        <button id="addTodoButton" class="flex items-center group/item" title="Add Todo">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Todo
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-check-square text-xl"></i>
            </span>
        </button>

        <button id="openAddNotesModal" class="flex items-center group/item" title="Add Notes/Journal" data-action-note-form-type="all" data-action-note-form-type-id="0">
            <span class="mr-3 px-3 py-2 bg-white text-gray-700 text-sm font-semibold rounded-md shadow-md
                         transform scale-0 group-hover/item:scale-100 transition-transform origin-right">
                Add Notes/Journal
            </span>
            <span class="w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg text-indigo-600 hover:bg-gray-50">
                <i class="fas fa-book-open text-xl"></i>
            </span>
        </button>
    </div>

    <!-- Floating Action Button -->
    <button type="button" aria-label="Add entry" id="fab" class="fixed right-6 bottom-6 md:right-12 md:bottom-12 z-50 inline-flex items-center justify-center w-14 h-14 rounded-full shadow-lg bg-indigo-600 text-white hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-200 transition" title="Add new entry">

        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden>

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />

        </svg>

    </button>
</div>

@await Html.PartialAsync("AddUpdateNotes")
