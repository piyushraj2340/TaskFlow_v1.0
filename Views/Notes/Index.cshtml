@model IEnumerable<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>

@{
    ViewData["Title"] = "Timeline";
    var pinnedNotes = ViewBag.PinnedNotes as IEnumerable<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>;
}

@section Styles {
    <link href="~/css/richtextstyle.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        /* Modern Glassmorphism & Z-Indexing */
        .glass-header {
            background: rgba(248, 250, 252, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Full-width Filter Panel Animation */
        #filterPanel {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transform: translateY(-10px);
        }

            #filterPanel.is-open {
                max-height: 600px;
                opacity: 1;
                transform: translateY(0);
                border-bottom: 1px solid #e2e8f0;
            }

        /* Enhanced Highlight Pulse */
        @@keyframes highlight-focus {
            0%

        {
            border-color: #6366f1;
            box-shadow: 0 0 0 0px rgba(99, 102, 241, 0.4);
            transform: scale(1);
        }

        50% {
            border-color: #818cf8;
            box-shadow: 0 0 0 20px rgba(99, 102, 241, 0);
            transform: scale(1.02); /* Slightly more pronounced scale */
        }

        100% {
            border-color: transparent;
            box-shadow: 0 0 0 0px rgba(99, 102, 241, 0);
            transform: scale(1);
        }

        }

        /* This targets the article inside the wrapper when highlighted */
        .note-highlight-active article,
        .note-highlight-active [role="article"] {
            animation: highlight-focus 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            z-index: 50;
            position: relative;
            border-width: 2px;
            will-change: transform, box-shadow;
        }

        /* Ensure the wrapper handles the Z-index during animation */
        .note-highlight-active {
            z-index: 50 !important;
        }

        /* Hide Scrollbar but keep functionality */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .timeline-date-pill {
            z-index: 30; /* Higher than timeline items, lower than header */
        }

        #filterPanel {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            pointer-events: none; /* Prevents invisible panel from blocking clicks */
        }

            #filterPanel.is-open {
                max-height: 600px;
                opacity: 1;
                pointer-events: auto; /* Re-enable clicks when open */
                border-bottom: 1px solid #e2e8f0;
            }
    </style>
}

<header class="sticky top-[-35px] z-[100] glass-header border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-16 md:h-20">
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-slate-900 tracking-tight">Journal <span class="text-indigo-600">& Timeline</span></h1>
                <p class="hidden md:block text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]">Chronological Productivity</p>
            </div>

            <div class="flex items-center gap-3">
                <div id="activeFilterBadge" class="hidden flex items-center gap-2 px-3 py-1 bg-amber-50 text-amber-700 rounded-full text-[11px] font-bold border border-amber-100">
                    <i class="fas fa-circle text-[6px] animate-pulse"></i> Filters Active
                </div>

                <button type="button" id="toggleFilterMenu" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-sm hover:border-indigo-300 hover:text-indigo-600 transition-all active:scale-95 group">
                    <i class="fas fa-sliders-h text-slate-400 group-hover:text-indigo-500"></i>
                    <span class="text-sm font-semibold">Search & Filter</span>
                    <i class="fas fa-chevron-down text-[10px] opacity-40 transition-transform duration-300" id="filterChevron"></i>
                </button>
            </div>
        </div>
    </div>

    <div id="filterPanel" class="bg-white">
        <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div class="md:col-span-2">
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">Keywords</label>
                    <div class="relative">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-300"></i>
                        <input type="text" id="searchInput"
                               class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all outline-none text-sm"
                               placeholder="Search titles, thoughts, or task details...">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-gray-700">Filter By</label>
                    <select id="filterType" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border p-2">
                        <option value="all">All Items</option>
                        <option value="journal">Journal / Independent</option> <!-- New Option -->
                        <option value="goal">Specific Goal</option>
                        <option value="task">Specific Task</option>
                    </select>
                </div>

                <div class="flex items-end">
                    <div id="filterGoalSelectWrapper" class="hidden w-full">
                        <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">Select Goal</label>
                        <select id="filterGoalSelect" class="w-full"></select>
                    </div>
                    <div id="filterTaskSelectWrapper" class="hidden w-full">
                        <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">Select Task</label>
                        <select id="filterTaskSelect" class="w-full"></select>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-50 flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="text-xs text-slate-400 italic">Pro-tip: Use specific keywords to drill down into your history.</p>
                <div class="flex items-center gap-3 w-full md:w-auto">
                    <button type="button" id="resetFilters" class="flex-1 md:flex-none px-6 py-3 text-sm font-semibold text-slate-500 hover:text-slate-800 transition-colors">Reset</button>
                    <button type="button" id="applyFilters" class="flex-1 md:flex-none px-8 py-3 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-indigo-600 transition-all shadow-xl shadow-slate-200 active:scale-95">Apply Changes</button>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-indigo-50 border-b border-indigo-100 py-2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between">
            <div class="flex items-center gap-4 flex-grow overflow-hidden">
                <div class="bg-indigo-600 text-white p-1.5 rounded-lg shadow-sm flex-shrink-0">
                    <i class="fas fa-thumbtack rotate-45 text-[10px]"></i>
                </div>
                <div id="pinnedNotesList" class="flex-grow relative h-10 overflow-hidden">
                    @await Html.PartialAsync("_PinnedNotesList", pinnedNotes ?? new List<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>())
                </div>
            </div>

            <div class="flex items-center gap-2 ml-4 pl-4 border-l border-indigo-200">
                <span class="text-[10px] font-black text-indigo-400 w-10 text-center">
                    <span id="pinnedCurrentIndex">1</span>/<span id="pinnedTotalCount">0</span>
                </span>
                <div class="flex gap-1">
                    <button id="pinnedUp" class="p-2 hover:bg-white text-indigo-600 rounded-lg transition-all shadow-sm active:scale-90 disabled:opacity-20"><i class="fas fa-chevron-left text-xs"></i></button>
                    <button id="pinnedDown" class="p-2 hover:bg-white text-indigo-600 rounded-lg transition-all shadow-sm active:scale-90 disabled:opacity-20"><i class="fas fa-chevron-right text-xs"></i></button>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8 min-h-screen">
    <section class="relative">
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-slate-200 -translate-x-1/2 hidden md:block"></div>

        <div id="journalItemsContainer" class="space-y-12">
            @{
                int index = 0;
                DateTime? tempDateTime = null;
            }

            @foreach (var item in Model)
            {
                @if (tempDateTime == null || tempDateTime?.Date != item.TimeStamp?.Date)
                {
                    <div class="flex items-center justify-start md:justify-center sticky top-48 timeline-date-pill pointer-events-none">
                        <div class="bg-slate-900 text-white px-4 py-1.5 rounded-full text-[11px] font-bold shadow-lg uppercase tracking-widest">
                            @if (DateTime.Now.Date == item.TimeStamp?.Date)
                            {
                                <span>Today</span>
                            }
                            else if (DateTime.Now.Date.AddDays(-1) == item.TimeStamp?.Date)
                            {

                                <span>Yesterday</span>
                            }
                            else
                            {

                                <span>@item.TimeStamp?.ToString("MMM dd, yyyy")</span>
                            }
                        </div>
                    </div>
                    tempDateTime = item.TimeStamp;
                }

                <div id="note-card-@item.Id" class="note-item-wrapper transition-all duration-700 scroll-mt-52">
                    @if (index % 2 == 0)
                    {
                        @await Html.PartialAsync("LeftJournalArticaleView", item)
                    }
                    else
                    {

                        @await Html.PartialAsync("RightJournalArticaleView", item)
                    }
                </div>
                index++;
            }
        </div>

        <div id="infinite-scroll-sentinel" data-filter-page="notes" class="h-20 mt-10 w-full flex justify-center items-center">
            <div class="animate-pulse text-slate-400 text-sm font-medium">Scanning history...</div>
        </div>
    </section>
</main>

@await Html.PartialAsync("AddUpdateNotes")
@await Html.PartialAsync("AddTodoSearchTaskModal")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        window.currentFilters = { search: null, goalId: null, taskId: null };
        window.infiniteScrollPage = 2; // Update: Start with page 2 for infinite scroll

        $(document).ready(function() {
            // --- 1. Filter Panel Logic ---
            $('#toggleFilterMenu').on('click', function(e) {
                const panel = $('#filterPanel');
                const chevron = $('#filterChevron');
                panel.toggleClass('is-open');
                chevron.toggleClass('rotate-180');

                if (panel.hasClass('is-open') && $('#filterGoalSelect option').length <= 1) {
                    loadFilterOptions();
                }
            });

            // Handle Filter Type Change
            $('#filterType').on('change', function() {
                const val = $(this).val();
                
                // Hide all specific selectors first
                $('#filterGoalSelectWrapper, #filterTaskSelectWrapper').addClass('hidden');
                
                if(val === 'goal') $('#filterGoalSelectWrapper').removeClass('hidden');
                else if(val === 'task') $('#filterTaskSelectWrapper').removeClass('hidden');
                
                // 'journal' doesn't need a sub-selector
            });

            // Handle Filter Apply
            $('#applyFilters').on('click', function() {
                const search = $('#searchInput').val();
                const type = $('#filterType').val();
                let goalId = null;
                let taskId = null;

                if(type === 'goal') {
                    goalId = $('#filterGoalSelect').val();
                } else if(type === 'task') {
                    taskId = $('#filterTaskSelect').val();
                } else if(type === 'journal') {
                    // CRITICAL: Send -1 to signal "Independent" notes
                    goalId = -1; 
                }

                $('#filterMenu').addClass('hidden');
                reloadTimeline(search, goalId, taskId); // goalId -1 triggers "Journal Only"
                
                // ... badge logic ...
            });

            // NEW: Close Filter on Scroll
            $(window).on('scroll', function() {
                if (!$('#filterMenu').hasClass('hidden')) {
                    $('#filterMenu').addClass('hidden');
                }
            });

            function loadFilterOptions() {
                $.get('/Notes/GetFilterMenuOptions', function(resp) {
                    if(resp.status && resp.data) {
                        const data = resp.data;
                        
                        // 1. Goals with Counts
                        const goals = data.goals.map(g => `<option value="${g.id}">${g.name} (${g.count})</option>`);
                        $('#filterGoalSelect').html('<option value="">Any Goal</option>' + goals.join(''));
                        
                        // 2. Tasks with Counts
                        const tasks = data.tasks.map(t => `<option value="${t.id}">${t.name} (${t.count})</option>`);
                        $('#filterTaskSelect').html('<option value="">Any Task</option>' + tasks.join(''));
                        
                        // 3. Update "Journal" option text if needed
                        // Typically handled in static HTML or dynamic injection
                        const journalCount = data.journalCount;
                        // We could add/update an option in the main filterType dropdown
                        const journalOptionText = `Journal / Independent (${journalCount})`;
                        $("#filterType option[value='journal']").text(journalOptionText);
                    }
                });
            }

            $('#resetFilters').on('click', function() { 
                $('#searchInput').val('');
                $('#filterType').val('all').trigger('change');
                $('#activeFilterBadge').addClass('hidden');
                $('#filterPanel').removeClass('is-open');
                reloadTimeline(null, null, null);
            });

            // --- 2. Pinned Carousel Logic ---
            let currentPinnedIndex = 1;
            let totalPinned = 0;

            window.initPinnedCarousel = function() {
                const meta = $('#pinned-metadata');
                totalPinned = meta.data('total') || 0;
                $('#pinnedTotalCount').text(totalPinned);
                $('#pinnedCurrentIndex').text(totalPinned > 0 ? 1 : 0);
                currentPinnedIndex = 1;
                updatePinnedVisibility();
            };

            function updatePinnedVisibility() {
                $('.pinned-item').addClass('hidden opacity-0');
                if (totalPinned > 0) {
                    const active = $(`.pinned-item[data-index="${currentPinnedIndex}"]`);
                    active.removeClass('hidden').addClass('animate-fade-in opacity-100');
                    $('#pinnedCurrentIndex').text(currentPinnedIndex);
                }
                $('#pinnedUp, #pinnedDown').prop('disabled', totalPinned <= 1);
            }

            $('#pinnedUp').on('click', function() {
                currentPinnedIndex = (currentPinnedIndex <= 1) ? totalPinned : currentPinnedIndex - 1;
                updatePinnedVisibility();
            });

            $('#pinnedDown').on('click', function() {
                currentPinnedIndex = (currentPinnedIndex >= totalPinned) ? 1 : currentPinnedIndex + 1;
                updatePinnedVisibility();
            });

            initPinnedCarousel();
        });

        // --- 3. Better Scrolling & Highlight ---
        window.scrollToNote = async function(noteId) {
            const targetId = `note-card-${noteId}`;
            
            // 1. Check if note is ALREADY in the DOM
            let validationEl = document.getElementById(targetId);
            if(validationEl) {
                highlightAndScroll(validationEl);
                return;
            }

            // 2. Fetch from server if missing
            Swal.fire({
                title: 'Locating Note...',
                text: 'Loading timeline context...',
                didOpen: () => { Swal.showLoading() },
                allowOutsideClick: false,
                backdrop: true,
                timer: 15000 
            });

            try {
                // Prepare params
                const params = new URLSearchParams({
                    noteId: noteId,
                    pageSize: 20
                });
                
                // Add current filters to query
                if(window.currentFilters.search) params.append('searchQuery', window.currentFilters.search);
                if(window.currentFilters.goalId !== null) params.append('filterGoalId', window.currentFilters.goalId);
                if(window.currentFilters.taskId !== null) params.append('filterTaskId', window.currentFilters.taskId);

                // Call the endpoint
                const response = await fetch(`/Notes/GetPageForNote?${params.toString()}`);
                
                if (!response.ok) {
                    if(response.status === 404) throw new Error("Note not found.");
                    throw new Error("Server error");
                }
                
                // Correctly parse JSON now
                const data = await response.json(); 

                if (data.status && data.html) {
                    const container = document.getElementById('journalItemsContainer');
                    
                    // Visual separator for jump
                    if (data.pageNumber > window.infiniteScrollPage) {
                         const gap = `
                        <div class="w-full text-center my-8 py-4 bg-gray-50/50 border-y border-gray-100">
                             <div class="text-xs text-uppercase text-gray-400 font-bold tracking-widest">
                                <i class="fas fa-history mr-2"></i> JUMPED TO PAGE ${data.pageNumber}
                             </div>
                        </div>`;
                        container.insertAdjacentHTML('beforeend', gap);
                    }
                    
                    // Update global state
                    window.infiniteScrollPage = data.pageNumber + 1;
                    
                    // Inject HTML
                    container.insertAdjacentHTML('beforeend', data.html);
                    
                    // --- CLOSE LOADING ---
                    Swal.close();

                    // --- POLL FOR ELEMENT ---
                    const foundElement = await waitForElement(targetId);
                    
                    if (foundElement) {
                         setTimeout(() => {
                             highlightAndScroll(foundElement);
                             if(window.Prism) window.Prism.highlightAll();
                         }, 100);
                    } else {
                        console.warn(`Element #${targetId} not found.`);
                        Swal.fire('Warning', 'Note loaded but scrolling failed.', 'warning');
                    }
                } else {
                    Swal.fire('Error', 'Could not load timeline data.', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.close();
                Swal.fire('Note Not Found', 'This note might be filtered out or deleted.', 'info');
            }
        };

        // --- Helper: Reliable Polling Wait ---
        function waitForElement(id) {
            return new Promise((resolve) => {
                let attempts = 0;
                const maxAttempts = 50; // 50 * 50ms = 2.5s total wait
                
                const interval = setInterval(() => {
                    attempts++;
                    const element = document.getElementById(id);
                    
                    if (element) {
                        clearInterval(interval);
                        resolve(element);
                    } else if (attempts >= maxAttempts) {
                        clearInterval(interval);
                        resolve(null); // Failed
                    }
                }, 50); // Check every 50ms
            });
        }

        function highlightAndScroll(element) {
            // 1. Smooth Scroll to center of screen
            // We use block: 'center' to ensure the sticky header doesn't cover it
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // 2. Visual Highlight Logic
            // We remove the class first to allow the animation to restart if clicked again
            element.classList.remove('note-highlight-active');

            // Force a reflow (browser trick to reset CSS animations)
            void element.offsetWidth;

            // 3. Apply the class that triggers the @@keyframes
            element.classList.add('note-highlight-active');

            // 4. Cleanup: Remove the class after the animation finishes (2.5s)
            // This keeps the DOM clean for the next interaction
            setTimeout(() => {
                element.classList.remove('note-highlight-active');
            }, 3000);
        }

        function reloadTimeline(search, goalId, taskId) {
            window.currentFilters = { search, goalId, taskId };
            window.infiniteScrollFinished = false;
            window.infiniteScrollPage = 1;

            const container = $('#journalItemsContainer');
            container.html('<div class="flex justify-center p-20"><div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div></div>');

            $.get('/Notes/GetJournalNotesPartial', {
                pageNumber: 1, pageSize: 20, searchQuery: search, filterGoalId: goalId, filterTaskId: taskId
            }, function(html) {
                if(!html.trim()) {
                    container.html('<div class="text-center py-20 text-slate-400">No matching history found.</div>');
                } else {
                    container.html(html);
                    window.infiniteScrollPage = 2;
                }
            });

            // Sync Pinned Bar
            $.get('/Notes/GetPinnedNotesPartial', { searchQuery: search, filterGoalId: goalId, filterTaskId: taskId }, function(html) {
                $('#pinnedNotesList').html(html);
                initPinnedCarousel();
            });
        }

        // --- Filter Menu Options Load ---
        function loadFilterOptions() {
            $.get('/Notes/GetFilterMenuOptions', function(resp) {
                if(resp.status && resp.data) {
                    const data = resp.data;
                    
                    // 1. Goals with Counts
                    const goals = data.goals.map(g => `<option value="${g.id}">${g.name} (${g.count})</option>`);
                    $('#filterGoalSelect').html('<option value="">Any Goal</option>' + goals.join(''));
                    
                    // 2. Tasks with Counts
                    const tasks = data.tasks.map(t => `<option value="${t.id}">${t.name} (${t.count})</option>`);
                    $('#filterTaskSelect').html('<option value="">Any Task</option>' + tasks.join(''));
                    
                    // 3. Update "Journal" option text if needed
                    // Typically handled in static HTML or dynamic injection
                    const journalCount = data.journalCount;
                    // We could add/update an option in the main filterType dropdown
                    const journalOptionText = `Journal / Independent (${journalCount})`;
                    $("#filterType option[value='journal']").text(journalOptionText);
                }
            });
        }

    </script>
}