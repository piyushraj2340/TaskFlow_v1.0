@model IEnumerable<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>

@{
    ViewData["Title"] = "Timeline";
}

@section Styles {
    <link href="~/css/richtextstyle.css" rel="stylesheet" />
}

<style>
    /* Hide elements until JS initializes (progressive enhancement) */
    [data-cloak] {
        display: none !important;
    }

    /* Small custom styles to complement Tailwind for the timeline line placement */
    @@media (min-width: 768px) {
        /* center the timeline line on md+ */
        .timeline-center::before {
            left: 50%;
            transform: translateX(-50%);
        }
    }

    @@media (max-width: 767px) {
        /* on mobile the line sits to the left */
        .timeline-center::before {
            left: 24px;
            transform: none;
        }
    }

    .timeline-center::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(180deg, rgba(99,102,241,0.14), rgba(148,163,184,0.06));
        border-radius: 2px;
        margin: 0;
    }

    /* Dot style */
    .timeline-dot {
        width: 14px;
        height: 14px;
        border-radius: 9999px;
    }

    /* Collapsible content base styles */
    .collapsible-content {
        overflow: hidden;
        transition: max-height 300ms ease;
    }

    /* Ensure no-javascript fallback shows the content */
    noscript .collapsible-content {
        display: block !important;
        max-height: none !important;
    }

    /* Small rotate utility for icon */
    .rotate-180 {
        transform: rotate(180deg);
    }


    .timeline {
        background-color: #18191b;
    }


    .tooltip-preview {
        cursor: help;
    }

    /* Sentinel loader alignment */
    #infinite-scroll-sentinel {
        display: block;
        width: 100%;
    }
</style>

<header class="max-w-9xl mx-auto p-6 md:p-10">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl md:text-3xl font-semibold text-slate-900">My Journal & Task Timeline</h1>
            <p class="mt-1 text-sm text-slate-500">A calm, reflective view of your tasks and journal entries — chronological, clear, and minimal.</p>
        </div>
        <div class="hidden md:flex items-center gap-3">
            <button type="button" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white shadow-sm hover:shadow-md transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden>
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 00-1-1H6zm3 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-slate-700">Filter / Search</span>
            </button>
        </div>
    </div>
</header>

<main class="max-w-9xl mx-auto px-4 md:px-6 pb-36">
    <!-- Timeline container -->
    <section class="relative timeline-center">
        <div class="space-y-8 md:space-y-12">

            @{
                int index = 0;
                DateTime? tempDateTime = null;
                int dateIndex = 0;
            }

            @foreach (var item in Model)
            {

                @if (tempDateTime == null || tempDateTime?.Date != item.TimeStamp?.Date)
                {
                    <div class="mb-2 flex items-center justify-center sticky top-[8px] z-[9999]">
                        <div class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white">
                            @if (DateTime.Now.Date == item.TimeStamp?.Date)
                            {
                                <span>Today</span>
                            }
                            else if (DateTime.Now.AddDays(-1).Date == item.TimeStamp?.Date)
                            {
                                <span>Yesterday</span>
                            }
                            else if (item.TimeStamp >= DateTime.Now.AddDays(-7).Date)
                            {
                                <span>@item.TimeStamp?.ToString("dddd")</span>
                            }
                            else
                            {
                                <span>@item.TimeStamp?.ToString("MMMM dd, yyyy")</span>
                            }
                        </div>
                    </div>

                    tempDateTime = item.TimeStamp;
                    dateIndex++;
                }

                if (index % 2 == 0)
                {
                    <!-- Timeline Item (left side on desktop) -->
                    @await Html.PartialAsync("LeftJournalArticaleView", item)
                }
                else
                {
                    <!-- Timeline Item (right side on desktop) -->
                    @await Html.PartialAsync("RightJournalArticaleView", item)
                }

                index++;
            }

            <!-- infinite scroll sentinel (observed by JS) -->
            <div id="infinite-scroll-sentinel" aria-hidden="true"></div>
        </div>
    </section>

</main>

<!-- Floating Action Button -->
<button type="button" aria-label="Add entry" id="fab" class="fixed right-6 bottom-6 md:right-12 md:bottom-12 z-50 inline-flex items-center justify-center w-14 h-14 rounded-full shadow-lg bg-indigo-600 text-white hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-200 transition" title="Add new entry">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
</button>

@await Html.PartialAsync("AddUpdateNotes")


<!-- Minimal JS: implements collapsible behavior without external libs. Wrapped in try/catch to avoid uncaught exceptions causing confusing "Script error." messages. -->
@section Scripts
{
    @* sweetalert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <!-- PrismJS Core -->
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"></script>

    <!-- Commonly used plugins (optional but recommended) -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.css" rel="stylesheet" />

    <!-- Languages -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-c.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-cpp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-csharp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-java.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-javascript.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-typescript.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-markup.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-css.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-json.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-python.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-go.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-rust.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-kotlin.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-sql.min.js"></script>

    <script>
        // re-highlight after content loads
        Prism.highlightAll();
    </script>


    @* Client side Script *@
    <script src="~/js/sweetAlertScript.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/notesScript.js"></script>


    <script>
        $(document).ready(function() {
            // Listen for clicks on the trigger element
            $('.collapse-trigger').on('click', function() {
                // Find the collapsible content associated with this trigger
                var content = $(this).siblings('.collapsible-content');

                // Toggle the content's visibility with a 300ms animation
                content.slideToggle(300);

                // Find the icon within the trigger and rotate it 180 degrees
                $(this).find('i.fa-chevron-down').toggleClass('rotate-180');
            });
        });
    </script>
}