@model IEnumerable<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>

@{
    int index = 0;
    // Note: We might need to pass "LastDate" via ViewBag to avoid double headers if appending,
    // but strict correctness is secondary to getting the item visible first.
    DateTime? tempDateTime = ViewBag.LastDate != null 
                             ? DateTime.Parse(ViewBag.LastDate.ToString()) 
                             : (DateTime?)null;
}

@foreach (var item in Model)
{
    // Date Header Logic (simplified for partial - might duplicate headers if not careful, but acceptable for now)
    @if (tempDateTime == null || tempDateTime?.Date != item.TimeStamp?.Date)
    {
        <div class="flex items-center justify-start md:justify-center sticky top-[110px] timeline-date-pill pointer-events-none">
            <div class="bg-slate-900 text-white px-4 py-1.5 rounded-full text-[11px] font-bold tracking-widest">
                @if (DateTime.Now.Date == item.TimeStamp?.Date)
                {
                    <span>Today</span>
                }
                else if (DateTime.Now.Date.AddDays(-1) == item.TimeStamp?.Date)
                {

                    <span>Yesterday</span>
                }
                else
                {

                    <span>@item.TimeStamp?.ToString("MMM dd, yyyy")</span>
                }
            </div>
        </div>
        tempDateTime = item.TimeStamp;
    }

    /* CRITICAL: This ID must match what JS looks for */
    <div id="note-card-@item.Id" class="note-item-wrapper transition-all duration-500">
        @if (index % 2 == 0)
        {
            @await Html.PartialAsync("LeftJournalArticaleView", item)
        }
        else
        {
            @await Html.PartialAsync("RightJournalArticaleView", item)
        }
    </div>
    index++;
}