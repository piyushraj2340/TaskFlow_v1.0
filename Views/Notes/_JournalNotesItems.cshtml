@model IEnumerable<TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO>

@{
    // incoming lastDate (ISO date string) from query / ViewBag
    var skipHeaderForDate = ViewBag.LastDate as string;
    DateTime? prevDate = null;
    int index = 0;
    int startIndex = 0; // consumer uses alternating left/right from overall index; JS increments globalIndex
}

@* This partial renders a block of journal items (articles). 
   It will render date headers except when the first header equals skipHeaderForDate. *@

@foreach (var item in Model)
{
    var itemDate = item.TimeStamp?.Date;
    var itemDateString = itemDate?.ToString("yyyy-MM-dd") ?? string.Empty;

    // Render date header when date changes.
    var shouldRenderHeader = prevDate == null || prevDate?.Date != itemDate;
    if (shouldRenderHeader)
    {
        // If the first header matches skipHeaderForDate, skip rendering it to avoid duplicate header in client
        if (!(prevDate == null && !string.IsNullOrWhiteSpace(skipHeaderForDate) && skipHeaderForDate == itemDateString))
        {
            <div class="mb-2 flex items-center justify-center relative top-[-4px]">
                <div class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white">
                    @if (DateTime.Now.Date == item.TimeStamp?.Date)
                    {
                        <span>Today</span>
                    }
                    else if (DateTime.Now.AddDays(-1).Date == item.TimeStamp?.Date)
                    {
                        <span>Yesterday</span>
                    }
                    else if (item.TimeStamp >= DateTime.Now.AddDays(-7).Date)
                    {
                        <span>@item.TimeStamp?.ToString("dddd")</span>
                    }
                    else
                    {
                        <span>@item.TimeStamp?.ToString("MMMM dd, yyyy")</span>
                    }
                </div>
            </div>
        }
    }

    // Choose left/right partial based on alternating index. Caller must track overall alternation; here we continue local alternation.
    if ((index % 2) == 0)
    {
        @await Html.PartialAsync("LeftJournalArticaleView", item)
    }
    else
    {
        @await Html.PartialAsync("RightJournalArticaleView", item)
    }

    prevDate = item.TimeStamp;
    index++;
}