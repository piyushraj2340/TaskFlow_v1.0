@model TaskMonitoringApp.Models.ViewModel.TaskViewModel;

@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization

@{
    ViewData["Title"] = "Edit Task";
}

@{
    var settings = new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        Formatting = Formatting.None
    };

    var goalListObj = JsonConvert.SerializeObject(Model.GoalLists, settings);
}

<div class="min-h-screen bg-gray-100  px-2 md:px-4 py-6 lg:px-8 flex items-start justify-center sm:items-center">

    <div class="w-full max-w-3xl rounded-xl bg-white p-4 shadow-xl md:p-6">

        <div class="mb-8 border-b border-gray-200 pb-4">
            <h1 class="text-center text-2xl font-bold text-gray-800 sm:text-3xl">
                Edit Task
            </h1>
            <p class="mt-2 text-center text-sm text-gray-500">
                Update the details of your task below.
            </p>
        </div>

        @await Html.PartialAsync("AddUpdateTasks", Model)
    </div>
</div>

@section Scripts {
    <script src="~/js/taskScript.js"></script>

    <script>
        $(document).ready(function () {
            const goals = [];
            const selectedGoals = @Html.Raw(goalListObj);

            // --- UI Helpers ---

            // Ensure the container inside the Partial View has these classes for wrapping
            const $goalContainer = $("#selectedGoalsContainer");
            if (!$goalContainer.hasClass('flex-wrap')) {
                $goalContainer.addClass('flex flex-wrap gap-2');
            }

            // Function to render selected goals (Updated for Mobile)
            function renderSelectedGoals() {
                $goalContainer.empty();

                if (selectedGoals.length === 0) {
                    $goalContainer.append('<p class="text-sm text-gray-400 italic w-full" id="noGoalsMessage">No goals selected.</p>');
                    return;
                }

                selectedGoals.forEach((goal) => {
                    // Updated Badge HTML:
                    // 1. Added 'mb-2' for spacing when wrapping
                    // 2. Added 'max-w-full' and 'truncate' for very long goal names
                    // 3. Increased button size for touch targets
                    const badge = `
                        <div class="inline-flex max-w-full items-center gap-2 rounded-full bg-indigo-100 px-3 py-1.5 text-indigo-700 border border-indigo-200 transition-all hover:bg-indigo-200">
                            <span class="truncate text-sm font-medium">${goal.name}</span>
                            <button
                                type="button"
                                class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-indigo-300 text-white hover:bg-indigo-500 focus:outline-none"
                                onclick="removeGoal(${goal.id})"
                                aria-label="Remove ${goal.name}"
                            >
                                <i class="fas fa-times text-xs"></i>
                            </button>
                        </div>
                    `;
                    $goalContainer.append(badge);
                });
            }

            // Function to render filtered goals (Dropdown)
            function renderFilteredGoals(filteredGoals) {
                const list = $("#filteredGoalsList");
                list.empty();

                filteredGoals.forEach((goal) => {
                    // Updated List Item: Added styling for better mobile touch area
                    const item = `
                        <li class="flex cursor-pointer items-center justify-between border-b border-gray-100 px-4 py-3 last:border-0 hover:bg-indigo-50 transition-colors duration-150"
                            onclick='addGoal(${goal.id})' data-id='${goal.id}' data-name='${goal.name}'>
                            <span class="text-sm font-medium text-gray-700">${goal.name}</span>
                            <i class="fas fa-plus text-xs text-indigo-400"></i>
                        </li>
                    `;
                    list.append(item);
                });

                if (filteredGoals.length > 0) {
                    list.removeClass("hidden");
                    // Add max-height for mobile scrolling within the dropdown
                    list.addClass("max-h-48 overflow-y-auto border border-gray-200 rounded-md shadow-lg mt-1");
                } else {
                    list.addClass("hidden");
                }
            }

            // --- Logic Functions (Kept mostly same, just removed console.logs) ---

            window.addGoal = function (goalId) {
                const goal = goals.find((g) => g.id === goalId);
                if (goal) {
                    const index = selectedGoals.findIndex((g) => g.id === goal.id);
                    if (index === -1) {
                        selectedGoals.push(goal);
                        updateHiddenInput();
                        renderSelectedGoals();
                        $("#searchGoal").val(''); // Clear input after selection
                        filterGoals(""); // clear list
                    }
                }
            };

            window.removeGoal = function (id) {
                const index = selectedGoals.findIndex((g) => g.id === id);
                if (index !== -1) {
                    selectedGoals.splice(index, 1);
                    updateHiddenInput();
                    renderSelectedGoals();
                }
            };

            function updateHiddenInput() {
                 const goalIds = selectedGoals.map((g) => g.id).join(",");
                 $("#GoalIds").val(goalIds);
            }

            const debouncedFilter = debounce(async (query) => {
                try {
                    const res = await $.ajax({
                        url: `/Goals/SearchGoalNameByName?searchQuery=${query}`,
                        method: "POST",
                        contentType: "application/json",
                    });

                    if (res && res.status && Array.isArray(res.data)) {
                        goals.length = 0;
                        res.data.forEach((g) => goals.push({ id: g.id, name: g.name }));
                    }
                    filterGoals(query);
                } catch (error) {
                    console.error("Error fetching goals:", error);
                }
            }, 300);

            function filterGoals(query) {
                if(!query) {
                    $("#filteredGoalsList").addClass("hidden");
                    return;
                }

                const filtered = goals.filter(
                    (goal) =>
                        goal.name.toLowerCase().includes(query.toLowerCase()) &&
                        !selectedGoals.some((g) => g.id === goal.id)
                );
                renderFilteredGoals(filtered);
            }

            $("#searchGoal").on("input", function () {
                const query = $(this).val();
                debouncedFilter(query);
            });

            function debounce(func, wait) {
                let timeout;
                return function (...args) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(this, args), wait);
                };
            }

            // Initial Render
            renderSelectedGoals();
        });
    </script>
}