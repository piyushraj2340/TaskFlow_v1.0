@model TaskMonitoringApp.Models.DTOs.TaskProductivityDTO

@{
    ViewData["Title"] = "All Tasks";
}

@section Styles {
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
}

<style>
    /* Keep your custom dark mode class if needed for specific rows */
    .task {
        background-color: #18191b;
    }
</style>

<div class="container mx-auto p-2 md:p-4 lg:p-6">

    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-indigo-100 p-4">
                    <i class="fas fa-trophy text-3xl text-indigo-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Running Tasks</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="runningTaskCount">@Model.RunningTask</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-green-100 p-4">
                    <i class="fas fa-check text-3xl text-green-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Tasks Completed</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="completedTaskCount">@Model.CompletedTask</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-blue-100 p-4">
                    <i class="fas fa-chart-line text-3xl text-blue-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Your Growth</div>
                    <div class="truncate text-3xl font-bold" id="growthCalculations">
                        @if (Model.GrowthPercentage > 0)
                        {
                            <span class="text-green-600">+@Model.GrowthPercentage%</span>
                        }
                        else
                        {
                            <span class="text-red-600">@Model.GrowthPercentage%</span>
                        }
                    </div>
                    <div class="text-xs text-gray-500">this week</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-purple-100 p-4">
                    <i class="fas fa-cogs text-3xl text-purple-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Productivity</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="productivityPercentage">@Model.Productivity%</div>
                </div>
            </div>
        </div>
    </div>

    <section class="mb-8 rounded-lg border-l-4 border-indigo-600 bg-white p-4 shadow-md shadow-indigo-300">
        <div class="mb-6">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <h2 class="text-2xl font-bold text-gray-900">Running Tasks</h2>
                <a href="@Url.Action("Create")" class="inline-flex w-full items-center justify-center space-x-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-indigo-700 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-opacity-50 sm:w-auto">
                    <i class="fas fa-plus"></i>
                    <span>Add New Task</span>
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="viewRunningTaskTableData" data-task-status="running" class="w-full min-w-full" style="width:100%">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Id</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </section>

    <section class="mb-8 rounded-lg border-l-4 border-yellow-500 bg-white p-4 shadow-md shadow-yellow-300">
        <div class="mb-6">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <h2 class="text-2xl font-bold text-gray-900">Not Started Tasks</h2>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="viewNotStartedTaskTableData" data-task-status="notStarted" class="w-full min-w-full" style="width:100%">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Id</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </section>

    <section class="mb-8 rounded-lg border-l-4 border-green-600 bg-white p-4 shadow-md shadow-green-300">
        <div class="mb-6">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <h2 class="text-2xl font-bold text-gray-900">Completed Tasks</h2>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="viewCompletedTaskTableData" data-task-status="completed" class="w-full min-w-full" style="width:100%">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Id</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </section>

    <section class="mb-8 rounded-lg border-l-4 border-gray-600 bg-white p-4 shadow-md shadow-gray-400">
        <div class="mb-6">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <h2 class="text-2xl font-bold text-gray-900">Ended Tasks</h2>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="viewEndedTaskTableData" data-task-status="ended" class="w-full min-w-full" style="width:100%">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Id</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </section>

    <section class="mb-8 rounded-lg border-l-4 border-red-600 bg-white p-4 shadow-md shadow-red-300">
        <div class="mb-6">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <h2 class="text-2xl font-bold text-gray-900">Deleted Tasks</h2>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="viewDeletedTaskTableData" class="w-full min-w-full" style="width:100%">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Id</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Task Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </section>

    @section Scripts
    {
        @* DataTable *@
        <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

        @* sweetalert *@
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        @* Client side Script *@
        <script src="~/js/sweetAlertScript.js"></script>
        <script src="~/js/utils.js"></script>
        <script src="~/js/taskScript.js"></script>
    }
</div>