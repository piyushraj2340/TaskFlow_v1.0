@model TaskMonitoringApp.Models.ViewModel.TaskViewModel

@{
    ViewData["Title"] = Model.Name;
}

@section Styles {
    <!-- Add a section for DataTables CSS if this page uses DataTables -->
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- Flatpickr (Calendar) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="~/css/richtextstyle.css" rel="stylesheet" />
}

<div class="mx-auto max-w-7xl px-2 py-12 md:px-6">
    <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-indigo-600"><i class="fas fa-trophy"></i></div>
                <div class="text-lg font-semibold">Total Todos</div>
            </div>
            <div class="mt-4 text-xl" id="totalTodoTaskCount">@Model.TodoProgress.TotalTodo</div>
        </div>

        <div class="rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-green-600"><i class="fas fa-check"></i></div>
                <div class="text-lg font-semibold">Completed Todos</div>
            </div>
            <div class="mt-4 text-xl" id="completedTodoTaskCount">@Model.TodoProgress.TotalCompletedTodo</div>
        </div>

        <div class="rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-blue-600"><i class="fas fa-clipboard"></i></div>
                <div class="text-lg font-semibold">Missed Todos</div>
            </div>
            <div class="mt-4 text-xl" id="runningTodoTaskCount">
                @Model.TodoProgress.TotalMissedTodo
            </div>
        </div>

        <div class="rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-purple-600"><i class="fas fa-cogs"></i></div>
                <div class="text-lg font-semibold">Task's Productivity</div>
            </div>
            <div class="mt-4 text-xl" id="productivityPercentageTodo">@Model.TodoProgress.ProductivityForDay%</div>
        </div>
    </div>


    <!-- Charts Section -->
    @*     <div class="mb-12 grid gap-8 md:grid-cols-3">
        <!-- Left Chart: Task Growth Ratio (70%) -->
        <div class="col-span-1 h-[400px] rounded-lg bg-white p-6 shadow-lg md:col-span-2">
            <h2 class="mb-4 text-2xl font-semibold text-gray-800">Task Growth Ratio</h2>
            <div class="h-[300px]">
                <canvas id="taskGrowthChart"></canvas>
            </div>
        </div>

        <!-- Right Chart: Donut Chart (30%) -->
        <div class="h-[400px] rounded-lg bg-white p-6 shadow-lg">
            <h2 class="mb-4 text-2xl font-semibold text-gray-800">Contributing to the Goal</h2>
            <div class="h-[300px]">
                <canvas id="goalPieChart"></canvas>
            </div>
        </div>
    </div> *@


    <div class="mb-8 rounded-lg bg-white p-4 shadow-lg sm:p-6">
        <!-- Centered Action Buttons -->
        <div class="mb-6 flex flex-wrap justify-center gap-4">
            <a href="@Url.Action("Edit", "Tasks", new { id = Model.Id })" class="flex items-center rounded-lg bg-blue-500 px-6 py-2 text-white transition duration-300 hover:bg-blue-600">
                <i class="fas fa-edit mr-2"></i>Edit Task
            </a>
            <button data-id="@Model.Id" class="deleteTaskBtn flex items-center rounded-lg bg-red-500 px-6 py-2 text-white transition duration-300 hover:bg-red-600">
                <i class="fas fa-trash mr-2"></i>Delete Task
            </button>
            <button id="openAddNotesModal" data-action-note-form-type-id="@Model.Id" data-action-note-form-type="task" class="flex items-center rounded-lg bg-yellow-500 px-6 py-2 text-white transition duration-300 hover:bg-yellow-600">
                <i class="fas fa-comment mr-2"></i>Add Notes
            </button>
            <button data-id="@Model.Id" class="markAsCompleteTaskBtn flex items-center rounded-lg bg-green-500 px-6 py-2 text-white transition duration-300 hover:bg-green-600">
                <i class="fas fa-check mr-2"></i>Mark as Complete
            </button>
        </div>

        <div class="sticky top-0 z-10 h-auto border-b border-gray-300 bg-white py-1">
            <!-- Tab Navigation -->
            <ul class="flex flex-wrap items-center">
                <li class="my-2"><a href=@($"/Tasks/Details/{Model.Id}/info") class="@(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName) ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="info">Info</a></li>
                <li class="my-2"><a href=@($"/Tasks/Details/{Model.Id}/notes") class="@(ViewBag.tabName == "notes" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="notes">All Notes</a></li>
                <li class="my-2"><a href=@($"/Tasks/Details/{Model.Id}/todos") class="@(ViewBag.tabName == "todos" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="todos">Todos</a></li>
                @* <li class="my-2"><a href=@($"/Tasks/Details/{Model.Id}/board1") class="@(ViewBag.tabName == "board1" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="board1">Board 1</a></li> *@
                @* <li class="my-2"><a href=@($"/Tasks/Details/{Model.Id}/create") class="@(ViewBag.tabName == "create" ? "text-blue-600 border-blue-600 font-semibold" : "text-gray-600 border-gray-600") tab-link border-l-1 border-r-1 border-b-2 px-4 py-2" data-tab="create">Create Board</a></li> *@
            </ul>
        </div>

        <!-- Tab Content -->
        <div class="custom-scrollbar relative z-0 mt-4 max-h-screen overflow-y-scroll">
            <!-- Task Details Section -->
            <div id="info" class="tab-content @(ViewBag.tabName == "info" || String.IsNullOrWhiteSpace(ViewBag.tabName) ? "" : "hidden") mb-8 rounded-lg bg-white p-6 shadow-lg">

                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 class="mb-3 text-2xl font-semibold text-gray-800">Task Information</h2>
                </div>
                <div class="space-y-4">
                    <!-- Task Name -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Task Name</div>
                        <div class="w-full text-left text-lg font-semibold text-gray-800 sm:w-3/4">@Model.Name</div>
                    </div>
                    <!-- Description -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Description</div>
                        <div class="richtext w-full text-left sm:w-3/4">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>
                    <!-- Repeat Type -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Repeat Type</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-green-500 px-3 py-1 text-xs font-semibold text-white">
                                @Model.Repeat
                            </span>
                        </div>
                    </div>
                    <!-- Repeat Type list -->
                    @{
                        if (Model.Repeat == TaskMonitoringApp.Models.Entities.RepeatType.Weekly && Model.RepeatWeekList != null)
                        {

                            <div class="flex flex-col sm:flex-row">
                                <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Weekly Repeat</div>
                                <div class="w-full text-left sm:w-3/4">

                                    @foreach (TaskMonitoringApp.Models.Entities.Weekly weekName in Model.RepeatWeekList)
                                    {
                                        // <span class="text-sm text-black peer-checked:text-white">@weekName.ToString()</span>
                                        <span class="badge mb-2 mr-2 rounded-full bg-gray-200 px-3 py-1 text-sm text-gray-900">
                                            @weekName.ToString()
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    <!-- Priority -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Priority</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-red-500 px-3 py-1 text-xs font-semibold text-white">
                                @Model.Priority
                            </span>
                        </div>
                    </div>
                    <!-- Status -->
                    <div class="flex flex-col sm:flex-row">
                        <div class="w-full text-lg font-medium text-gray-600 sm:w-1/4">Status</div>
                        <div class="w-full text-left sm:w-3/4">
                            <span class="inline-flex items-center rounded-full bg-blue-500 px-3 py-1 text-xs font-semibold text-white">
                                @Model.TaskStatus
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notes Tab -->
            <div id="notes" class="tab-content @(ViewBag.tabName == "notes" ? "" : "hidden")">

                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Notes Timeline</h2>
                    <p class="text-gray-600">Here are all the notes related to this goals.</p>
                </div>

                <div class="ms-4 max-w-4xl ps-2 sm:ms-8 sm:ps-4">
                    <!-- Timeline Wrapper -->
                    <div class="relative border-l-4 border-gray-300 pl-6">

                        <!-- Note 1 -->
                        @{
                            DateTime? tempDateTime = null;
                            foreach (var noteList in Model.NotesLists)
                            {
                                if (tempDateTime == null || tempDateTime?.Date != noteList.TimeStamp?.Date)
                                {
                                    <div class="mb-2 mt-4 flex justify-center">
                                        <div class="inline-flex items-center rounded-full bg-gray-500 px-3 py-1 text-xs font-semibold text-white">
                                            @if (DateTime.Now.Date == noteList.TimeStamp?.Date)
                                            {
                                                <span>today</span>
                                            }
                                            else if (DateTime.Now.AddDays(-1).Date == noteList.TimeStamp?.Date)
                                            {
                                                <span>Yesterday</span>
                                            }
                                            else if (noteList.TimeStamp >= DateTime.Now.AddDays(-7).Date)
                                            {
                                                <span>@noteList.TimeStamp?.ToString("dddd")</span>
                                            }
                                            else
                                            {
                                                <span>@noteList.TimeStamp?.ToString("MMMM dd, yyyy")</span>
                                            }
                                        </div>
                                    </div>

                                    tempDateTime = noteList.TimeStamp;
                                }

                                <div class="relative mb-6">
                                    <!-- Timeline Dot -->
                                    <div class="absolute -left-[20px] top-4 h-0.5 w-2 bg-gray-300"></div>
                                    <div class="absolute -left-[11px] top-2 flex h-5 w-5 items-center justify-center rounded-full border-4 border-white bg-blue-600">
                                    </div>

                                    <div class="rounded-lg bg-blue-100 p-4 shadow">
                                        <h3 class="flex items-center font-semibold text-blue-700">
                                            @noteList.Title
                                        </h3>
                                        <div class="richtext w-full">
                                            @Html.Raw(noteList.Content)
                                        </div>
                                        <div class="relative mb-4">
                                            <div class="flex py-2 text-sm text-gray-500">
                                                <i class="fas fa-link mr-2"></i> Attached Files
                                            </div>
                                        </div>
                                        @if (!noteList.IsModified)
                                        {
                                            <div class="mt-2 text-xs text-gray-600">
                                                <i class="fas fa-calendar-alt mr-2 text-sm"></i>@noteList.TimeStamp?.ToShortTimeString() | <span class="text-green-700">Published</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mt-2 text-xs text-gray-600">
                                                <i class="fas fa-calendar-alt mr-2 text-sm"></i>@noteList.ModifiedOn?.ToString("hh:mm:ss, MMMM dd, yyyy") | <span class="text-rose-700">Modified</span>
                                            </div>
                                        }


                                        <!-- Actions -->
                                        <div class="mt-3 flex items-center justify-between">
                                            <div class="flex space-x-2">
                                                <button class="edit-notes text-gray-700 hover:text-blue-500" data-noteeditid="@noteList.Id"><i class="fas fa-edit"></i> Edit</button>
                                                <button class="delete-notes text-gray-700 hover:text-red-500" data-noteeditid="@noteList.Id"><i class="fas fa-trash"></i> Delete</button>
                                            </div>
                                            @if (noteList.IsPinned)
                                            {
                                                <button class="text-yellow-600"><i class="fas fa-thumbtack"></i></button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>

            <div id="todos" class="tab-content @(ViewBag.tabName == "todos" ? "" : "hidden")">
                <div class="mb-6 flex flex-col items-start justify-between rounded-lg border-l-4 border-gray-600 bg-white p-4 shadow-md shadow-gray-300 md:flex-row md:items-center md:p-6">
                    <h2 class="text-lg font-semibold text-gray-700 sm:text-xl">
                        Select Date:
                        <span id="selectedDate" class="inline-flex min-w-max items-center rounded bg-gray-700 px-3 py-1 text-xs font-semibold text-white shadow-md transition duration-300 hover:bg-gray-500 sm:text-sm">
                        </span>
                    </h2>

                    <!-- Container for Buttons & Date Picker -->
                    <div class="mt-4 flex w-full flex-col items-center justify-between space-y-2 sm:flex-row sm:space-y-0 sm:space-x-2 sm:w-auto md:mt-0">
                        <button id="prevDateBtn" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-white transition hover:bg-gray-600 sm:w-auto">
                            <i class="fas fa-arrow-left"></i> Previous
                        </button>

                        <button id="nextDateBtn" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-white transition hover:bg-gray-600 sm:w-auto">
                            Next <i class="fas fa-arrow-right"></i>
                        </button>

                        <input type="text" id="taskDatePicker" class="w-full rounded-md border p-2 shadow-sm sm:w-auto" placeholder="Pick a date">
                    </div>
                </div>

                <div id="todoSections" class="flex flex-col">
                    <!-- running task Section -->
                    <section class="mb-8 rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
                        <!-- Task Heading with Actions -->
                        <!-- Running Tasks Section -->
                        <div class="mb-8">
                            <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                                <h2 id="RunningOrMissingHeadId" class="text-xl font-semibold text-gray-700 sm:text-lg">Today's Tasks</h2>
                                @*<a href="@Url.Action("Create")" id="openModalButton" class="my-1 rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">
                                <i class="fas fa-plus"></i> Add New Todo
                            </a>*@
                            </div>
                            <div class="w-full overflow-x-auto">
                                <table id="viewRunningTodoTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                                    <thead>
                                        <tr>
                                            <th class="p-2 text-left text-gray-600">Task Id</th>
                                            <th class="p-2 text-left text-gray-600">Task Name</th>
                                            <th class="p-2 text-left text-gray-600">Priority</th>
                                            <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                            <th class="p-2 text-left text-gray-600">Due Date</th>
                                            <th class="p-2 text-left text-gray-600">Notes</th>
                                            <th class="p-2 text-left text-gray-600">Productivity</th>
                                            <th class="p-2 text-left text-gray-600">Actions</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>


                    </section>

                    <!-- not-started task section -->
                    <section class="mb-8 rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
                        <!-- Completed Tasks Section -->
                        <div class="mb-8">

                            <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                                <h2 id="CompletedTodoHeadId" class="mb-4 text-xl font-semibold text-gray-700">Today's Completed Tasks</h2>
                            </div>
                            <div class="w-full overflow-x-auto">
                                <table id="viewCompletedTodoTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                                    <thead>
                                        <tr>
                                            <th class="p-2 text-left text-gray-600">Task Id</th>
                                            <th class="p-2 text-left text-gray-600">Task Name</th>
                                            <th class="p-2 text-left text-gray-600">Priority</th>
                                            <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                            <th class="p-2 text-left text-gray-600">Due Date</th>
                                            <th class="p-2 text-left text-gray-600">Notes</th>
                                            <th class="p-2 text-left text-gray-600">Productivity</th>
                                            <th class="p-2 text-left text-gray-600">Actions</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </section>

                </div>



            </div>
            @*
            <!-- Board 1 Tab -->
            <div id="board1" class="tab-content @(ViewBag.tabName == "board1"? "" : "hidden")">
                <div class="mb-4">
                    <h2 class="text-3xl font-bold text-gray-800">Notes Board</h2>
                    <p class="text-gray-600">Display board-related notes here.</p>
                </div>
                <div class="mx-auto max-w-6xl">
                    <!-- Notes Board Container -->
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        <!-- Sample Note -->
                        <div class="rotate-[-2deg] relative transform rounded-lg bg-yellow-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <div class="absolute right-2 top-2 text-gray-700">
                                <i class="fa-solid fa-thumbtack"></i>
                            </div>
                            <h2 class="text-lg font-semibold">Project Planning</h2>
                            <p class="mt-2 text-sm text-gray-800">Finalize project roadmap and assign tasks.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Created: 2025-02-06</div>
                        </div>

                        <div class="rotate-[-2deg] relative transform rounded-lg bg-green-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <div class="absolute right-2 top-2 text-gray-700">
                                <i class="fa-solid fa-thumbtack"></i>
                            </div>
                            <h2 class="text-lg font-semibold">Meeting Notes</h2>
                            <p class="mt-2 text-sm text-gray-800">Discuss feature updates and client requirements.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Modified: 2025-02-05</div>
                        </div>

                        <div class="rotate-[-2deg] relative transform rounded-lg bg-blue-300 p-4 shadow-lg transition-transform duration-200 hover:rotate-0 hover:scale-105">
                            <h2 class="text-lg font-semibold">Bug Fixes</h2>
                            <p class="mt-2 text-sm text-gray-800">Resolve UI inconsistencies in task module.</p>
                            <div class="mt-4 text-xs text-gray-600">🕒 Created: 2025-02-04</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Create Board Tab -->
            <div id="create" class="tab-content @(ViewBag.tabName == "create"? "" : "hidden")">
                <h2 class="mb-4 text-2xl font-semibold">Create Board</h2>
                <p class="text-gray-600">Use this section to create a new board.</p>
            </div> *@
        </div>
    </div>
    <!-- Goals Section -->
    @if (Model.GoalLists != null && Model?.GoalLists?.Count() > 0)
    {
        <div class="mb-12">
            <h2 class="mb-6 text-xl font-semibold text-gray-800">Associated Goals</h2>
            <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @{

                    foreach (var goal in Model.GoalLists)
                    {

                        int productivity = new Random().Next(1, 100);


                        <div class="rounded-lg bg-white p-6 shadow-lg">
                            <a href="@Url.Action("Details", "Goals", new { id = goal.Id })">
                                <h3 class="mb-2 text-lg font-medium text-gray-800">@goal.Name</h3>
                            </a>
                            <p class="mb-2 text-gray-600">Productivity: @productivity%</p>
                            <p class="mb-4 text-gray-600">Progress: @productivity% completed</p>
                            @if (productivity <= 50) //productivity bellow 30 -- need action --added static
                            {
                                <div class="rounded-full bg-red-500 px-4 py-2 text-center text-white">Needs Attention</div>
                            }
                            else if (productivity <= 70)
                            {
                                <div class="rounded-full bg-yellow-500 px-4 py-2 text-center text-white">On Track</div>
                            }
                            else if (productivity <= 90)
                            {
                                <div class="rounded-full bg-green-500 px-4 py-2 text-center text-white">In Progress</div>
                            }
                            else
                            {
                                <div class="rounded-full bg-blue-500 px-4 py-2 text-center text-white">Completed</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("AddUpdateTodoNotes")
@await Html.PartialAsync("AddUpdateNotes")


@section Scripts
{
    @* DataTable *@
    <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    @* sweetalert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    @* Client side Script *@
    <script src="~/js/sweetAlertScript.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/taskScript.js"></script>
    <script src="~/js/notesScript.js"></script>
    <script src="~/js/todoScript.js"></script>


    <!-- PrismJS Core -->
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"></script>

    <!-- Commonly used plugins (optional but recommended) -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/plugins/toolbar/prism-toolbar.min.css" rel="stylesheet" />

    <!-- Languages -->
