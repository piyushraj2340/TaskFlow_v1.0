@{
    ViewData["Title"] = "Collectify";
}

@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css" />

    <style>
        /* Smooth transition for modals */
        #collection-modal, #item-modal {
            transition: opacity 0.2s ease-in-out, visibility 0.2s ease-in-out;
        }

        /* Custom Tagify Styles for Modern Look */
        .tagify {
            --tags-border-color: #e2e8f0; /* slate-200 */
            border-radius: 0.5rem; /* rounded-lg */
            padding: 0.35rem;
            background-color: #f8fafc; /* slate-50 */
            transition: all 0.2s;
        }

            .tagify:hover {
                --tags-border-color: #cbd5e1; /* slate-300 */
                background-color: #ffffff;
            }

            .tagify.tagify--focus {
                --tags-border-color: #6366f1; /* indigo-500 */
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
                background-color: #ffffff;
            }

        .tagify__tag {
            background-color: #e0e7ff;
            color: #4338ca;
            margin: 0.2rem;
            border-radius: 0.375rem;
        }

            .tagify__tag > div::before {
                box-shadow: none;
            }

        /* Mobile transition for sidebar */
        .sidebar-transition {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Hide scrollbar for sleek look but keep functionality */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none; /* IE and Edge */
            scrollbar-width: none; /* Firefox */
        }
    </style>
}

@Html.AntiForgeryToken()

<div class="relative flex h-[calc(100vh-96px)] bg-slate-50 mx-auto overflow-hidden font-sans text-slate-600">

    <div id="mobile-overlay-collection" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-30 hidden md:hidden transition-opacity opacity-0"></div>

    <aside id="sidebar-collection" class="sidebar-transition absolute inset-y-0 left-0 z-40 w-72 bg-white border-r border-slate-200 flex flex-col transform -translate-x-full md:relative md:translate-x-0 shadow-2xl md:shadow-none">

        <div class="p-5 border-b border-slate-100 flex justify-between items-center bg-white/50">
            <h1 class="text-xl font-extrabold text-slate-800 tracking-tight flex items-center gap-2">
                <span class="bg-indigo-600 text-white p-1 rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 00-2.25-2.25H6A2.25 2.25 0 003.75 6v8.25A2.25 2.25 0 006 16.5h2.25m8.25-8.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-7.5A2.25 2.25 0 018.25 18v-1.5m8.25-8.25h-6a2.25 2.25 0 00-2.25 2.25v6" />
                    </svg>
                </span>
                Collections
            </h1>
            <button id="close-collection-sidebar-btn" class="md:hidden p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-full transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="px-4 py-4">
            <div class="relative group">
                <input type="search" id="global-search-input" placeholder="Quick search..."
                       class="w-full pl-10 pr-4 py-2.5 bg-slate-100 border-transparent rounded-xl text-sm focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all duration-200 placeholder-slate-400">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400 group-focus-within:text-indigo-500 transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                </div>
            </div>
        </div>

        <nav class="flex-1 px-3 pb-4 space-y-1 overflow-y-auto no-scrollbar" id="collections-list">
        </nav>

        <div class="p-4 border-t border-slate-100 bg-slate-50/50">
            <button id="add-collection-btn" class="w-full flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 font-semibold py-2.5 px-4 rounded-xl hover:border-indigo-300 hover:text-indigo-600 hover:shadow-sm transition-all duration-200 active:scale-[0.98]">
                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                New Collection
            </button>
        </div>
    </aside>

    <main class="flex-1 flex flex-col overflow-hidden relative w-full bg-slate-50">

        <div class="md:hidden bg-white/80 backdrop-blur-md border-b border-slate-200 p-4 flex items-center gap-4 sticky top-0 z-20">
            <button id="mobile-collection-menu-btn" class="p-1 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>
            <span class="font-bold text-lg text-slate-800 tracking-tight">Collectify</span>
        </div>

        <div class="flex-1 p-4 md:p-8 overflow-y-auto relative">

            <div id="loading-spinner" class="hidden absolute inset-0 bg-white/80 backdrop-blur-sm z-50 flex items-center justify-center">
                <div class="animate-spin rounded-full h-10 w-10 border-4 border-indigo-100 border-t-indigo-600"></div>
            </div>

            <div id="main-content-area" class="max-w-7xl mx-auto">

                <div id="welcome-view" class="text-center h-full flex flex-col justify-center items-center">
                    <div class="max-w-md mx-auto py-10">
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 inline-block mb-6">
                            <svg class="h-16 w-16 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
                            </svg>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800 tracking-tight">Welcome to Collectify</h2>
                        <p class="mt-3 text-slate-500 leading-relaxed">Your personal space to organize everything. Select a collection from the sidebar or create your first one to get started.</p>

                        <button onclick="document.getElementById('add-collection-btn').click()" class="md:hidden mt-6 text-indigo-600 font-medium hover:underline">
                            Create a collection now &rarr;
                        </button>
                    </div>
                </div>

                <div id="collection-view" class="hidden space-y-6">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-4 md:p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex items-center gap-4 w-full md:w-auto overflow-hidden">
                            <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl shrink-0">
                                <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h2 id="collection-title" class="text-2xl font-bold text-slate-800 truncate"></h2>
                                </div>
                                <div class="flex gap-3 mt-1 text-sm">
                                    <button id="edit-collection-btn" class="text-slate-400 hover:text-indigo-600 transition-colors font-medium flex items-center gap-1">
                                        Edit
                                    </button>
                                    <span class="text-slate-300">|</span>
                                    <button id="delete-collection-btn" class="text-slate-400 hover:text-red-500 transition-colors font-medium flex items-center gap-1">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>

                        <button id="add-item-btn" class="w-full md:w-auto flex items-center justify-center gap-2 bg-indigo-600 text-white font-medium py-2.5 px-5 rounded-xl hover:bg-indigo-700 hover:shadow-md active:scale-95 transition-all">
                            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            Add Item
                        </button>
                    </div>

                    <div id="items-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                    </div>

                    <div id="no-items-message" class="hidden flex flex-col items-center justify-center py-20 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50/50">
                        <svg class="w-12 h-12 text-slate-300 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                        </svg>
                        <p class="text-slate-500 font-medium">This collection is empty.</p>
                        <p class="text-slate-400 text-sm mt-1">Click 'Add Item' above to get started.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<div id="collection-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-50 px-4">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md mx-auto transform transition-all">
        <div class="flex justify-between items-center mb-5">
            <h3 id="collection-modal-title" class="text-xl font-bold text-slate-800">Add New Collection</h3>
            <button type="button" onclick="document.getElementById('cancel-collection-modal').click()" class="text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <form id="collection-form">
            <input type="hidden" id="collection-id-input">
            <div class="mb-6">
                <label for="collection-name" class="block text-sm font-semibold text-slate-700 mb-2">Collection Name</label>
                <input type="text" id="collection-name-input" placeholder="e.g., Travel Plans, Favorite Books"
                       class="block w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition-colors" required>
            </div>
            <div class="flex justify-end gap-3">
                <button type="button" id="cancel-collection-modal" class="px-5 py-2.5 rounded-xl text-slate-600 font-medium hover:bg-slate-100 transition-colors">Cancel</button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all">Save Collection</button>
            </div>
        </form>
    </div>
</div>

<div id="item-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-50 px-4">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-lg mx-auto max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-5">
            <h3 id="item-modal-title" class="text-xl font-bold text-slate-800">Add New Item</h3>
            <button type="button" onclick="document.getElementById('cancel-item-modal').click()" class="text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <form id="item-form" class="space-y-5">
            <input type="hidden" id="item-id-input">

            <div>
                <label for="item-name" class="block text-sm font-semibold text-slate-700 mb-1.5">Item Name</label>
                <input type="text" id="item-name-input" placeholder="What is this item?"
                       class="block w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition-colors" required>
            </div>

            <div>
                <label for="item-description" class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
                <textarea id="item-description-input" rows="3" placeholder="Add some details..."
                          class="block w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition-colors resize-none"></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="item-categories" class="block text-sm font-semibold text-slate-700 mb-1.5">Categories</label>
                    <input id="item-categories-input" class="w-full rounded-xl" placeholder="Add category...">
                </div>
                <div>
                    <label for="item-tags" class="block text-sm font-semibold text-slate-700 mb-1.5">Tags</label>
                    <input id="item-tags-input" class="w-full rounded-xl" placeholder="Add tag...">
                </div>
            </div>

            <div class="pt-4 flex justify-end gap-3 border-t border-slate-100 mt-2">
                <button type="button" id="cancel-item-modal" class="px-5 py-2.5 rounded-xl text-slate-600 font-medium hover:bg-slate-100 transition-colors">Cancel</button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all">Save Item</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.polyfills.min.js"></script>

    <script src="https://unpkg.com/heroicons@2.1.3/24/outline/index.js"></script>

    <script src="/js/collectionScript.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mobileMenuBtn = document.getElementById('mobile-collection-menu-btn');
            const closeSidebarBtn = document.getElementById('close-collection-sidebar-btn');
            const sidebar = document.getElementById('sidebar-collection');
            const overlay = document.getElementById('mobile-overlay-collection');

            function toggleSidebar(show) {
                if (show) {
                    // Show sidebar
                    sidebar.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden');
                    setTimeout(() => overlay.classList.remove('opacity-0'), 10);
                } else {
                    // Hide sidebar
                    sidebar.classList.add('-translate-x-full');
                    overlay.classList.add('opacity-0');
                    setTimeout(() => overlay.classList.add('hidden'), 300);
                }
            }

            mobileMenuBtn.addEventListener('click', () => toggleSidebar(true));
            closeSidebarBtn.addEventListener('click', () => toggleSidebar(false));
            overlay.addEventListener('click', () => toggleSidebar(false));
        });
    </script>
}