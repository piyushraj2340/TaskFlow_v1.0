@model TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO

<div class="relative top-[-10px] left-[4px] mb-6">
    <div class="absolute -left-[20px] top-4 h-0.5 w-2 bg-gray-300"></div>
    <div class="absolute -left-[11px] top-2 flex h-5 w-5 items-center justify-center rounded-full border-4 border-white bg-blue-600">
    </div>

    <div class="rounded-lg bg-blue-100 p-4 shadow">
        <div class="collapse-trigger flex cursor-pointer items-center justify-between">
            <h3 class="font-semibold text-blue-700">
                @Model.Title
            </h3>
            <i class="fas fa-chevron-down text-blue-700 transition-transform duration-300"></i>
        </div>

        <div class="collapsible-content mt-4" style="display: none;">
            <div class="richtext w-full">
                @Html.Raw(Model.Content)
            </div>

            <div class="relative mb-4">
                <div class="flex py-2 text-sm text-gray-500">
                    <i class="fas fa-link mr-2"></i> Attached Files
                </div>
            </div>

            @if (!Model.IsModified)
            {
                <div class="mt-2 text-xs text-gray-600">
                    <i class="fas fa-calendar-alt mr-2 text-sm"></i>@Model.TimeStamp?.ToShortTimeString() | <span class="text-green-700">Published</span>
                </div>
            }
            else
            {
                <div class="mt-2 text-xs text-gray-600">
                    <i class="fas fa-calendar-alt mr-2 text-sm"></i>@Model.ModifiedOn?.ToString("hh:mm:ss, MMMM dd, yyyy") | <span class="text-rose-700">Modified</span>
                </div>
            }

            <div class="mt-3 flex items-center justify-between">
                <div class="flex space-x-2">
                    <button class="edit-notes text-gray-700 hover:text-blue-500" data-noteeditid="@Model.Id"><i class="fas fa-edit"></i> Edit</button>
                    <button class="delete-notes text-gray-700 hover:text-red-500" data-noteeditid="@Model.Id"><i class="fas fa-trash"></i> Delete</button>
                </div>
                @if (Model.IsPinned)
                {
                    <button class="text-yellow-600"><i class="fas fa-thumbtack"></i></button>
                }
            </div>
        </div>
    </div>
</div>