@model TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO
@using TaskMonitoringApp.Models.Entities;

@{
    // Helper function for Priority Colors
    string GetPriorityClass(Priority p) => p switch
    {
        Priority.High => "bg-red-50 text-red-700 ring-red-600/20",
        Priority.Medium => "bg-green-50 text-green-700 ring-green-600/20",
        Priority.Low => "bg-gray-50 text-gray-600 ring-gray-500/20",
        _ => "bg-yellow-50 text-yellow-800 ring-yellow-600/20"
    };

    // Helper function for Status Colors
    string GetStatusClass(Status s) => s switch
    {
        Status.NotStarted => "bg-amber-50 text-amber-700 ring-amber-600/20",
        Status.Running => "bg-blue-50 text-blue-700 ring-blue-700/10",
        Status.Completed => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
        Status.Ended => "bg-slate-100 text-slate-600 ring-slate-500/20",
        _ => "bg-gray-50 text-gray-600 ring-gray-500/20"
    };
}

<div class="flex flex-col gap-4">

    @if (Model.Goal != null)
    {
        <div class="relative flex flex-col gap-1.5 rounded-xl border border-transparent p-2.5 transition-all duration-200 md:items-end">

            <a href="@Url.Action("Details", "Goals", new { Id = Model.Goal.Id })"
               class="text-base font-bold text-slate-800 transition-colors hover:text-indigo-600 hover:underline decoration-2 underline-offset-2 md:text-right leading-tight">
                @Model.Goal.Name
            </a>

            <div class="flex flex-wrap items-center gap-2 md:justify-end mb-1">
                <span class="inline-flex items-center rounded-md px-2 py-1 text-[10px] font-medium ring-1 ring-inset @GetStatusClass(Model.Goal.GoalStatus)">
                    @Model.Goal.GoalStatus
                </span>
            </div>

            <div class="relative w-full group">
                <div class="cursor-help text-xs leading-relaxed text-slate-500 line-clamp-2 text-left">
                    @Html.Raw(Model.Goal.Description)
                </div>

                <div class="custom-tooltip pointer-events-none absolute bottom-full right-0 z-[100] mb-3 opacity-0 transition-all duration-200 transform translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto rounded-xl border border-slate-200 bg-white p-2 shadow-2xl w-full">
                    <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/50 px-4 py-3 rounded-t-xl">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Goal Description</span>
                        <i class="fas fa-bullseye text-indigo-400"></i>
                    </div>
                    <div class="richtext max-h-60 overflow-y-auto p-4 text-sm text-left text-slate-700 leading-relaxed">
                        @Html.Raw(Model.Goal.Description)
                    </div>
                    <div class="absolute -bottom-1.5 right-8 h-3 w-3 rotate-45 border-b border-r border-slate-200 bg-white"></div>
                </div>
            </div>
        </div>
    }

    @if (Model.Task != null)
    {
        <div class="relative flex flex-col gap-1.5 rounded-xl border border-transparent p-2.5 transition-all duration-200 md:items-end">

            <a href="@Url.Action("Details", "Tasks", new { Id = Model.Task.Id })"
               class="text-base font-bold text-slate-800 transition-colors hover:text-indigo-600 hover:underline decoration-2 underline-offset-2 md:text-right leading-tight">
                @Model.Task.Name
            </a>

            <div class="flex flex-wrap items-center gap-2 md:justify-end mb-1">
                <span class="inline-flex items-center rounded-md px-2 py-1 text-[10px] font-medium ring-1 ring-inset @GetPriorityClass(Model.Task.Priority)">
                    @Model.Task.Priority
                </span>

                <span class="inline-flex items-center rounded-md px-2 py-1 text-[10px] font-medium ring-1 ring-inset @GetStatusClass(Model.Task.TaskStatus)">
                    @Model.Task.TaskStatus
                </span>
                <div class="mt-0.5 flex items-center gap-1.5 text-[10px] font-medium text-slate-400 md:justify-end">
                    <i class="far fa-clock text-[9px]"></i>
                    @Model.TimeStamp?.ToString("F")
                </div>
            </div>

            <div class="relative w-full group">
                <div class="cursor-help text-xs leading-relaxed text-slate-500 line-clamp-2 text-left">
                    @Html.Raw(Model.Task.Description)
                </div>

                <div class="custom-tooltip pointer-events-none absolute bottom-full right-0 z-[100] mb-3 opacity-0 transition-all duration-200 transform translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto rounded-xl border border-slate-200 bg-white p-2 shadow-2xl w-full">
                    <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/50 px-4 py-3 rounded-t-xl">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Task Description</span>
                        <i class="fas fa-tasks text-indigo-400"></i>
                    </div>
                    <div class="richtext max-h-60 overflow-y-auto p-4 text-sm text-left text-slate-700 leading-relaxed">
                        @Html.Raw(Model.Task.Description)
                    </div>
                    <div class="absolute -bottom-1.5 right-8 h-3 w-3 rotate-45 border-b border-r border-slate-200 bg-white"></div>
                </div>
            </div>
        </div>
    }


    @if(Model.Task == null && Model.Goal == null)
    {
        <div class="relative flex flex-col gap-1.5 rounded-xl border border-transparent p-2.5 transition-all duration-200 md:items-end">

            <h3 class="text-base font-bold text-slate-800 transition-colors md:text-right leading-tight">
                Journal Notes
            </h3>
        </div>
    }
</div>