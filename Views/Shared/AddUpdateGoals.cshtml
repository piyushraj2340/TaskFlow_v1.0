<div id="addEditGoalModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-md p-4 overflow-hidden">
    <div class="relative flex flex-col w-full max-w-2xl max-h-[92vh] rounded-2xl bg-white shadow-2xl overflow-hidden">

        <div class="flex items-center justify-between bg-gradient-to-r from-indigo-600 to-violet-700 px-8 py-5 text-white shrink-0">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                    <i class="fa-solid fa-rocket text-lg"></i>
                </div>
                <div>
                    <h2 id="form-label" class="text-lg font-bold tracking-tight">Add New Goal</h2>
                    <p class="text-[11px] text-indigo-100 opacity-80 uppercase tracking-widest">Goal Management System</p>
                </div>
            </div>
            <button id="closeModalButton" type="button" class="group flex h-9 w-9 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-all">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <div class="custom-scrollbar overflow-y-auto flex-1 px-8 py-6">

            <div id="subGoalModeContainer" class="hidden mb-6 p-5 bg-indigo-50/50 rounded-xl border border-indigo-100 flex items-center justify-between gap-4">
                <div>
                    <label class="block text-sm font-bold text-indigo-900">Sub-goal Mode</label>
                    <p class="text-xs text-indigo-600">Add new or link existing</p>
                </div>
                <div class="flex bg-white p-1 rounded-lg shadow-sm border border-indigo-100 shrink-0">
                    <label class="flex items-center px-3 py-1.5 cursor-pointer rounded-md transition-all has-[:checked]:bg-indigo-600 has-[:checked]:text-white">
                        <input type="radio" name="subGoalMode" value="new" checked class="hidden">
                        <span class="text-xs font-semibold">New</span>
                    </label>
                    <label class="flex items-center px-3 py-1.5 cursor-pointer rounded-md transition-all has-[:checked]:bg-indigo-600 has-[:checked]:text-white">
                        <input type="radio" name="subGoalMode" value="existing" class="hidden">
                        <span class="text-xs font-semibold">Link Existing</span>
                    </label>
                </div>
            </div>

            <div id="existingGoalSearchContainer" class="hidden mb-6">
                <label for="existingGoalSearch" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2 ml-1">Search Existing Goal</label>
                <select id="existingGoalSearch" class="select2-modern w-full"></select>
                <p class="mt-2 text-[10px] text-indigo-500"><i class="fas fa-info-circle mr-1"></i>Details will auto-fill upon selection.</p>
            </div>

            <form id="goalForm" class="space-y-6">
                <div class="w-full">
                    <label for="goalName" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2 ml-1">Goal Identity <span class="text-rose-500">*</span></label>
                    <input type="text" id="goalName" name="goalName" class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-slate-700 focus:border-indigo-500 focus:bg-white outline-none transition-all" required placeholder="e.g. Master System Design" />
                </div>

                <div class="w-full">
                    <label for="parentGoalId" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2 ml-1">Hierarchy Connection</label>
                    <select id="parentGoalId" name="parentGoalId" class="select2-modern w-full"></select>
                </div>

                <div class="w-full">
                    <label for="goalDescription" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2 ml-1">Detailed Roadmap</label>
                    <div class="rounded-xl border border-slate-200 overflow-hidden min-h-[150px]">
                        <textarea id="goalDescription" name="goalDescriptions"></textarea>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full" id="statusPriorityGrid">
                    <div id="priorityWrapper" class="col-span-2 sm:col-span-2">
                        <label for="goalPriority" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2 ml-1">Impact Level</label>
                        <select id="goalPriority" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-indigo-500 transition-all">
                            <option value="0">🟢 Low Priority</option>
                            <option value="1">🟡 Medium Priority</option>
                            <option value="2">🔴 High Priority</option>
                        </select>
                    </div>

                    <div id="goalStatusContainer" class="hidden col-span-1">
                        <label for="goalStatus" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2 ml-1">Progress State</label>
                        <select id="goalStatus" name="goalStatus" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-indigo-500 transition-all">
                            <option value="0">⚪ Not Started</option>
                            <option value="1">🔵 Running</option>
                            <option value="2">✅ Completed</option>
                            <option value="3">⏹️ Ended</option>
                        </select>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-6 space-y-6 w-full">
                    <div class="w-full">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-4 text-center">Timing Strategy</label>
                        <div class="flex flex-wrap justify-center gap-3">
                            <label class="relative flex cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white px-5 py-2 text-sm font-semibold transition-all hover:bg-slate-50 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-700 shadow-sm">
                                <input type="radio" name="goalStart" value="0" class="absolute opacity-0" checked>
                                <span>Manual</span>
                            </label>
                            <label class="relative flex cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white px-5 py-2 text-sm font-semibold transition-all hover:bg-slate-50 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-700 shadow-sm">
                                <input type="radio" name="goalStart" value="1" class="absolute opacity-0">
                                <span>Scheduled</span>
                            </label>
                            <label class="relative flex cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white px-5 py-2 text-sm font-semibold transition-all hover:bg-slate-50 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-700 shadow-sm">
                                <input type="radio" name="goalStart" value="2" class="absolute opacity-0">
                                <span>Immediate</span>
                            </label>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full" id="dateGrid">
                        <div id="startDateContainer" class="hidden col-span-1">
                            <label class="block text-[10px] font-bold text-slate-400 mb-1 ml-1 uppercase">Start Date</label>
                            <div class="relative">
                                <i class="fa-regular fa-calendar absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                                <input type="text" id="startDate" name="startDate" class="w-full rounded-xl border border-slate-200 pl-11 pr-4 py-3 text-sm outline-none shadow-sm focus:border-indigo-500 transition-all">
                            </div>
                        </div>
                        <div id="endDateWrapper" class="col-span-2 sm:col-span-2">
                            <label class="block text-[10px] font-bold text-slate-400 mb-1 ml-1 uppercase">Due Date</label>
                            <div class="relative">
                                <i class="fa-solid fa-flag-checkered absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                                <input type="text" id="endDate" name="endDate" class="w-full rounded-xl border border-slate-200 pl-11 pr-4 py-3 text-sm outline-none shadow-sm focus:border-indigo-500 transition-all" required>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="flex items-center justify-end gap-3 px-8 py-5 border-t border-slate-100 bg-slate-50/30 shrink-0">
            <button type="button" id="cancelModalButton" class="px-6 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-700 transition-all">Discard</button>
            <button id="submit-btn" type="submit" form="goalForm" class="rounded-xl bg-indigo-600 px-8 py-2.5 text-sm font-bold text-white shadow-lg shadow-indigo-200 hover:bg-indigo-700 hover:-translate-y-0.5 transition-all">
                <i class="fa-solid fa-circle-check mr-2"></i> Save Goal
            </button>
        </div>
    </div>
</div>
<style>
    /* --- 1. Base Modal & Layout Fixes --- */
    #addEditGoalModal {
        overflow: hidden; /* Prevent background/outer scrolling */
    }

        /* Smooth pop-in animation */
        #addEditGoalModal:not(.hidden) {
            animation: modalFadeIn 0.2s ease-out;
        }

    @@keyframes modalFadeIn {
        from

    {
        opacity: 0;
        transform: scale(0.98);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    /* Prevent outer body scrolling when modal is open */
    body.modal-open {
        overflow: hidden;
    }

    /* --- 2. Consolidate Custom Scrollbar --- */
    .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
        scrollbar-gutter: stable; /* Prevents layout shift when scrollbar appears */
    }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #9ca3af;
            }

    /* --- 3. Component Styling: Select2 SaaS Look --- */
    .select2-container--default .select2-selection--single {
        border: 1px solid #e2e8f0 !important;
        border-radius: 0.75rem !important;
        height: 50px !important; /* Standardized Height */
        background-color: #f8fafc !important;
        display: flex !important;
        align-items: center !important;
        transition: all 0.2s ease;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #475569 !important;
            padding-left: 1rem !important;
            font-size: 0.875rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 48px !important;
            right: 8px !important;
        }

    .select2-container {
        width: 100% !important;
    }

    /* --- 4. Standard Inputs & Dropdowns --- */
    /* Match standard selects (Priority/Status) to Select2 and Text inputs */
    #goalPriority,
    #goalStatus {
        height: 50px;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 0.75rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
        padding-right: 2.5rem;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
    }

    /* --- 5. Flatpickr Modern Customization --- */
    .flatpickr-calendar {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        border-radius: 12px !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
        border: 1px solid #e2e8f0 !important;
    }

    .flatpickr-day.selected,
    .flatpickr-day.startRange,
    .flatpickr-day.endRange {
        background: #6366f1 !important; /* Indigo-500 */
        color: #fff !important;
        border-radius: 8px !important; /* Modern square-round look */
        border: none !important;
    }

    .flatpickr-day.today {
        border: 2px solid #6366f1 !important;
        color: #6366f1 !important;
    }

    .flatpickr-day.disabled {
        color: #cbd5e1 !important;
        background: #f8fafc !important;
    }

    /* --- 6. TinyMCE Internal Fix --- */
    .tox-tinymce {
        border: none !important;
        width: 100% !important;
        border-radius: 0.75rem !important;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
<!-- Optional: Flatpickr theme for better colors -->
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Shared Flatpickr Config
        const commonConfig = {
            enableTime: true,
            dateFormat: "Y-m-d H:i",
            minDate: "today",
            theme: "material_blue"
        };

        var startPicker = flatpickr("#startDate", {
            ...commonConfig,
            onChange: function(selectedDates) {
                if (selectedDates.length > 0) {
                    endPicker.set("minDate", selectedDates[0]);
                }
            }
        });

        var endPicker = flatpickr("#endDate", { ...commonConfig });

        // Conditional visibility for Scheduled Start Date
        const radioButtons = document.querySelectorAll('input[name="goalStart"]');
        const startContainer = document.getElementById('startDateContainer');

        radioButtons.forEach(radio => {
            radio.addEventListener('change', (e) => {
                if (e.target.value === "1") { // Scheduled
                    startContainer.classList.remove('hidden');
                } else {
                    startContainer.classList.add('hidden');
                }
            });
        });

        // Date Validation on Submit
        document.getElementById("goalForm").addEventListener("submit", function (e) {
            var startInput = document.getElementById("startDate");
            var endInput = document.getElementById("endDate");
            var startDate = startInput.value ? new Date(startInput.value) : null;
            var endDate = endInput.value ? new Date(endInput.value) : null;
            var errorSpan = document.getElementById("goalDueDateError");

            // Only validate if Start Date container is visible (Scheduled mode)
            if (!startContainer.classList.contains('hidden') && startDate && endDate && endDate <= startDate) {
                e.preventDefault();
                errorSpan.textContent = "End date must be after start date.";
                errorSpan.classList.remove("hidden");
                endInput.classList.add("border-red-500");
            } else {
                errorSpan.classList.add("hidden");
                endInput.classList.remove("border-red-500");
            }
        });
    });
</script>