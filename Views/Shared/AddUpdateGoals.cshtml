<div id="addEditGoalModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-gray-800 bg-opacity-50 backdrop-blur-sm">
    <div class="custom-scrollbar relative max-h-[90vh] w-full max-w-xl overflow-auto rounded-lg bg-white shadow-xl sm:w-4/5 lg:w-1/2 xl:w-1/3">

        <div class="flex items-center justify-between bg-indigo-600 px-6 py-4 text-white">
            <h2 id="form-label" class="text-xl font-semibold tracking-wide">
                <i class="fa-solid fa-clipboard-list"></i> Create Your Progress Record in Goal
            </h2>
            <button id="closeModalButton" type="button" class="closeModalButton text-2xl text-white hover:text-gray-200 transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div id="subGoalModeContainer" class="hidden mb-2 p-4 bg-indigo-50 rounded-lg border border-indigo-100">
            <label class="block text-sm font-semibold text-indigo-900 mb-3">Sub-goal Creation Mode</label>
            <div class="flex gap-6">
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="radio" name="subGoalMode" value="new" checked class="h-4 w-4 text-indigo-600 focus:ring-indigo-500">
                    <span class="text-sm font-medium text-indigo-700">Add New Sub-goal</span>
                </label>
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="radio" name="subGoalMode" value="existing" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500">
                    <span class="text-sm font-medium text-indigo-700">Link Existing Goal</span>
                </label>
            </div>
        </div>

        <div id="existingGoalSearchContainer" class="mb-2 hidden px-6">
            <label for="existingGoalSearch" class="block text-sm font-medium text-gray-600">Search Existing Goal</label>
            <div class="mt-1">
                <select id="existingGoalSearch" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" style="width: 100%;">
                    <option value="">Search by name...</option>
                </select>
            </div>
            <p class="mt-1 text-[10px] text-indigo-500"><i class="fas fa-info-circle mr-1"></i>Selecting a goal will automatically fill the details below.</p>
        </div>

        <div class="px-6 py-4">
            <form id="goalForm" class="space-y-4">

                <div id="goalIdContainer" class="hidden">
                    <label for="goalId" class="block text-sm font-medium text-gray-600">Goal Id</label>
                    <input type="text" id="goalId" name="goalId" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 bg-gray-50" readonly>
                </div>

                <div>
                    <label for="goalName" class="block text-sm font-medium text-gray-600">Goal Name <span class="text-red-500">*</span></label>
                    <input type="text" id="goalName" name="goalName" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none transition-all" required minlength="3" maxlength="50" placeholder="Enter your goal name" />
                    <span class="hidden text-xs text-red-500" id="goalNameError">Goal name must be between 3 and 50 characters.</span>
                </div>

                <div>
                    <label for="parentGoalId" class="block text-sm font-medium text-gray-600">Parent Goal <span class="text-gray-400 font-normal">(Optional)</span></label>
                    <div class="mt-1">
                        <select id="parentGoalId" name="parentGoalId" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" style="width: 100%;">
                            <option value="">Select a parent goal...</option>
                        </select>
                    </div>
                    <p class="mt-1 text-[10px] text-gray-500"><i class="fas fa-info-circle mr-1"></i>Organize your tasks by nesting this under another goal.</p>
                </div>

                <div>
                    <label for="goalDescription" class="block text-sm font-medium text-gray-600">Goal Descriptions</label>
                    <textarea id="goalDescription" name="goalDescriptions" rows="4" class="mt-1 w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label for="goalPriority" class="block text-sm font-medium text-gray-600">Goal Priority</label>
                        <select id="goalPriority" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none">
                            <option value="0">Low</option>
                            <option value="1">Medium</option>
                            <option value="2">High</option>
                        </select>
                    </div>

                    <div>
                        <label for="goalStatus" class="block text-sm font-medium text-gray-600">Goal Status</label>
                        <select id="goalStatus" name="goalStatus" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none">
                            <option value="0">Not Started</option>
                            <option value="1">Running</option>
                            <option value="2">Completed</option>
                            <option value="3">Ended</option>
                        </select>
                    </div>
                </div>

                <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                    <label class="block text-sm font-medium text-gray-600 mb-2">Goal Start Option</label>
                    <div class="flex flex-col space-y-2 md:flex-row md:space-y-0 md:space-x-4">
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="goalStart" value="0" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" checked>
                            <span class="text-sm text-gray-700">Manual</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="goalStart" value="1" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500">
                            <span class="text-sm text-gray-700">Scheduled</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="goalStart" value="2" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500">
                            <span class="text-sm text-gray-700">Start Immediately</span>
                        </label>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div id="startDateContainer" class="hidden">
                        <label for="startDate" class="block text-sm font-medium text-gray-600">Start Date</label>
                        <input type="text" id="startDate" name="startDate" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 bg-white" placeholder="Pick Date">
                        <span class="hidden text-xs text-red-500" id="startDateError">Start date is required for scheduling.</span>
                    </div>

                    <div>
                        <label for="endDate" class="block text-sm font-medium text-gray-600">Due Date <span class="text-red-500">*</span></label>
                        <input type="text" id="endDate" name="endDate" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 bg-white" placeholder="Select Due Date." required />
                        <span class="hidden text-xs text-red-500" id="goalDueDateError">End date must be in the future.</span>
                    </div>
                </div>

                <div class="flex justify-end pt-4 border-t border-gray-100">
                    <button type="button" id="cancelModalButton" class="cancelModalButton mr-3 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-all">Cancel</button>
                    <button id="submit-btn" type="submit" class="rounded-md bg-blue-500 px-6 py-2 text-sm font-bold text-white shadow-md hover:bg-blue-600 transition-all">
                        <i class="fa-solid fa-save mr-2"></i> Save Goal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Custom Scrollbar for Modal Body */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f3f4f6;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

    /* Flatpickr Material Customization */
    .flatpickr-calendar {
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        border: none;
    }

    .flatpickr-day.selected {
        background: #4f46e5 !important;
        border-color: #4f46e5 !important;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
<!-- Optional: Flatpickr theme for better colors -->
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
    /* Enhance Flatpickr UI: highlight selected, pagination-like colors */
    .flatpickr-calendar {
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .flatpickr-day.selected, .flatpickr-day.startRange, .flatpickr-day.endRange {
        background: #6366f1 !important; /* Indigo */
        color: #fff !important;
        border-radius: 50% !important;
    }

    .flatpickr-day.today {
        border: 2px solid #6366f1 !important;
    }

    .flatpickr-day.disabled {
        color: #bbb !important;
        background: #f3f4f6 !important;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Shared Flatpickr Config
        const commonConfig = {
            enableTime: true,
            dateFormat: "Y-m-d H:i",
            minDate: "today",
            theme: "material_blue"
        };

        var startPicker = flatpickr("#startDate", {
            ...commonConfig,
            onChange: function(selectedDates) {
                if (selectedDates.length > 0) {
                    endPicker.set("minDate", selectedDates[0]);
                }
            }
        });

        var endPicker = flatpickr("#endDate", { ...commonConfig });

        // Conditional visibility for Scheduled Start Date
        const radioButtons = document.querySelectorAll('input[name="goalStart"]');
        const startContainer = document.getElementById('startDateContainer');

        radioButtons.forEach(radio => {
            radio.addEventListener('change', (e) => {
                if (e.target.value === "1") { // Scheduled
                    startContainer.classList.remove('hidden');
                } else {
                    startContainer.classList.add('hidden');
                }
            });
        });

        // Date Validation on Submit
        document.getElementById("goalForm").addEventListener("submit", function (e) {
            var startInput = document.getElementById("startDate");
            var endInput = document.getElementById("endDate");
            var startDate = startInput.value ? new Date(startInput.value) : null;
            var endDate = endInput.value ? new Date(endInput.value) : null;
            var errorSpan = document.getElementById("goalDueDateError");

            // Only validate if Start Date container is visible (Scheduled mode)
            if (!startContainer.classList.contains('hidden') && startDate && endDate && endDate <= startDate) {
                e.preventDefault();
                errorSpan.textContent = "End date must be after start date.";
                errorSpan.classList.remove("hidden");
                endInput.classList.add("border-red-500");
            } else {
                errorSpan.classList.add("hidden");
                endInput.classList.remove("border-red-500");
            }
        });
    });
</script>