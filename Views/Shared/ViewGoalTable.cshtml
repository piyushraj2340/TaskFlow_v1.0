@model IEnumerable<TaskMonitoringApp.Models.ViewModel.GoalViewModel>

@foreach (var goal in Model)
{
    <tr class="border-b border-gray-200">
        <td class="p-2">@goal.Name</td>
        <td class="p-2">@goal.EndDate</td>
        <td class="p-2 text-yellow-500">@goal.GoalStatus</td>
        <td class="p-2">
            <button id="openModalButtonForEdit" class="m-1 rounded bg-yellow-500 px-3 py-1 text-sm text-white hover:bg-yellow-600">
                <i class="fas fa-edit"></i> Edit
            </button>
            <button class="m-1 rounded bg-green-500 px-3 py-1 text-sm text-white hover:bg-green-600">
                <i class="fas fa-check"></i> Mark as Complete
            </button>
            <button class="m-1 rounded bg-red-500 px-3 py-1 text-sm text-white hover:bg-red-600">
                <i class="fas fa-trash"></i> Delete
            </button>
        </td>
    </tr>
}
