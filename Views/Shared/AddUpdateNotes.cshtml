<div id="noteModal" class="fixed inset-0 z-20 flex hidden w-full items-center justify-center bg-gray-800 bg-opacity-50">
    <div class="custom-scrollbar relative max-h-[90vh] w-full max-w-xl overflow-auto rounded-lg bg-white shadow-xl sm:w-4/5 lg:w-1/2 xl:w-1/3">

        <div class="flex items-center justify-between bg-indigo-600 px-6 py-4 text-white">
            <h2 id="note-title" class="text-xl font-semibold tracking-wide">
                <i class="fa-solid fa-clipboard-list"></i> Create a Progress Record in Goal
            </h2>
            <button class="text-2xl text-white hover:text-gray-200" id="closeModal">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Card Body -->
        <div class="p-6">
            <p class="mb-4 text-sm text-gray-600">Add Goal Progress with Goal Title</p>

            <form asp-action="Create" asp-controller="Notes" data-action-note-form="create" data-noteId="" method="post" enctype="multipart/form-data" id="noteForm">
                @Html.AntiForgeryToken()

                <!-- Id -->
                <div class="mb-4" id="note-id-field">
                    <label for="title" class="mb-1 block font-semibold text-gray-700">
                        Note Id
                    </label>
                    <input id="noteid" name="id" class="w-full rounded-md border border-gray-300 p-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Enter note id" required readonly>
                    <span data-validation-for="id" class="text-sm text-red-500"></span>
                </div>

                <!-- Title -->
                <div class="mb-4">
                    <label for="title" class="mb-1 block font-semibold text-gray-700">
                        Title
                    </label>
                    <input id="title" name="title" class="w-full rounded-md border border-gray-300 p-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Enter note title" required>
                    <span data-validation-for="title" class="text-sm text-red-500"></span>
                </div>

                <!-- Content -->
                <div class="mb-4">
                    <label for="content" class="mb-1 block font-semibold text-gray-700">
                        Content
                    </label>
                    <textarea id="content" name="content" rows="4" class="w-full rounded-md border border-gray-300 p-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Enter progress details"></textarea>
                    <span data-validation-for="content" class="text-sm text-red-500"></span>
                </div>

                <!-- Tags -->
                <div class="mb-4">
                    <label for="tags" class="mb-1 block font-semibold text-gray-700">
                        Tags (Comma separated)
                    </label>
                    <input type="text" id="tags" name="tags" class="w-full rounded-md border border-gray-300 p-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g., work, meeting">
                </div>

                <!-- Pin Note -->
                <div class="mb-4 flex items-center">
                    <input id="IsPinned" name="IsPinned" type="checkbox" class="mr-2">
                    <label for="IsPinned" class="font-semibold text-gray-700">
                        <i class="fa-solid fa-thumbtack"></i> Pin this note
                    </label>
                </div>

                <!-- File Upload -->
                <div class="mb-4">
                    <label class="mb-1 block font-semibold text-gray-700">
                        <i class="fa-solid fa-paperclip"></i> Attachments
                    </label>
                    <div class="flex items-center">
                        <label class="flex cursor-pointer items-center space-x-2 rounded-md bg-indigo-600 px-4 py-2 text-white transition hover:bg-indigo-700">
                            <i class="fa-solid fa-upload"></i>
                            <span>Upload File</span>
                            <input type="file" id="attachments" name="attachments" class="hidden">
                        </label>
                        <span id="fileName" class="ml-3 text-sm text-gray-600"></span>
                    </div>
                </div>

                <!-- Color & Theme Selection -->
                <div class="mb-4">
                    <label class="mb-1 block font-semibold text-gray-700">
                        <i class="fa-solid fa-palette"></i> Choose Color
                    </label>
                    <p class="mb-2 text-sm text-gray-500">Select the theme color below:</p>

                    <div class="flex items-center space-x-3">
                        <div class="flex space-x-4">
                            <!-- Theme 1 -->
                            <label class="cursor-pointer">
                                <input type="radio" name="theme" value="theme-red" class="peer hidden" checked />
                                <div class="h-10 w-10 rounded-full border-4 border-transparent bg-red-500 peer-checked:border-gray-800"></div>
                            </label>

                            <!-- Theme 2 -->
                            <label class="cursor-pointer">
                                <input type="radio" name="theme" value="theme-blue" class="peer hidden" />
                                <div class="h-10 w-10 rounded-full border-4 border-transparent bg-blue-500 peer-checked:border-gray-800"></div>
                            </label>

                            <!-- Theme 3 -->
                            <label class="cursor-pointer">
                                <input type="radio" name="theme" value="theme-green" class="peer hidden" />
                                <div class="h-10 w-10 rounded-full border-4 border-transparent bg-green-500 peer-checked:border-gray-800"></div>
                            </label>
                        </div>

                        <button type="button" class="ml-3 text-xl text-indigo-600 hover:text-indigo-800">
                            <i class="fa-solid fa-plus-circle"></i>
                        </button>
                    </div>
                </div>
                <!-- Card Footer -->
                <div class="flex justify-end rounded-b-lg border-t p-4">
                    <button type="submit" id="saveNotesBtn" class="flex items-center space-x-2 rounded-md bg-indigo-600 px-6 py-2 text-white transition hover:bg-indigo-700">
                        <i class="fa-solid fa-save"></i>
                        <span>Save Note</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
      tinymce.init({
        selector: 'textarea[name="content"]',
        menubar: false,
        height: 800,
        plugins: 'link lists code codesample media image table autoresize',
        toolbar: [
          'undo redo | blocks | bold italic underline | blockquote codesample code',
          '| alignleft aligncenter alignright | bullist numlist',
          '| link image media | table | removeformat'
        ].join(' '),

        // ——— Content style (optional, for nicer in-editor look) ———
        content_style: `
              body { font-family: "Segoe UI", sans-serif; font-size:14px; line-height:1.6; color:#333; }
              h1,h2,h3,h4,h5,h6 { font-weight:600; margin:1em 0 0.5em; }
              blockquote { border-left:3px solid #ccc; padding-left:10px; color:#666; font-style:italic; }
              pre, code { background:#f4f4f4; border-radius:4px; padding:4px 6px; font-family:"Fira Code", monospace; }
              pre { padding:10px; overflow:auto; }
              table { border-collapse: collapse; width:100%; margin:1em 0; }
              table, th, td { border:1px solid #ddd; }
              th, td { padding:8px; text-align:left; }
              a { color:#2563eb; text-decoration:underline; }
              img { max-width:100%; height:auto; border-radius:6px; }
            `,

        // ——— Image & file uploads ———
        automatic_uploads: true,
        images_upload_url: '/uploads/image',        // Controller action (see below)
        file_picker_types: 'image file media',

          codesample_global_prismjs: true, // let TinyMCE know we're using Prism
              codesample_languages: [
                  { text: 'C', value: 'c' },
                  { text: 'C++', value: 'cpp' },
                  { text: 'C#', value: 'csharp' },
                  { text: 'Java', value: 'java' },
                  { text: 'JavaScript', value: 'javascript' },
                  { text: 'TypeScript', value: 'typescript' },
                  { text: 'HTML/XML', value: 'markup' },
                  { text: 'CSS', value: 'css' },
                  { text: 'JSON', value: 'json' },
                  { text: 'Python', value: 'python' },
                  { text: 'PHP', value: 'php' },
                  { text: 'Ruby', value: 'ruby' },
                  { text: 'Go', value: 'go' },
                  { text: 'Rust', value: 'rust' },
                  { text: 'Kotlin', value: 'kotlin' },
                  { text: 'Swift', value: 'swift' },
                  { text: 'Objective-C', value: 'objectivec' },
                  { text: 'SQL', value: 'sql' },
                  { text: 'Shell/Bash', value: 'bash' },
                  { text: 'Powershell', value: 'powershell' },
                  { text: 'Perl', value: 'perl' },
                  { text: 'R', value: 'r' },
                  { text: 'MATLAB', value: 'matlab' },
                  { text: 'Scala', value: 'scala' },
                  { text: 'Dart', value: 'dart' },
                  { text: 'Elixir', value: 'elixir' },
                  { text: 'Haskell', value: 'haskell' },
                  { text: 'Lua', value: 'lua' },
                  { text: 'YAML', value: 'yaml' },
                  { text: 'Markdown', value: 'markdown' }
                ],


        // Allow choosing local files for images/files/media
        file_picker_callback: function (cb, value, meta) {
          const input = document.createElement('input');
          input.setAttribute('type', 'file');

          if (meta.filetype === 'image') {
            input.setAttribute('accept', 'image/*');
          }
          // For generic files or media, accept anything (you’ll validate on server)
          input.onchange = function () {
            const file = this.files[0];
            const formData = new FormData();
            formData.append('file', file);

            const targetUrl =
              meta.filetype === 'image' ? '/uploads/image' :
              meta.filetype === 'media' ? '/uploads/media' :
              '/uploads/file';

            fetch(targetUrl, {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest' }, // optional
              body: formData
            })
            .then(res => res.ok ? res.json() : Promise.reject(res))
            .then(json => {
              // TinyMCE expects cb(url, {text/alt})
              cb(json.location, { text: file.name, title: file.name, alt: file.name });
            })
            .catch(() => alert('Upload failed. Please try again.'));
          };
          input.click();
        },

        // ——— URL handling ———
        convert_urls: false,   // Keep absolute URLs from your API as-is

        // ——— Media embedding (YouTube, etc.) ———
        // Users can paste YT links in the Media dialog; TinyMCE wraps as <iframe>.
        media_live_embeds: true,
      });
    });
</script>