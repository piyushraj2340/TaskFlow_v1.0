<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Task Monitoring App</title>

    <!-- Tailwind CSS CDN -->
    <link rel="stylesheet" href="~/css/styles.css">

    @* Page Css style  *@
    <link rel="stylesheet" href="~/css/site.css">

    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.css" />

    <!-- Render styles dynamically from view -->
    @RenderSection("Styles", required: false)
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal flex flex-col min-h-screen">
    <!-- Navigation Bar -->
    <nav class="bg-indigo-600 text-white p-4">
        <div class="container mx-auto flex items-center justify-between">
            <div class="text-xl font-bold">
                <a href="/">TaskMonitorApp</a>
            </div>

            <div class="hidden lg:block flex-grow max-w-xl mx-4 relative">
                <form action="/Search/Query" method="get" class="relative">
                    <div class="flex items-center bg-indigo-500 rounded-full shadow-inner
                    group transition-colors duration-200 hover:bg-indigo-700">

                        <div class="relative">
                            <button type="button" id="desktopFilterBtn" class="flex items-center space-x-2 pl-4 pr-2 py-2 text-sm font-semibold rounded-l-full focus:outline-none">
                                <span id="desktopFilterLabel">All</span>
                                <i class="fas fa-chevron-down text-xs"></i>
                            </button>
                            <div id="desktopFilterMenu" class="absolute left-0 mt-2 w-48 bg-white text-gray-800 rounded-md shadow-lg z-20 hidden">
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="All">All</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Goal">Goal</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Task">Task</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Todo">Todo</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Notes">Notes/Journal</a>
                            </div>
                        </div>
                        <input type="hidden" name="filter" id="desktopFilterInput" value="All">
                        <input type="search" name="query" class="w-full bg-transparent pl-2 pr-10 py-2 text-white placeholder-indigo-200 focus:outline-none" placeholder="Search...">
                        <button type="submit" class="absolute right-0 top-0 mt-2 mr-3 text-indigo-200 hover:text-white">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
                <div id="globalSearchResults" class="absolute left-0 top-[56px] z-50 mx-auto max-w-xl bg-white shadow-lg rounded-b-lg border border-indigo-200 hidden">
                    <!-- Results will be injected here -->
                </div>
            </div>

            <div class="block lg:hidden">
                <button id="hamburgerBtn" class="text-white focus:outline-none">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
            </div>

            <div class="hidden lg:flex items-center space-x-4">
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.ActionLink("Index", "Notes")" class="rounded px-3 py-2 hover:bg-indigo-500 timeline">Timeline</a>
                    <a href="@Url.ActionLink("Index", "Todo")" class="rounded px-3 py-2 hover:bg-indigo-500 todo">Todo</a>
                    <a href="@Url.ActionLink("Index", "Tasks")" class="rounded px-3 py-2 hover:bg-indigo-500 task">Tasks</a>
                    <a href="@Url.ActionLink("Index", "Goals")" class="rounded px-3 py-2 hover:bg-indigo-500 goal">Goals</a>
                    <div class="group relative">
                        <button class="flex items-center space-x-2 rounded px-3 py-2 hover:bg-indigo-500">
                            <span>@User.Identity.Name</span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        <div class="absolute right-0 z-10 mt-0 hidden w-48 rounded-md bg-white shadow-lg group-hover:block">
                            <a href="@Url.ActionLink("Logout", "Account")" class="block px-4 py-2 text-gray-800 hover:bg-indigo-100">Logout</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.ActionLink("Index", "Home")" class="rounded px-4 py-2 hover:bg-indigo-500">Home</a>

                    <a href="@Url.ActionLink("AboutUs", "Home")" class="rounded px-4 py-2 hover:bg-indigo-500">About Us</a>

                    <a href="@Url.ActionLink("ContactUs", "Home")" class="rounded px-4 py-2 hover:bg-indigo-500">Contact Us</a>

                    <a href="@Url.ActionLink("Login", "Account")" class="rounded px-4 py-2 hover:bg-indigo-500">Login</a>
                }
            </div>
        </div>

        <div id="mobileMenu" class="lg:hidden hidden mt-4 relative">
            <div class="px-4 mb-4">
                <form action="/Search/Query" method="get" class="relative">
                    <div class="flex items-center bg-indigo-500 rounded-full shadow-inner
                    group transition-colors duration-200 hover:bg-indigo-700">

                        <div class="relative">
                            <button type="button" id="mobileFilterBtn" class="flex items-center space-x-2 pl-4 pr-2 py-2 text-sm font-semibold rounded-l-full focus:outline-none">
                                <span id="mobileFilterLabel">All</span>
                                <i class="fas fa-chevron-down text-xs"></i>
                            </button>
                            <div id="mobileFilterMenu" class="absolute left-0 mt-2 w-48 bg-white text-gray-800 rounded-md shadow-lg z-20 hidden">
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="All">All</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Goal">Goal</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Task">Task</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Todo">Todo</a>
                                <a href="#" class="block px-4 py-2 hover:bg-indigo-100" data-filter="Notes">Notes/Journal</a>
                            </div>
                        </div>
                        <input type="hidden" name="filter" id="mobileFilterInput" value="All">
                        <input type="search" name="query" class="w-full bg-transparent pl-2 pr-10 py-2 text-white placeholder-indigo-200 focus:outline-none" placeholder="Search...">
                        <button type="submit" class="absolute right-0 top-0 mt-2 mr-3 text-indigo-200 hover:text-white">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
                <div id="globalSearchResults" class="absolute left-0 top-[56px] z-50 mx-auto bg-white shadow-lg rounded-b-lg border border-indigo-200 hidden">
                    <!-- Results will be injected here -->
                </div>
            </div>

            <div class="flex flex-col space-y-2 px-4">
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.ActionLink("Index", "Notes")" class="rounded px-3 py-2 hover:bg-indigo-500 timeline">Timeline</a>
                    <a href="@Url.ActionLink("Index", "Todo")" class="rounded px-3 py-2 hover:bg-indigo-500 todo">Todo</a>
                    <a href="@Url.ActionLink("Index", "Tasks")" class="rounded px-3 py-2 hover:bg-indigo-500 task">Tasks</a>
                    <a href="@Url.ActionLink("Index", "Goals")" class="rounded px-3 py-2 hover:bg-indigo-500 goal">Goals</a>
                    <div class="border-t border-indigo-500 my-2"></div>
                    <a href="@Url.ActionLink("Logout", "Account")" class="rounded px-3 py-2 hover:bg-indigo-500">Logout</a>

                }
                else
                {
                    <a href="@Url.ActionLink("Index", "Home")" class="rounded px-4 py-2 hover:bg-indigo-500">Home</a>

                    <a href="@Url.ActionLink("AboutUs", "Home")" class="rounded px-4 py-2 hover:bg-indigo-500">About Us</a>

                    <a href="@Url.ActionLink("ContactUs", "Home")" class="rounded px-4 py-2 hover:bg-indigo-500">Contact Us</a>

                    <a href="@Url.ActionLink("Login", "Account")" class="rounded px-4 py-2 hover:bg-indigo-500">Login</a>
                }
            </div>
        </div>
    </nav>

    <div class="container mx-auto">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-indigo-600 py-6 text-white mt-auto">
        <div class="container mx-auto text-center">
            <p>&copy; 2024 TaskMonitorApp. All rights reserved.</p>
            <div class="mt-2">
                <a href="#" class="mx-2 text-white hover:text-gray-300">Privacy Policy</a>
                <a href="#" class="mx-2 text-white hover:text-gray-300">Terms of Service</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.tailwindcss.com?plugins=line-clamp"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
