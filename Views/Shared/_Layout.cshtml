<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskMonitorApp</title>


    <!-- Original Page CSS -->
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <!-- Font Awesome & Awesomplete -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        /* Custom scrollbar for a cleaner sidebar look */
        .sidebar-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
        }

            .sidebar-scroll::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.3);
            }

        /* Smooth width transition for sidebar */
        .transition-width {
            transition-property: width;
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            transition-duration: 300ms;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 h-screen overflow-hidden flex">

    <!-- Mobile Overlay Backdrop -->
    <div id="mobile-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black bg-opacity-50 z-20 hidden lg:hidden transition-opacity duration-300"></div>

    <!-- LEFT SIDEBAR NAVIGATION -->
    <aside id="sidebar" class="bg-indigo-800 text-white w-64 lg:w-64 flex-shrink-0 fixed inset-y-0 left-0 transform -translate-x-full lg:relative lg:translate-x-0 transition-all duration-300 ease-in-out z-30 flex flex-col shadow-xl border-r border-indigo-700">

        <!-- Logo Area -->
        <div class="h-16 flex items-center justify-between px-4 border-b border-indigo-700 bg-indigo-900">
            <a href="/" class="text-xl font-bold tracking-wider flex items-center space-x-2 text-white overflow-hidden whitespace-nowrap">
                <i class="fas fa-check-double text-indigo-400 text-lg min-w-[24px] text-center"></i>
                <span class="sidebar-text transition-opacity duration-200">TaskMonitor</span>
            </a>
            <!-- Desktop Collapse Button -->
            <button onclick="toggleDesktopSidebar()" class="hidden lg:block text-indigo-400 hover:text-white focus:outline-none p-1 rounded-md hover:bg-indigo-800 transition-colors">
                <i id="collapseIcon" class="fas fa-chevron-left text-sm"></i>
            </button>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 overflow-y-auto sidebar-scroll py-4">
            <div class="px-3 space-y-1">
                @if (User.Identity.IsAuthenticated)
                {
                    <p class="sidebar-text px-3 text-xs font-semibold text-indigo-300 uppercase tracking-wider mb-2 mt-2 overflow-hidden whitespace-nowrap">Main</p>

                    <a href="@Url.ActionLink("Index", "Home")" title="Dashboard" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-indigo-600 hover:text-white transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "bg-indigo-700 text-white" : "text-indigo-100")">
                        <i class="fas fa-th-large w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Dashboard</span>
                    </a>

                    <a href="@Url.ActionLink("Index", "Collections")" title="Collections" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-indigo-600 hover:text-white transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Collections" ? "bg-indigo-700 text-white" : "text-indigo-100")">
                        <i class="fas fa-layer-group w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Collections</span>
                    </a>

                    <a href="@Url.ActionLink("Index", "Notes")" title="Timeline" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-indigo-600 hover:text-white transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Notes" ? "bg-indigo-700 text-white" : "text-indigo-100")">
                        <i class="fas fa-stream w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Timeline</span>
                    </a>

                    <p class="sidebar-text px-3 text-xs font-semibold text-indigo-300 uppercase tracking-wider mb-2 mt-6 overflow-hidden whitespace-nowrap">Workspace</p>

                    <a href="@Url.ActionLink("Index", "Todo")" title="Todo" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-indigo-600 hover:text-white transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Todo" ? "bg-indigo-700 text-white" : "text-indigo-100")">
                        <i class="fas fa-check-circle w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Todo</span>
                    </a>

                    <a href="@Url.ActionLink("Index", "Tasks")" title="Tasks" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-indigo-600 hover:text-white transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tasks" ? "bg-indigo-700 text-white" : "text-indigo-100")">
                        <i class="fas fa-tasks w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Tasks</span>
                    </a>

                    <a href="@Url.ActionLink("Index", "Goals")" title="Goals" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-indigo-600 hover:text-white transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Goals" ? "bg-indigo-700 text-white" : "text-indigo-100")">
                        <i class="fas fa-bullseye w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Goals</span>
                    </a>
                }
                else
                {
                    <!-- Guest Links -->
                    <a href="@Url.ActionLink("Login", "Account")" title="Login" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md text-indigo-100 hover:bg-indigo-600 hover:text-white transition-colors">
                        <i class="fas fa-sign-in-alt w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Login</span>
                    </a>
                    <a href="@Url.ActionLink("Register", "Account")" title="Register" class="nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-md text-indigo-100 hover:bg-indigo-600 hover:text-white transition-colors">
                        <i class="fas fa-user-plus w-6 text-center text-lg"></i>
                        <span class="sidebar-text ml-3 whitespace-nowrap">Register</span>
                    </a>
                }
            </div>
        </nav>

        <!-- Sidebar Footer (Logout) -->
        @if (User.Identity.IsAuthenticated)
        {
            <div class="p-4 border-t border-indigo-700 bg-indigo-900">
                <a href="@Url.ActionLink("Logout", "Account")" title="Logout" class="nav-link flex items-center w-full px-2 py-2 text-sm font-medium text-indigo-200 hover:text-white hover:bg-indigo-700 rounded-md transition-colors">
                    <i class="fas fa-sign-out-alt w-6 text-center text-lg"></i>
                    <span class="sidebar-text ml-3 whitespace-nowrap">Logout</span>
                </a>
            </div>
        }
    </aside>

    <!-- MAIN CONTENT WRAPPER -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-gray-50">

        <!-- TOP HEADER -->
        <header class="bg-white shadow-sm h-16 flex items-center justify-between px-4 lg:px-8 z-10 relative">

            <!-- Left Side: Hamburger & Search -->
            <div class="flex items-center flex-1">
                <!-- Mobile Toggle Button -->
                <button onclick="toggleSidebar()" class="text-gray-500 hover:text-indigo-600 focus:outline-none lg:hidden mr-2 sm:mr-4">
                    <i class="fas fa-bars text-xl"></i>
                </button>

                @if (User.Identity.IsAuthenticated)
                {
                    <!-- Search Bar -->
                    <div class="w-full max-w-xl mr-2 sm:mr-0">
                        <form action="/Search/Query" method="get" class="relative w-full">
                            <!-- 'overflow-visible' allows the dropdown to spill out -->
                            <div class="flex items-center bg-gray-100 rounded-full border border-transparent focus-within:border-indigo-500 focus-within:bg-white focus-within:ring-2 focus-within:ring-indigo-200 transition-all overflow-visible relative">

                                <!-- Filter Dropdown Container -->
                                <div class="relative">
                                    <button type="button" id="desktopFilterBtn" class="flex items-center space-x-1 sm:space-x-2 pl-3 sm:pl-4 pr-2 py-2 text-sm font-medium text-gray-600 border-r border-gray-300 focus:outline-none hover:text-indigo-600 cursor-pointer h-full">
                                        <span id="desktopFilterLabel" class="truncate max-w-[50px] sm:max-w-none">All</span>
                                        <i class="fas fa-chevron-down text-xs ml-1"></i>
                                    </button>

                                    <!-- Filter Menu -->
                                    <div id="desktopFilterMenu" class="absolute left-0 top-full mt-2 w-40 bg-white rounded-md shadow-xl border border-gray-200 py-1 hidden z-50">
                                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" data-filter="All">All</a>
                                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" data-filter="Goal">Goal</a>
                                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" data-filter="Task">Task</a>
                                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" data-filter="Todo">Todo</a>
                                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" data-filter="Notes">Notes</a>
                                    </div>
                                </div>

                                <input type="hidden" name="filter" id="desktopFilterInput" value="All">
                                <input type="search" name="query" class="w-full bg-transparent border-none pl-3 pr-8 sm:pr-10 py-2 text-sm text-gray-700 focus:ring-0 focus:outline-none placeholder-gray-400" placeholder="Search...">

                                <button type="submit" class="absolute right-0 mr-3 text-gray-400 hover:text-indigo-600">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </form>
                        <div id="globalSearchResults" class="absolute left-0 top-14 z-50 mx-auto w-full max-w-xl bg-white shadow-xl rounded-md border border-indigo-100 hidden"></div>
                    </div>
                }
            </div>

            <!-- Right Side: User Profile -->
            <div class="flex items-center space-x-4 flex-shrink-0">
                @if (User.Identity.IsAuthenticated)
                {
                    <!-- Add New Button -->
                    <a href="@Url.ActionLink("Index", "Tasks")" class="hidden md:flex items-center space-x-1 bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded-md text-sm font-medium transition-colors shadow-sm">
                        <i class="fas fa-plus"></i>
                        <span>New Task</span>
                    </a>

                    <!-- User Menu -->
                    <div class="relative">
                        <!-- Removed inline onclick, added ID for cleaner JS -->
                        <button id="userMenuBtn" class="flex items-center space-x-2 focus:outline-none hover:bg-gray-50 rounded-full p-1 pr-2 sm:pr-3 transition-colors">
                            <div class="h-8 w-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-sm border border-indigo-200">
                                @(User.Identity.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <span class="hidden lg:block text-sm font-medium text-gray-700">@User.Identity.Name</span>
                            <i class="fas fa-chevron-down text-xs text-gray-400 hidden lg:block"></i>
                        </button>

                        <div id="user-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 border border-gray-100 hidden transform origin-top-right z-50">
                            <div class="px-4 py-2 border-b border-gray-50">
                                <p class="text-sm font-semibold text-gray-800">@User.Identity.Name</p>
                            </div>
                            <a href="@Url.ActionLink("Index", "Tasks")" class="block md:hidden px-4 py-2 text-sm text-indigo-600 font-medium hover:bg-indigo-50">
                                <i class="fas fa-plus mr-2"></i> New Task
                            </a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50">Profile</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50">Settings</a>
                            <div class="border-t border-gray-50 my-1"></div>
                            <a href="@Url.ActionLink("Logout", "Account")" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">Logout</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.ActionLink("Login", "Account")" class="text-sm font-medium text-indigo-600 hover:text-indigo-800">Login</a>
                }
            </div>
        </header>

        <!-- Main Content Area -->
        <main id="main" role="main" class="flex-1 overflow-y-auto focus:outline-none p-4 md:p-6 lg:p-8">
            <div class="mx-auto">
                @RenderBody()
            </div>

            <footer class="mt-8 pt-6 border-t border-gray-200 text-center text-sm text-gray-400">
                <p>&copy; @DateTime.Now.Year - TaskMonitorApp. All rights reserved.</p>
            </footer>
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/awesomplete/1.1.5/awesomplete.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>

    <script>
        // Use DOMContentLoaded to ensure elements exist and scripts are ready
        document.addEventListener('DOMContentLoaded', function() {

            // --- UI Elements ---
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');

            const filterBtn = document.getElementById('desktopFilterBtn');
            const filterMenu = document.getElementById('desktopFilterMenu');
            const filterLabel = document.getElementById('desktopFilterLabel');
            const filterInput = document.getElementById('desktopFilterInput');
            const filterOptions = document.querySelectorAll('[data-filter]');

            const userBtn = document.getElementById('userMenuBtn');
            const userMenu = document.getElementById('user-menu');

            // --- Sidebar Logic ---
            window.toggleSidebar = function() { // Global for overlay onclick attribute
                if (sidebar.classList.contains('-translate-x-full')) {
                    sidebar.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden');
                } else {
                    sidebar.classList.add('-translate-x-full');
                    overlay.classList.add('hidden');
                }
            };

            window.toggleDesktopSidebar = function() { // Global for collapse button
                const sidebarTexts = document.querySelectorAll('.sidebar-text');
                const navLinks = document.querySelectorAll('.nav-link');
                const icon = document.getElementById('collapseIcon');

                if (sidebar.classList.contains('lg:w-64')) {
                    // Collapse
                    sidebar.classList.remove('lg:w-64');
                    sidebar.classList.add('lg:w-20');
                    sidebarTexts.forEach(el => el.classList.add('hidden'));
                    navLinks.forEach(el => {
                        el.classList.remove('px-3');
                        el.classList.add('justify-center', 'px-0');
                    });
                    if(icon) { icon.classList.remove('fa-chevron-left'); icon.classList.add('fa-chevron-right'); }
                } else {
                    // Expand
                    sidebar.classList.remove('lg:w-20');
                    sidebar.classList.add('lg:w-64');
                    sidebarTexts.forEach(el => el.classList.remove('hidden'));
                    navLinks.forEach(el => {
                        el.classList.add('px-3');
                        el.classList.remove('justify-center', 'px-0');
                    });
                    if(icon) { icon.classList.remove('fa-chevron-right'); icon.classList.add('fa-chevron-left'); }
                }
            };

            // --- Filter Menu Logic ---
            if (filterBtn && filterMenu) {
                // filterBtn.addEventListener('click', function(e) {
                //     e.preventDefault();
                //     e.stopPropagation();
                //     filterMenu.classList.toggle('hidden');
                // });

                filterOptions.forEach(option => {
                    option.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const value = this.getAttribute('data-filter');
                        if (filterLabel) filterLabel.textContent = value;
                        if (filterInput) filterInput.value = value;
                        filterMenu.classList.add('hidden');
                    });
                });
            }

            // --- User Menu Logic ---
            if (userBtn && userMenu) {
                userBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    userMenu.classList.toggle('hidden');
                });
            }

            // --- Global Click Listener (Closes Menus) ---
            document.addEventListener('click', function(e) {
                // Close Filter Menu
                if (filterMenu && !filterMenu.classList.contains('hidden')) {
                    if (!filterBtn.contains(e.target) && !filterMenu.contains(e.target)) {
                        filterMenu.classList.add('hidden');
                    }
                }
                // Close User Menu
                if (userMenu && !userMenu.classList.contains('hidden')) {
                    if (!userBtn.contains(e.target) && !userMenu.contains(e.target)) {
                        userMenu.classList.add('hidden');
                    }
                }
            });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>