@model TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO

<article class="relative flex flex-col md:flex-row md:items-start md:justify-between md:gap-6">

    <div class="w-full pl-10 md:pl-0 md:w-1/2 order-2 md:order-1">
        @await Html.PartialAsync("NotesLayoutRightViewTimeLine", Model)
    </div>

    <div class="absolute left-[20px] md:static md:left-auto md:mx-0 md:order-2 flex items-start md:items-center justify-center md:w-0 h-full top-0 z-10 transform -translate-x-1/2 md:translate-x-0">
        <div class="flex items-center md:flex-col md:justify-center md:gap-2 sticky top-4 md:top-0">
            <div class="timeline-dot bg-slate-400 border-2 border-white shadow-sm h-4 w-4 rounded-full" aria-hidden></div>
            <div class="hidden md:block w-px bg-slate-200 h-12"></div>
        </div>
    </div>

    <div class="w-full pl-10 md:pl-0 md:w-1/2 order-1 md:order-3 mt-2 md:mt-0">
        @await Html.PartialAsync("TimeLineGoalOrTaskDetail", Model)
    </div>
</article>