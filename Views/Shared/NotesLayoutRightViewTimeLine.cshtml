@model TaskMonitoringApp.Models.DTOs.NoteDTOWithGoalAndTaskDTO

<div class="relative top-[-10px] md:right-[4px] mb-6">

    <div class="absolute top-4 h-0.5 w-2 bg-gray-300
                -left-[20px] md:left-auto md:-right-[20px]"></div>

    <div class="absolute top-2 flex h-5 w-5 items-center justify-center rounded-full border-4 border-white bg-blue-600
                -left-[11px] md:left-auto md:-right-[11px]"></div>

    <div class="rounded-lg bg-blue-100 p-4 shadow">
        <h3 class="flex items-center font-semibold text-blue-700">
            @Model.Title
        </h3>

        <div class="content-preview-wrapper relative mt-2 max-h-[120px] overflow-hidden transition-[max-height] duration-500 ease-in-out">
            <div class="richtext w-full">
                @Html.Raw(Model.Content)
            </div>
            <div class="gradient-overlay absolute bottom-0 h-12 w-full bg-gradient-to-t from-blue-100 to-transparent"></div>
        </div>

        <button class="show-more-trigger mt-2 text-sm font-semibold text-blue-600 hover:underline">
            Show more
        </button>

        <div class="relative mb-4 mt-4 border-t border-blue-200">
            <div class="flex pt-2 text-sm text-gray-500">
                <i class="fas fa-link mr-2"></i> Attached Files
            </div>
        </div>

        @if (!Model.IsModified)
        {
            <div class="mt-2 text-xs text-gray-600">
                <i class="fas fa-calendar-alt mr-2 text-sm"></i>@Model.TimeStamp?.ToShortTimeString() | <span class="text-green-700">Published</span>
            </div>
        }
        else
        {
            <div class="mt-2 text-xs text-gray-600">
                <i class="fas fa-calendar-alt mr-2 text-sm"></i>@Model.ModifiedOn?.ToString("hh:mm:ss, MMMM dd, yy") | <span class="text-rose-700">Modified</span>
            </div>
        }

        <div class="mt-3 flex items-center justify-between">
            <div class="flex space-x-2">
                <button class="edit-notes text-gray-700 hover:text-blue-500" data-noteeditid="@Model.Id"><i class="fas fa-edit"></i> Edit</button>
                <button class="delete-notes text-gray-700 hover:text-red-500" data-noteeditid="@Model.Id"><i class="fas fa-trash"></i> Delete</button>
            </div>
            @if (Model.IsPinned)
            {
                <button class="text-yellow-600"><i class="fas fa-thumbtack"></i></button>
            }
        </div>
    </div>
</div>