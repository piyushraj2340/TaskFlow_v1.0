@model TaskMonitoringApp.Models.ViewModel.TaskViewModel
@using TaskMonitoringApp.Models.Entities

@{
    var errorMessages = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
}

@await Html.PartialAsync("_ModelStateValidations", errorMessages)

<form method="POST" asp-action="@(ViewBag.IsEditMode?"Edit":"Create")" class="space-y-4">

    @if (ViewBag.IsEditMode)
    {
        <div>
            <label asp-for="Id" class="block text-sm font-medium text-gray-600"></label>
            <input asp-for="Id" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" readonly />
        </div>
    }

    <!-- Task Title Input -->
    <div>
        <label asp-for="Name" class="block text-sm font-medium text-gray-600"></label>
        <input asp-for="Name" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <span asp-validation-for="Name" class="text-sm text-red-500"></span>
    </div>

    <!-- Task With Goals -->
    <div class="relative">
        <label for="searchGoal" class="block text-sm font-medium text-gray-600">Task With Goals</label>

        <!-- Selected Goals Container -->
        <div>
            <label for="searchGoal" class="my-2 ms-1 text-sm font-normal text-gray-500">Selected Goals</label>
            <div id="selectedGoalsContainer" class="mb-4 flex flex-wrap gap-2 rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
                @if (ViewBag.IsEditMode || Model?.GoalLists?.Count() > 0)
                {
                    if (Model.GoalLists == null || Model.GoalLists?.Count() == 0)
                    {
                        <p class="text-gray-400" id="noGoalsMessage">No goals selected.</p>
                    }
                    else
                    {
                        foreach (var goal in Model.GoalLists)
                        {
                            <div class="flex items-center space-x-2 rounded-full bg-indigo-600 px-3 py-1 text-white">
                                <span>
                                    @goal.Name
                                </span>
                                <button type="button" class="rounded-full text-white hover:bg-indigo-800 focus:outline-none"
                                        onclick="removeGoal(@goal.Id)">
                                    &times;
                                </button>
                            </div>
                        }
                    }
                }
                else
                {
                    <p class="text-gray-400" id="noGoalsMessage">No goals selected.</p>
                }
            </div>
            <input type="text" asp-for="GoalIds" hidden />
        </div>

        <!-- Search Input -->
        <div class="mb-4">
            <input id="searchGoal"
                   type="text"
                   placeholder="Search for goals..."
                   class="w-full rounded-md border border-gray-300 p-3 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <!-- Filtered Goals List (Initially hidden) -->
        <ul id="filteredGoalsList" class="custom-scrollbar absolute hidden max-h-60 w-full divide-y divide-gray-200 overflow-y-auto rounded bg-white shadow-md z-50">
            <!-- Dynamically populated list items -->
        </ul>
    </div>

    <!-- Task Description Input -->
    <div>
        <label asp-for="Description" class="block text-sm font-medium text-gray-600"></label>
        <textarea asp-for="Description" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
        <span asp-validation-for="Description" class="text-sm text-red-500"></span>
    </div>

    <!-- Repeat Dropdown -->
    <div>
        <label asp-for="Repeat" class="block text-sm font-medium text-gray-600"></label>
        <select asp-for="Repeat" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="0">Run Once</option>
            <option value="1">Daily</option>
            <option value="2">Weekly</option>
            <option value="3">No Repeat</option>
        </select>
        <span asp-validation-for="Repeat" class="text-sm text-red-500"></span>
    </div>

    <!-- Weekly Days Checkbox (hidden by default, shown when 'Weekly' is selected) -->
    <div id="RepeatWeekList" class="mt-4 @((ViewBag.IsEditMode && Model?.Repeat == RepeatType.Weekly) ? "" : "hidden")">
        <label asp-for="RepeatWeekList" class="block text-sm font-medium text-gray-600"></label>
        <div class="flex">

            <div class="mb-4 flex flex-wrap justify-center">

                <!-- Button for Monday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="monday" value="0" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Monday)">
                    <label for="monday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Mon</span>
                    </label>
                </div>

                <!-- Button for Tuesday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="tuesday" value="1" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Tuesday)">
                    <label for="tuesday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Tue</span>
                    </label>
                </div>

                <!-- Button for Wednesday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="wednesday" value="2" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Wednesday)">
                    <label for="wednesday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Wed</span>
                    </label>
                </div>

                <!-- Button for Thursday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="thursday" value="3" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Thursday)">
                    <label for="thursday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Thu</span>
                    </label>
                </div>

                <!-- Button for Friday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="friday" value="4" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Friday)">
                    <label for="friday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Fri</span>
                    </label>
                </div>

                <!-- Button for Saturday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="saturday" value="5" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Saturday)">
                    <label for="saturday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Sat</span>
                    </label>
                </div>

                <!-- Button for Sunday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="sunday" value="6" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Sunday)">
                    <label for="sunday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Sun</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Priority Dropdown -->
    <div>
        <label asp-for="Priority" class="block text-sm font-medium text-gray-600"></label>
        <select asp-for="Priority" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="0">Low</option>
            <option value="1">Medium</option>
            <option value="2">High</option>
        </select>
        <span asp-validation-for="Priority" class="text-sm text-red-500"></span>
    </div>

    @if (!ViewBag.IsEditMode || (ViewBag.IsEditMode && !Model?.IsStarted))
    {
        <!-- Task Start Options -->
        <div id="startOptionsModeContainer" class="mb-4">
            <label class="block text-sm font-medium text-gray-600">Task Start</label>
            <div class="mt-2 flex flex-col space-y-2 md:flex-row md:space-x-4 md:space-y-0">
                <label class="flex items-center space-x-2">
                    <input type="radio" name="StartOptionType" value="0" class="taskStartRadio text-indigo-600 focus:ring-indigo-500" checked="@(ViewBag.IsEditMode && Model?.StartOptionType == StartOptions.Manual ? "checked" : !ViewBag.IsEditMode? "checked": "")">
                    <span>Manual</span>
                </label>
                <label class="flex items-center space-x-2">
                    <input type="radio" name="StartOptionType" value="1" class="taskStartRadio text-indigo-600 focus:ring-indigo-500" checked="@(ViewBag.IsEditMode && Model?.StartOptionType == StartOptions.Scheduled)">
                    <span>Scheduled</span>
                </label>
                <label class="flex items-center space-x-2">
                    <input type="radio" name="StartOptionType" value="2" class="taskStartRadio text-indigo-600 focus:ring-indigo-500" checked="@(ViewBag.IsEditMode && Model?.StartOptionType == StartOptions.Immediate)">
                    <span>Start Immediately</span>
                </label>
            </div>
        </div>

        <!-- Scheduled Start Date Field -->
        <div id="startDateContainer" class="mb-4 @(ViewBag.IsEditMode && Model?.StartOptionType == StartOptions.Scheduled ? "" : "hidden")">
            <label asp-for="StartDate" class="block text-sm font-medium text-gray-600">Start Date</label>
            <input asp-for="StartDate" type="datetime-local" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2">
            <span asp-validation-for="StartDate" class="text-xs text-red-500" id="startDateError">Start date is required when scheduling.</span>
        </div>
    }

    <!-- Due Date Input -->
    <div>
        <label asp-for="EndDate" class="block text-sm font-medium text-gray-600"></label>
        <input asp-for="EndDate" type="datetime-local" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <span asp-validation-for="EndDate" class="text-sm text-red-500"></span>
    </div>

    <!-- Goal Status Field (only visible in Edit mode) -->
    @if (ViewBag.IsEditMode)
    {
        <div id="taskStatusContainer" class="mb-4">
            <label asp-for="TaskStatus" class="block text-sm font-medium text-gray-600"></label>
            <select asp-for="TaskStatus" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2">
                <option value="0">Not Started</option>
                <option value="1">Running</option>
                <option value="2">Completed</option>
                <option value="3">End</option>
            </select>
            <span asp-validation-for="TaskStatus" class="text-sm text-red-500"></span>
        </div>
    }

    <!-- Submit Button -->
    <div>
        <button type="submit" class="mt-4 w-full rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            @(ViewBag.IsEditMode ? "Edit Task" : "Add Task")
        </button>
    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
        document.addEventListener("DOMContentLoaded", function () {
      tinymce.init({
        selector: 'textarea[name="Description"]',
        menubar: false,
        height: 800,
        plugins: 'link lists code codesample media image table autoresize',
        toolbar: [
          'undo redo | blocks fontfamily fontsize | bold italic underline forecolor backcolor | blockquote codesample code',
          '| alignleft aligncenter alignright | bullist numlist',
          '| link image media | table | removeformat'
        ].join(' '),

        // ——— Font family & size options ———
        font_family_formats: `
          Arial=arial,helvetica,sans-serif;
          Courier New=courier new,courier,monospace;
          Georgia=georgia,palatino;
          Times New Roman=times new roman,times;
          Tahoma=tahoma,arial,helvetica,sans-serif;
          Verdana=verdana,geneva;
          Roboto=roboto,sans-serif
        `,
        fontsize_formats: '10px 12px 14px 16px 18px 24px 36px 48px',

        // ——— Content style (optional, for nicer in-editor look) ———
        content_style: `
              body { font-family: "Segoe UI", sans-serif; font-size:14px; line-height:1.6; color:#333; }
              h1,h2,h3,h4,h5,h6 { font-weight:600; margin:1em 0 0.5em; }
              blockquote { border-left:3px solid #ccc; padding-left:10px; color:#666; font-style:italic; }
              pre, code { background:#f4f4f4; border-radius:4px; padding:4px 6px; font-family:"Fira Code", monospace; }
              pre { padding:10px; overflow:auto; }
              table { border-collapse: collapse; width:100%; margin:1em 0; }
              table, th, td { border:1px solid #ddd; }
              th, td { padding:8px; text-align:left; }
              a { color:#2563eb; text-decoration:underline; }
              img { max-width:100%; height:auto; border-radius:6px; }
            `,

        // ——— Image & file uploads ———
        automatic_uploads: true,
        images_upload_url: '/uploads/image',
        file_picker_types: 'image file media',

        codesample_global_prismjs: true,
        codesample_languages: [
          { text: 'C', value: 'c' },
          { text: 'C++', value: 'cpp' },
          { text: 'C#', value: 'csharp' },
          { text: 'Java', value: 'java' },
          { text: 'JavaScript', value: 'javascript' },
          { text: 'TypeScript', value: 'typescript' },
          { text: 'HTML/XML', value: 'markup' },
          { text: 'CSS', value: 'css' },
          { text: 'JSON', value: 'json' },
          { text: 'Python', value: 'python' },
          { text: 'PHP', value: 'php' },
          { text: 'Ruby', value: 'ruby' },
          { text: 'Go', value: 'go' },
          { text: 'Rust', value: 'rust' },
          { text: 'Kotlin', value: 'kotlin' },
          { text: 'Swift', value: 'swift' },
          { text: 'Objective-C', value: 'objectivec' },
          { text: 'SQL', value: 'sql' },
          { text: 'Shell/Bash', value: 'bash' },
          { text: 'Powershell', value: 'powershell' },
          { text: 'Perl', value: 'perl' },
          { text: 'R', value: 'r' },
          { text: 'MATLAB', value: 'matlab' },
          { text: 'Scala', value: 'scala' },
          { text: 'Dart', value: 'dart' },
          { text: 'Elixir', value: 'elixir' },
          { text: 'Haskell', value: 'haskell' },
          { text: 'Lua', value: 'lua' },
          { text: 'YAML', value: 'yaml' },
          { text: 'Markdown', value: 'markdown' }
        ],

        // ——— File picker callback ———
        file_picker_callback: function (cb, value, meta) {
          const input = document.createElement('input');
          input.setAttribute('type', 'file');

          if (meta.filetype === 'image') {
            input.setAttribute('accept', 'image/*');
          }

          input.onchange = function () {
            const file = this.files[0];
            const formData = new FormData();
            formData.append('file', file);

            const targetUrl =
              meta.filetype === 'image' ? '/uploads/image' :
              meta.filetype === 'media' ? '/uploads/media' :
              '/uploads/file';

            fetch(targetUrl, {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
              body: formData
            })
            .then(res => res.ok ? res.json() : Promise.reject(res))
            .then(json => {
              cb(json.location, { text: file.name, title: file.name, alt: file.name });
            })
            .catch(() => alert('Upload failed. Please try again.'));
          };
          input.click();
        },

        // ——— URL handling ———
        convert_urls: false,

        // ——— Media embedding (YouTube, etc.) ———
        media_live_embeds: true,
      });
    });

</script>