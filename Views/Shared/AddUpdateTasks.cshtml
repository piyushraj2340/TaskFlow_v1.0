@model TaskMonitoringApp.Models.ViewModel.TaskViewModel
@using TaskMonitoringApp.Models.Entities

@{
    var errorMessages = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
}

@await Html.PartialAsync("_ModelStateValidations", errorMessages)

<form method="POST" asp-action="@(ViewBag.IsEditMode?"Edit":"Create")" class="space-y-4">

    @if (ViewBag.IsEditMode)
    {
        <div>
            <label asp-for="Id" class="block text-sm font-medium text-gray-600"></label>
            <input asp-for="Id" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" readonly />
        </div>
    }

    <!-- Task Title Input -->
    <div>
        <label asp-for="Name" class="block text-sm font-medium text-gray-600"></label>
        <input asp-for="Name" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
        <span asp-validation-for="Name" class="text-sm text-red-500"></span>
    </div>

    <!-- Task With Goals -->
    <div class="relative">
        <label for="searchGoal" class="block text-sm font-medium text-gray-600">Task With Goals</label>

        <!-- Selected Goals Container -->
        <div>
            <label for="searchGoal" class="my-2 ms-1 text-sm font-normal text-gray-500">Selected Goals</label>
            <div id="selectedGoalsContainer" class="mb-4 flex flex-wrap gap-2 rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
                @if (ViewBag.IsEditMode || Model?.GoalLists?.Count() > 0)
                {
                    if (Model.GoalLists == null || Model.GoalLists?.Count() == 0)
                    {
                        <p class="text-gray-400" id="noGoalsMessage">No goals selected.</p>
                    }
                    else
                    {
                        foreach (var goal in Model.GoalLists)
                        {
                            <div class="flex items-center space-x-2 rounded-full bg-indigo-600 px-3 py-1 text-white">
                                <span>
                                    @goal.Name
                                </span>
                                <button type="button" class="rounded-full text-white hover:bg-indigo-800 focus:outline-none"
                                        onclick="removeGoal(@goal.Id)">
                                    &times;
                                </button>
                            </div>
                        }
                    }
                }
                else
                {
                    <p class="text-gray-400" id="noGoalsMessage">No goals selected.</p>
                }
            </div>
            <input type="text" asp-for="GoalIds" hidden />
        </div>

        <!-- Search Input -->
        <div class="mb-4">
            <input id="searchGoal"
                   type="text"
                   placeholder="Search for goals..."
                   class="w-full rounded-md border border-gray-300 p-3 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>

        <!-- Filtered Goals List (Initially hidden) -->
        <ul id="filteredGoalsList" class="custom-scrollbar absolute hidden max-h-60 w-full divide-y divide-gray-200 overflow-y-auto rounded bg-white shadow-md">
            <!-- Dynamically populated list items -->
        </ul>
    </div>

    <!-- Task Description Input -->
    <div>
        <label asp-for="Description" class="block text-sm font-medium text-gray-600"></label>
        <textarea asp-for="Description" rows="4" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
        <span asp-validation-for="Description" class="text-sm text-red-500"></span>
    </div>

    <!-- Repeat Dropdown -->
    <div>
        <label asp-for="Repeat" class="block text-sm font-medium text-gray-600"></label>
        <select asp-for="Repeat" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            <option value="0">Run Once</option>
            <option value="1">Daily</option>
            <option value="2">Weekly</option>
        </select>
        <span asp-validation-for="Repeat" class="text-sm text-red-500"></span>
    </div>

    <!-- Weekly Days Checkbox (hidden by default, shown when 'Weekly' is selected) -->
    <div id="RepeatWeekList" class="mt-4 @((ViewBag.IsEditMode && Model?.Repeat == RepeatType.Weekly) ? "" : "hidden")">
        <label asp-for="RepeatWeekList" class="block text-sm font-medium text-gray-600"></label>
        <div class="flex">

            <div class="mb-4 flex flex-wrap justify-center">

                <!-- Button for Monday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="monday" value="0" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Monday)">
                    <label for="monday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Mon</span>
                    </label>
                </div>

                <!-- Button for Tuesday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="tuesday" value="1" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Tuesday)">
                    <label for="tuesday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Tue</span>
                    </label>
                </div>

                <!-- Button for Wednesday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="wednesday" value="2" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Wednesday)">
                    <label for="wednesday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Wed</span>
                    </label>
                </div>

                <!-- Button for Thursday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="thursday" value="3" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Thursday)">
                    <label for="thursday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Thu</span>
                    </label>
                </div>

                <!-- Button for Friday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="friday" value="4" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Friday)">
                    <label for="friday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Fri</span>
                    </label>
                </div>

                <!-- Button for Saturday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="saturday" value="5" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Saturday)">
                    <label for="saturday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Sat</span>
                    </label>
                </div>

                <!-- Button for Sunday -->
                <div class="m-1 flex items-center justify-center">
                    <input type="checkbox" name="RepeatWeekList" id="sunday" value="6" class="peer hidden" checked="@Model?.RepeatWeekList?.Contains(Weekly.Sunday)">
                    <label for="sunday" class="flex h-10 w-[4.5rem] cursor-pointer items-center justify-center rounded-full bg-gray-300 shadow-lg transition-all peer-checked:bg-blue-500">
                        <span class="text-sm text-black peer-checked:text-white">Sun</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Priority Dropdown -->
    <div>
        <label asp-for="Priority" class="block text-sm font-medium text-gray-600"></label>
        <select asp-for="Priority" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            <option value="0">Low</option>
            <option value="1">Medium</option>
            <option value="2">High</option>
        </select>
        <span asp-validation-for="Priority" class="text-sm text-red-500"></span>
    </div>

    <!-- Due Date Input -->
    <div>
        <label asp-for="EndDate" class="block text-sm font-medium text-gray-600"></label>
        <input asp-for="EndDate" type="datetime-local" class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
        <span asp-validation-for="EndDate" class="text-sm text-red-500"></span>
    </div>

    <!-- Goal Status Field (only visible in Edit mode) -->
    @if (ViewBag.IsEditMode)
    {
        <div id="taskStatusContainer" class="mb-4">
            <label asp-for="TaskStatus" class="block text-sm font-medium text-gray-600"></label>
            <select asp-for="TaskStatus" class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2">
                <option value="0">Not Started</option>
                <option value="1">Running</option>
                <option value="2">Completed</option>
                <option value="3">End</option>
            </select>
            <span asp-validation-for="TaskStatus" class="text-sm text-red-500"></span>
        </div>
    }

    <!-- Submit Button -->
    <div>
        <button type="submit" class="mt-4 w-full rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            @(ViewBag.IsEditMode ? "Edit Task" : "Add Task")
        </button>
    </div>
</form>
