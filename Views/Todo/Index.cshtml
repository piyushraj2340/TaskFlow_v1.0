@model TaskMonitoringApp.Models.DTOs.TodoProgressAnalysisDTO

@{
    ViewData["Title"] = "Today's Tasks";
}


@section Styles {
    <!-- Add a section for DataTables CSS if this page uses DataTables -->
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- Flatpickr (Calendar) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
}

<div class="container mx-auto p-8">
    <div class="mb-6 flex flex-col items-start justify-between rounded-lg border-l-4 border-gray-600 bg-white p-4 shadow-md shadow-gray-300 md:flex-row md:items-center md:p-6">
        <h2 class="text-lg font-semibold text-gray-700 sm:text-xl">
            Select Date:
            <span id="selectedDate" class="inline-flex min-w-max items-center rounded bg-gray-700 px-3 py-1 text-xs font-semibold text-white shadow-md transition duration-300 hover:bg-gray-500 sm:text-sm">
            </span>
        </h2>

        <!-- Container for Buttons & Date Picker -->
        <div class="mt-4 flex w-full flex-col items-center justify-between space-y-2 sm:flex-row sm:space-y-0 sm:space-x-2 sm:w-auto md:mt-0">
            <button id="prevDateBtn" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-white transition hover:bg-gray-600 sm:w-auto">
                <i class="fas fa-arrow-left"></i> Previous
            </button>

            <button id="nextDateBtn" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-white transition hover:bg-gray-600 sm:w-auto">
                Next <i class="fas fa-arrow-right"></i>
            </button>

            <input type="text" id="taskDatePicker" class="w-full rounded-md border p-2 shadow-sm sm:w-auto" placeholder="Pick a date">
        </div>
    </div>



    <!-- Dashboard Stats Section (1st Row) -->
    <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-indigo-600"><i class="fas fa-trophy"></i></div>
                <div class="text-lg font-semibold">Total Tasks</div>
            </div>
            <div class="mt-4 text-xl" id="totalTodoTaskCount">@Model.TotalTodo</div>
        </div>

        <div class="rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-green-600"><i class="fas fa-check"></i></div>
                <div class="text-lg font-semibold">Completed Tasks</div>
            </div>
            <div class="mt-4 text-xl" id="completedTodoTaskCount">@Model.TotalCompletedTodo</div>
        </div>

        <div class="rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-blue-600"><i class="fas fa-clipboard"></i></div>
                <div class="text-lg font-semibold">Pending Task</div>
            </div>
            <div class="mt-4 text-xl" id="runningTodoTaskCount">
                @Model.TotalMissedTodo
            </div>
        </div>

        <div class="rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-purple-600"><i class="fas fa-cogs"></i></div>
                <div class="text-lg font-semibold">Today's Productivity</div>
            </div>
            <div class="mt-4 text-xl" id="productivityPercentageTodo">@Model.ProductivityForDay%</div>
        </div>
    </div>

    <div id="todoSections" class="flex flex-col">
        <!-- running task Section -->
        <section class="mb-8 rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <!-- Task Heading with Actions -->
            <!-- Running Tasks Section -->
            <div class="mb-8">
                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 id="RunningOrMissingHeadId" class="text-xl font-semibold text-gray-700 sm:text-lg">Today's Tasks</h2>
                    @* <a href="@Url.Action("Create")" id="openModalButton" class="my-1 rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">
                    <i class="fas fa-plus"></i> Add New Todo
                </a> *@
                </div>

                <!-- Running Task List (Table) -->
                <div class="overflow-x-auto">
                    <table id="viewRunningTodoTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>


        </section>

        <!-- not-started task section -->
        <section class="mb-8 rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <!-- Completed Tasks Section -->
            <div class="mb-8">

                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 id="CompletedTodoHeadId" class="mb-4 text-xl font-semibold text-gray-700">Completed Today's Tasks</h2>
                </div>

                <!-- Completed Task List (Table) -->
                <div class="overflow-x-auto">
                    <table id="viewCompletedTodoTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </section>
    </div>

    @section Scripts
    {
        @* DataTable *@
        <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

        @* sweetalert *@
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        @* Client side Script *@
        <script src="~/js/sweetAlertScript.js"></script>
        <script src="~/js/utils.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="~/js/todoScript.js"></script>
    }
</div>