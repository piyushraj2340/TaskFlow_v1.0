@model TaskMonitoringApp.Models.DTOs.TodoProgressAnalysisDTO

@{
    ViewData["Title"] = "Today's Tasks";
}


@section Styles {
    <!-- Add a section for DataTables CSS if this page uses DataTables -->
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- Flatpickr (Calendar) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<style>
    .circular-tooltip {
        @@apply absolute z-50 left-1/2 top-full mt-2 w-48 -translate-x-1/2 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 p-3 text-xs;
        display: none;
    }

    .circular-meter-group:hover .circular-tooltip {
        display: block;
    }
</style>

<!-- Select2 CSS/JS -->

<style>
    /* Custom Select2 and Modal Styles */
    .select2-container--default .select2-selection--multiple {
        border-radius: 0.75rem;
        min-height: 44px;
        padding: 8px 12px;
        border: 1px solid #6366f1;
        background: #f3f4f6;
        display: flex;
        align-items: center;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background: linear-gradient(90deg, #6366f1 60%, #3b82f6 100%);
            color: #fff;
            border: none;
            border-radius: 9999px;
            font-weight: 500;
            margin-top: 6px;
            margin-bottom: 6px;
            padding: 6px 16px 6px 28px;
            box-shadow: 0 2px 8px rgba(99,102,241,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
            color: #fff;
            margin-right: 8px;
            font-size: 1.1em;
            transition: color 0.2s;
            left: 1px;
            top: 4px;
            border-radius: 50%;
        }

            .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
                color: #ef4444;
            }

    #searchTaskModal .select2-dropdown {
        border-radius: 0.75rem;
        box-shadow: 0 4px 24px rgba(99,102,241,0.12);
    }

    #selectedTasksContainer .task-tag {
        background: linear-gradient(90deg, #6366f1 60%, #3b82f6 100%);
        color: #fff;
        border-radius: 6px;
        font-weight: 500;
        padding: 8px 18px 8px 12px;
        margin: 4px 0;
        box-shadow: 0 2px 8px rgba(99,102,241,0.08);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    #selectedTasksContainer .remove-task-btn {
        background: none;
        border: none;
        color: #fff;
        font-size: 1.1em;
        cursor: pointer;
        transition: color 0.2s;
    }

        #selectedTasksContainer .remove-task-btn:hover {
            color: #ef4444;
        }

    .task-card:hover .remove-task-btn {
        color: gray !important;
    }

    .task-card .remove-task-btn:hover {
        color: #ef4444 !important;
    }
</style>

<div class="container mx-auto p-8">
    <div class="mb-6 flex flex-col items-start justify-between rounded-lg border-l-4 border-gray-600 bg-white p-4 shadow-md shadow-gray-300 md:flex-row md:items-center md:p-6">
        <h2 class="text-lg font-semibold text-gray-700 sm:text-xl">
            Select Date:
            <span id="selectedDate" class="inline-flex min-w-max items-center rounded bg-gray-700 px-3 py-1 text-xs font-semibold text-white shadow-md transition duration-300 hover:bg-gray-500 sm:text-sm">
            </span>
        </h2>

        <!-- Container for Buttons & Date Picker -->
        <div class="mt-4 flex w-full flex-col items-center justify-between space-y-2 sm:flex-row sm:space-y-0 sm:space-x-2 sm:w-auto md:mt-0">
            <button id="prevDateBtn" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-white transition hover:bg-gray-600 sm:w-auto">
                <i class="fas fa-arrow-left"></i> Previous
            </button>

            <button id="nextDateBtn" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-white transition hover:bg-gray-600 sm:w-auto">
                Next <i class="fas fa-arrow-right"></i>
            </button>

            <input type="text" id="taskDatePicker" class="w-full rounded-md border p-2 shadow-sm sm:w-auto" placeholder="Pick a date">
        </div>
    </div>



    <!-- Dashboard Stats Section (1st Row) -->
    <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-indigo-600"><i class="fas fa-trophy"></i></div>
                <div class="text-lg font-semibold">Total Tasks</div>
            </div>
            <div class="mt-4 text-xl" id="totalTodoTaskCount">@Model.TotalTodo</div>
        </div>

        <div class="rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-green-600"><i class="fas fa-check"></i></div>
                <div class="text-lg font-semibold">Completed Tasks</div>
            </div>
            <div class="mt-4 text-xl" id="completedTodoTaskCount">@Model.TotalCompletedTodo</div>
        </div>

        <div class="rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-blue-600"><i class="fas fa-clipboard"></i></div>
                <div class="text-lg font-semibold">Pending Task</div>
            </div>
            <div class="mt-4 text-xl" id="runningTodoTaskCount">
                @Model.TotalMissedTodo
            </div>
        </div>

        <div class="rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center justify-between">
                <div class="text-3xl text-purple-600"><i class="fas fa-cogs"></i></div>
                <div class="text-lg font-semibold">Today's Productivity</div>
            </div>
            <div class="mt-4 text-xl" id="productivityPercentageTodo">@Model.ProductivityForDay%</div>
        </div>
    </div>

    <div id="todoSections" class="flex flex-col">
        <!-- running task Section -->
        <section class="mb-8 rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <!-- Task Heading with Actions -->
            <!-- Running Tasks Section -->
            <div class="mb-8">
                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 id="RunningOrMissingHeadId" class="text-xl font-semibold text-gray-700 sm:text-lg">Today's Tasks</h2>

                    <!-- Add Todo Button (only visible for today) -->
                    <div id="addTodoBtnContainer" class="mb-4 flex justify-end">
                        <button id="addTodoButton" class="hidden rounded-lg bg-gradient-to-r from-indigo-500 to-blue-500 px-6 py-2 text-white font-semibold shadow-lg hover:from-indigo-600 hover:to-blue-600 transition-all duration-200">
                            <i class="fas fa-plus"></i> Add Todo
                        </button>
                    </div>

                </div>

                <!-- Running Task List (Table) -->
                <div class="w-full overflow-x-auto">
                    <table id="viewRunningTodoTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Notes</th>
                                <th class="p-2 text-left text-gray-600">Productivity</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>

                </div>
            </div>


        </section>

        <!-- not-started task section -->
        <section class="mb-8 rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <!-- Completed Tasks Section -->
            <div class="mb-8">

                <div class="mb-4 flex flex-col items-center justify-between border-b-2 border-gray-500 pb-2 sm:flex-row">
                    <h2 id="CompletedTodoHeadId" class="mb-4 text-xl font-semibold text-gray-700">Completed Today's Tasks</h2>
                </div>
                <div class="w-full overflow-x-auto">
                    <table id="viewCompletedTodoTableData" class="min-w-full rounded-lg border border-gray-300 bg-white">
                        <thead>
                            <tr>
                                <th class="p-2 text-left text-gray-600">Task Id</th>
                                <th class="p-2 text-left text-gray-600">Task Name</th>
                                <th class="p-2 text-left text-gray-600">Priority</th>
                                <th class="p-2 text-left text-gray-600">Repeat Type</th>
                                <th class="p-2 text-left text-gray-600">Due Date</th>
                                <th class="p-2 text-left text-gray-600">Notes</th>
                                <th class="p-2 text-left text-gray-600">Productivity</th>
                                <th class="p-2 text-left text-gray-600">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </section>
    </div>

    @await Html.PartialAsync("AddUpdateTodoNotes")

    <!-- Modal -->
    <div id="searchTaskModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-gray-900 bg-opacity-75 backdrop-blur-sm">
        <div class="relative w-full max-w-2xl transform rounded-2xl bg-gray-50 shadow-2xl transition-all">

            <div class="flex items-center justify-between rounded-t-2xl bg-gradient-to-r from-indigo-600 to-blue-500 px-6 py-4">
                <h2 class="text-xl font-bold text-white tracking-wide">Add Tasks for Today</h2>
                <button id="closeModalButton" class="text-2xl text-indigo-100 transition hover:text-white">&times;</button>
            </div>

            <div class="p-6 space-y-6">
                <div>
                    <label for="taskMultiSelect" class="block mb-2 text-sm font-medium text-gray-800">Search for a task by ID or name</label>
                    <select id="taskMultiSelect" multiple="multiple" style="width:100%"></select>
                </div>

                <div>
                    <h3 class="text-sm font-medium text-gray-800 mb-3">Selected for Today</h3>
                    <div id="selectedTasksContainer" class="max-h-[40vh] overflow-y-auto space-y-3 pr-2">
                        <div id="emptyState" class="flex flex-col items-center justify-center p-8 text-center border-2 border-dashed rounded-lg">
                            <i class="fas fa-check-circle fa-2x text-gray-400 mb-2"></i>
                            <p class="text-gray-500">Selected tasks will appear here.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-end space-x-3 rounded-b-2xl bg-gray-100 px-6 py-4">
                <button id="cancelModalButton" class="rounded-lg bg-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-300">Cancel</button>
                <button id="confirmTasksButton" class="flex items-center rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                    <i class="fas fa-plus mr-2"></i>Add Selected Tasks
                </button>
            </div>
        </div>
    </div>

    @section Scripts
    {
        @* DataTable *@
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

        @* sweetalert *@

        @* Client side Script *@
        <script src="~/js/sweetAlertScript.js"></script>
        <script src="~/js/utils.js"></script>
        <script src="~/js/todoScript.js"></script>
    }
</div>