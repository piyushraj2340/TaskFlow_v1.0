@model TaskMonitoringApp.Models.DTOs.TodoProgressAnalysisDTO

@{
    ViewData["Title"] = "Today's Tasks";
}

@section Styles {
    <link href="//cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<style>
    .circular-tooltip {
        @@apply absolute z-50 left-1/2 top-full mt-2 w-48 -translate-x-1/2 bg-white text-gray-800 rounded-lg shadow-lg border border-gray-200 p-3 text-xs;
        display: none;
    }

    .circular-meter-group:hover .circular-tooltip {
        display: block;
    }

    .todo {
        background-color: #18191b;
    }

    /* --- Select2 Custom Styles (Preserved) --- */
    #unifiedSearchContainer .select2-container--default .select2-selection--multiple {
        border: none !important;
        box-shadow: none !important;
        min-height: 42px;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__rendered {
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: center !important;
        gap: 5px !important;
        padding-bottom: 5px !important;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background: linear-gradient(90deg, #6366f1 60%, #3b82f6 100%);
        color: #fff;
        border: none;
        border-radius: 9999px;
        font-weight: 500;
        margin-top: 5px !important;
        padding: 6px 16px 6px 28px;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: #fff;
        margin-right: 8px;
        font-size: 1.1em;
        transition: color 0.2s;
        left: 1px;
        top: 4px;
        border-radius: 50%;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
            color: #ef4444;
        }

    .select2-container--default .select2-selection--multiple .select2-search--inline {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--multiple .select2-search__field {
        width: 100% !important;
        margin-top: 8px !important;
    }

    #unifiedSearchContainer.select2-focused {
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.5) !important;
    }

    #searchTaskModal .select2-dropdown {
        border-radius: 0.75rem;
        box-shadow: 0 4px 24px rgba(99, 102, 241, 0.12);
    }

    .status-filter-option.active {
        background-color: #4f46e5;
        color: white;
        font-weight: 600;
    }

    #selectedTasksContainer .task-card .remove-task-btn {
        background: none;
        border: none;
        color: transparent !important;
        font-size: 1.1em;
        cursor: pointer;
        transition: color 0.2s;
    }

    #selectedTasksContainer .task-card:hover .remove-task-btn {
        color: gray !important;
    }

    #selectedTasksContainer .task-card .remove-task-btn:hover {
        color: #ef4444 !important;
    }
</style>

<div class="container mx-auto p-2 md:p-4 lg:p-6">

    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-indigo-600 bg-white p-6 shadow-md shadow-indigo-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-indigo-100 p-4">
                    <i class="fas fa-trophy text-3xl text-indigo-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Total Tasks</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="totalTodoTaskCount">@Model.TotalTodo</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-green-600 bg-white p-6 shadow-md shadow-green-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-green-100 p-4">
                    <i class="fas fa-check text-3xl text-green-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Completed</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="completedTodoTaskCount">@Model.TotalCompletedTodo</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-blue-600 bg-white p-6 shadow-md shadow-blue-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-blue-100 p-4">
                    <i class="fas fa-clipboard text-3xl text-blue-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Pending Task</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="runningTodoTaskCount">@Model.TotalMissedTodo</div>
                </div>
            </div>
        </div>

        <div class="flex items-center min-h-[120px] rounded-lg border-l-4 border-purple-600 bg-white p-6 shadow-md shadow-purple-300">
            <div class="flex items-center space-x-4 w-full">
                <div class="flex-shrink-0 rounded-full bg-purple-100 p-4">
                    <i class="fas fa-cogs text-3xl text-purple-600"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium uppercase tracking-wider text-gray-500">Productivity</div>
                    <div class="truncate text-3xl font-bold text-gray-900" id="productivityPercentageTodo">@Model.ProductivityForDay%</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-8 rounded-lg border-l-4 border-gray-600 bg-white p-6 shadow-md shadow-gray-400">
        <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
            <h2 class="text-lg font-semibold text-gray-700 sm:text-xl">
                Select Date:
                <span id="selectedDate" class="ml-2 inline-flex min-w-max items-center rounded bg-gray-700 px-3 py-1 text-xs font-semibold text-white shadow-md transition duration-300 hover:bg-gray-600 sm:text-sm">Today</span>
            </h2>

            <div class="flex w-full flex-col items-center gap-2 sm:w-auto sm:flex-row">
                <button id="prevDateBtn" class="inline-flex w-full items-center justify-center space-x-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-md transition-all hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500 sm:w-auto">
                    <i class="fas fa-arrow-left"></i> <span>Previous</span>
                </button>

                <button id="nextDateBtn" class="inline-flex w-full items-center justify-center space-x-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-md transition-all hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500 sm:w-auto">
                    <span>Next</span> <i class="fas fa-arrow-right"></i>
                </button>

                <div class="w-full sm:w-auto relative">
                    <input type="text" id="taskDatePicker" class="w-full rounded-lg border-gray-300 p-2 pl-3 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:w-40" placeholder="Pick a date">
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                        <i class="fas fa-calendar text-gray-400"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <div id="todoSections" class="flex flex-col">
        <section class="mb-8 rounded-lg border-l-4 border-indigo-600 bg-white p-4 shadow-md shadow-indigo-300">
            <div class="mb-6">
                <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                    <h2 id="RunningOrMissingHeadId" class="text-2xl font-bold text-gray-900">Today's Tasks</h2>

                    <div id="addTodoBtnContainer" class="w-full sm:w-auto">
                        <button id="addTodoButton" class="hidden w-full items-center justify-center space-x-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-indigo-700 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-opacity-50 sm:w-auto sm:inline-flex">
                            <i class="fas fa-plus"></i>
                            <span>Add Todo</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table id="viewRunningTodoTableData" class="w-full min-w-full" style="width:100%">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Id</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Notes</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Productivity</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </section>

        <section class="mb-8 rounded-lg border-l-4 border-green-600 bg-white p-4 shadow-md shadow-green-300">
            <div class="mb-6">
                <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                    <h2 id="CompletedTodoHeadId" class="text-2xl font-bold text-gray-900">Completed Today's Tasks</h2>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table id="viewCompletedTodoTableData" class="w-full min-w-full" style="width:100%">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Id</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Repeat</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Due Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Notes</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Productivity</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </section>
    </div>

    @await Html.PartialAsync("AddUpdateTodoNotes")
    @await Html.PartialAsync("AddTodoSearchTaskModal")

    @section Scripts
    {
        @* DataTable *@
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="//cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

        @* Client side Script *@
        <script src="~/js/sweetAlertScript.js"></script>
        <script src="~/js/utils.js"></script>
        <script src="~/js/todoScript.js"></script>
    }
</div>