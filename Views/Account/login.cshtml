@model TaskMonitoringApp.Models.ViewModel.LoginViewModel


@{
    ViewData["Title"] = "Login";
    var errorMessages = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
}

<div class="my-4 flex items-center justify-center bg-gray-100">
    <div class="w-full max-w-md rounded-lg bg-white p-8 shadow-lg">
        <h2 class="mb-6 text-center text-3xl font-bold text-gray-800">Welcome Back</h2>
        <p class="mb-8 text-center text-gray-600">Sign in to your task monitoring account</p>

        @await Html.PartialAsync("_ModelStateValidations", errorMessages)

        <!-- Login Form -->
        <form asp-action="Login" method="post" class="space-y-6">
            <!-- Username or Email -->
            <div>
                <label for="EmailOrUserName" class="block text-sm font-medium text-gray-600">User Name or Email</label>
                <input asp-for="UserName" id="EmailOrUserName" type="text" placeholder="Enter your email or user name"
                       class="mt-1 w-full rounded-md border border-gray-300 p-2 text-gray-800 focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50">
                <span asp-validation-for="UserName" class="text-sm text-red-500"></span>
            </div>

            <!-- Password -->
            <div>
                <label for="Password" class="block text-sm font-medium text-gray-600">Password</label>
                <input asp-for="Password" id="Password" type="password" placeholder="Enter your password"
                       class="mt-1 w-full rounded-md border border-gray-300 p-2 text-gray-800 focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50">
                <span asp-validation-for="Password" class="text-sm text-red-500"></span>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center justify-between">
                <label class="flex items-center text-sm text-gray-600">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-gray-300 text-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50">
                    <span class="ml-2">@Html.DisplayNameFor(model => model.RememberMe)</span>
                </label>
                <a href="#" class="text-sm text-blue-500 hover:underline">Forgot password?</a>
            </div>

            <!-- Submit Button -->
            <div>
                <button type="submit" class="w-full rounded-md bg-blue-500 px-4 py-2 font-semibold text-white hover:bg-blue-600 focus:outline-none focus:ring focus:ring-blue-500 focus:ring-opacity-50">
                    Sign In
                </button>
            </div>
        </form>

        <!-- Divider for Guest -->
        <div class="my-6 flex items-center">
            <div class="flex-1 h-px bg-gray-300"></div>
            <span class="px-3 text-sm text-gray-500">Quick Test</span>
            <div class="flex-1 h-px bg-gray-300"></div>
        </div>

        <!-- Guest Login -->
        <div class="text-center">
            <form id="guestLoginForm" asp-action="GuestLogin" method="post">
                <button type="submit" class="w-full rounded-md bg-emerald-600 px-4 py-2.5 font-semibold text-white hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-opacity-50 transition duration-300">
                    <i class="fas fa-user-shield mr-2"></i> Log In as Guest
                </button>
            </form>
            <p class="mt-2 text-xs text-gray-500 leading-relaxed">
                Log in as a guest to instantly explore the dashboard with pre-loaded demo data.
                <br />
                <span class="text-red-500 font-medium">Note:</span> Guest data and any changes will be reset every 24 hours at 12:00 AM midnight.
            </p>
        </div>

        <!-- Register Link -->
        <div class="mt-6 text-center">
            <p class="text-sm text-gray-600">New user? <a href="/Account/Register" class="text-blue-500 hover:underline">Register here</a></p>
        </div>
    </div>
</div>

<!-- Fullscreen Loading Overlay for Database Cold Start -->
<div id="loadingOverlay" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 sm:p-8 max-w-md w-full text-center shadow-2xl border border-slate-200">
        <!-- Spinner -->
        <div class="flex justify-center mb-6">
            <div class="relative w-16 h-16">
                <!-- Inner spinner -->
                <div class="absolute inset-0 rounded-full border-4 border-slate-100"></div>
                <div class="absolute inset-0 rounded-full border-4 border-t-emerald-600 border-r-emerald-500 animate-spin"></div>
            </div>
        </div>
        
        <!-- Heading -->
        <h3 class="text-lg sm:text-xl font-bold text-slate-800 mb-2">Waking up the Database</h3>
        
        <!-- Explanation -->
        <p class="text-slate-600 text-sm mb-4 leading-relaxed">
            The database is hosted on a free-tier plan and goes to sleep after inactivity. We are waking it up for you!
        </p>
        
        <!-- Alert Box -->
        <div class="bg-amber-50 border-l-4 border-amber-500 p-3.5 rounded text-left mb-4">
            <p class="text-amber-800 text-xs font-semibold flex items-center">
                <i class="fas fa-hourglass-half mr-2"></i> Est. Time: 20-30 seconds
            </p>
            <p class="text-amber-700 text-xs mt-1 leading-relaxed">
                Please do not close or reload this page. The dashboard will load automatically once connection is established.
            </p>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const guestForm = document.getElementById("guestLoginForm");
        const overlay = document.getElementById("loadingOverlay");

        if (guestForm && overlay) {
            guestForm.addEventListener("submit", function() {
                overlay.classList.remove("hidden");
                overlay.classList.add("flex");
            });
        }
    });
</script>


